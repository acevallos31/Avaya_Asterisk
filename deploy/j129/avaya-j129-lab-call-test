#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-}"
REQUESTED_EXTENSION="${2:-}"
REQUESTED_MAC="${3:-}"
REQUESTED_IP="${4:-}"
PEER_EXTENSION="${5:-}"
AMPORTAL_CONF="/etc/amportal.conf"
EXPECTED_RUNNER="github-runner"

fail() { echo "J129-LAB-CALL-FAIL=$1" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || fail "helper must run as root"
[ "${SUDO_USER:-}" = "$EXPECTED_RUNNER" ] || fail "unexpected sudo caller"
command -v asterisk >/dev/null 2>&1 || fail "asterisk unavailable"

for ext in "$REQUESTED_EXTENSION" "$PEER_EXTENSION"; do
  if [ -n "$ext" ]; then
    [[ "$ext" =~ ^[0-9]{2,8}$ ]] || fail "invalid extension"
  fi
done
if [ -n "$REQUESTED_MAC" ]; then
  REQUESTED_MAC="$(printf '%s' "$REQUESTED_MAC" | tr '[:lower:]' '[:upper:]' | tr '-' ':')"
  [[ "$REQUESTED_MAC" =~ ^([0-9A-F]{2}:){5}[0-9A-F]{2}$ ]] || fail "invalid mac"
fi
if [ -n "$REQUESTED_IP" ]; then
  [[ "$REQUESTED_IP" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || fail "invalid ip"
fi

read_amportal_value() { sed -n "s/^${1}=//p" "$AMPORTAL_CONF" | head -n 1; }
mysql_endpoint() {
  command -v mysql >/dev/null 2>&1 || fail "mysql unavailable"
  [ -r "$AMPORTAL_CONF" ] || fail "amportal config unreadable"
  local u p h f
  u="$(read_amportal_value AMPDBUSER)"; p="$(read_amportal_value AMPDBPASS)"; h="$(read_amportal_value AMPDBHOST)"; [ -n "$h" ] || h=localhost
  [ -n "$u" ] && [ -n "$p" ] || fail "database settings unavailable"
  f="$(mktemp /tmp/j129-lab-call-db.XXXXXX.cnf)"; chmod 0600 "$f"
  trap 'rm -f "$f"' RETURN
  { printf '[client]\nuser=%s\npassword=%s\nhost=%s\n' "$u" "$p" "$h"; } > "$f"
  mysql --defaults-extra-file="$f" --batch --skip-column-names endpointconfig -e "$1" 2>/dev/null
  rm -f "$f"; trap - RETURN
}

resolve_target() {
  local rows count account mac
  if [ -n "$REQUESTED_MAC" ]; then
    rows="$(mysql_endpoint "SELECT ea.account, e.mac_address FROM endpoint e JOIN manufacturer mf ON mf.id=e.id_manufacturer JOIN model m ON m.id=e.id_model JOIN endpoint_account ea ON ea.id_endpoint=e.id WHERE mf.name='Avaya' AND m.name='J129' AND UPPER(REPLACE(e.mac_address,'-',':'))='$REQUESTED_MAC' ORDER BY ea.priority LIMIT 1;" || true)"
  elif [ -n "$REQUESTED_EXTENSION" ]; then
    rows="$(mysql_endpoint "SELECT ea.account, e.mac_address FROM endpoint e JOIN manufacturer mf ON mf.id=e.id_manufacturer JOIN model m ON m.id=e.id_model JOIN endpoint_account ea ON ea.id_endpoint=e.id WHERE mf.name='Avaya' AND m.name='J129' AND ea.account='$REQUESTED_EXTENSION' ORDER BY ea.priority LIMIT 1;" || true)"
  else
    rows="$(mysql_endpoint "SELECT ea.account, e.mac_address FROM endpoint e JOIN manufacturer mf ON mf.id=e.id_manufacturer JOIN model m ON m.id=e.id_model JOIN endpoint_account ea ON ea.id_endpoint=e.id WHERE mf.name='Avaya' AND m.name='J129' ORDER BY e.id, ea.priority;" || true)"
    count="$(printf '%s\n' "$rows" | sed '/^$/d' | wc -l)"
    [ "$count" -eq 1 ] || fail "multiple or zero J129 endpoints; specify extension or mac"
  fi
  account="$(printf '%s\n' "$rows" | awk 'NF{print $1; exit}')"
  mac="$(printf '%s\n' "$rows" | awk 'NF{print $2; exit}' | tr '[:lower:]' '[:upper:]' | tr '-' ':')"
  [[ "$account" =~ ^[0-9]{2,8}$ ]] || fail "J129 account unavailable or invalid"
  [[ "$mac" =~ ^([0-9A-F]{2}:){5}[0-9A-F]{2}$ ]] || fail "J129 mac unavailable or invalid"
  if [ -n "$REQUESTED_EXTENSION" ] && [ "$REQUESTED_EXTENSION" != "$account" ]; then
    fail "requested extension does not match selected endpoint"
  fi
  printf '%s %s\n' "$account" "$mac"
}

get_peer_ip() {
  local account="$1" peer ip
  peer="$(asterisk -rx "sip show peer $account" 2>/dev/null || true)"
  ip="$(printf '%s\n' "$peer" | sed -nE 's/^[[:space:]]*Addr->IP[[:space:]]*:[[:space:]]*([^:[:space:]]+).*/\1/p' | head -n 1)"
  if ! [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    ip="$(asterisk -rx 'sip show peers' 2>/dev/null | awk -v a="$account" '$1 ~ ("^" a "(/|$)") {print $2; exit}')"
  fi
  [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || fail "peer has no registered IPv4 address"
  if [ -n "$REQUESTED_IP" ] && [ "$account" = "$REQUESTED_EXTENSION" ] && [ "$REQUESTED_IP" != "$ip" ]; then
    fail "registered ip does not match requested ip"
  fi
  printf '%s' "$ip"
}

peer_status() {
  local account="$1"
  asterisk -rx 'sip show peers' 2>/dev/null | awk -v a="$account" '$1 ~ ("^" a "(/|$)") {for (i=1;i<=NF;i++) if ($i ~ /^(OK|UNKNOWN|UNREACHABLE)$/) {print $i; exit}}'
}

peer_check() {
  local account="$1" ip status
  ip="$(get_peer_ip "$account")"
  status="$(peer_status "$account")"
  [ "$status" = "OK" ] || fail "peer not ready"
  echo "J129-LAB-CALL-PEER-READY-PASS extension=$account ip=$ip"
}

audit_peer_safe() {
  local account="$1" peer ip status ua context transport dtmf codecs directmedia qualify
  peer="$(asterisk -rx "sip show peer $account" 2>/dev/null || true)"
  printf '%s\n' "$peer" | grep -q "^${account}[[:space:]]" || printf '%s\n' "$peer" | grep -q "Name[[:space:]]*:.*${account}" || fail "peer $account not found"
  ip="$(get_peer_ip "$account")"
  status="$(peer_status "$account")"
  [ "$status" = "OK" ] || fail "peer $account not ready"
  ua="$(printf '%s\n' "$peer" | sed -nE 's/^[[:space:]]*(SIP Useragent|Useragent)[[:space:]]*:[[:space:]]*(.*)$/\2/p' | head -n1)"
  context="$(printf '%s\n' "$peer" | sed -nE 's/^[[:space:]]*Context[[:space:]]*:[[:space:]]*(.*)$/\1/p' | head -n1)"
  transport="$(printf '%s\n' "$peer" | sed -nE 's/^[[:space:]]*Transport[[:space:]]*:[[:space:]]*(.*)$/\1/p' | head -n1)"
  dtmf="$(printf '%s\n' "$peer" | sed -nE 's/^[[:space:]]*DTMFmode[[:space:]]*:[[:space:]]*(.*)$/\1/p' | head -n1)"
  codecs="$(printf '%s\n' "$peer" | sed -nE 's/^[[:space:]]*Codec Order[[:space:]]*:[[:space:]]*(.*)$/\1/p' | head -n1)"
  directmedia="$(printf '%s\n' "$peer" | sed -nE 's/^[[:space:]]*DirectMedia[[:space:]]*:[[:space:]]*(.*)$/\1/p' | head -n1)"
  qualify="$(printf '%s\n' "$peer" | sed -nE 's/^[[:space:]]*Qualify[[:space:]]*:[[:space:]]*(.*)$/\1/p' | head -n1)"
  [ -n "$ua" ] || ua="unknown"
  [ -n "$context" ] || context="unknown"
  [ -n "$transport" ] || transport="unknown"
  [ -n "$dtmf" ] || dtmf="unknown"
  [ -n "$codecs" ] || codecs="unknown"
  [ -n "$directmedia" ] || directmedia="unknown"
  [ -n "$qualify" ] || qualify="unknown"
  echo "SIP-PEER-AUDIT-PASS extension=$account ip=$ip status=$status"
  echo "SIP-PEER-SAFE extension=$account context=$context transport=$transport dtmf=$dtmf directmedia=$directmedia qualify=$qualify"
  echo "SIP-PEER-UA extension=$account useragent=$ua"
  echo "SIP-PEER-CODECS extension=$account codecs=$codecs"
}

cleanup() {
  asterisk -rx 'sip set debug off' >/dev/null 2>&1 || true
  asterisk -rx 'rtp set debug off' >/dev/null 2>&1 || true
  asterisk -rx 'core set verbose 3' >/dev/null 2>&1 || true
  echo 'J129-LAB-CALL-DEBUG-CLEANUP-DONE'
}

case "$ACTION" in
  preflight)
    read -r account mac <<<"$(resolve_target)"
    asterisk -rx 'core show version' | head -n 1
    ip="$(get_peer_ip "$account")"
    echo "J129-LAB-CALL-TARGET-PASS extension=$account mac=$mac ip=$ip"
    peer_check "$account"
    if [ -n "$PEER_EXTENSION" ]; then
      audit_peer_safe "$account"
      audit_peer_safe "$PEER_EXTENSION"
      echo "J129-LAB-DUAL-PEER-AUDIT-PASS source=$account destination=$PEER_EXTENSION"
    fi
    echo "J129-LAB-CALL-PREFLIGHT-PASS extension=$account mac=$mac ip=$ip"
    ;;
  call)
    read -r account mac <<<"$(resolve_target)"
    ip="$(get_peer_ip "$account")"
    echo "J129-LAB-CALL-TARGET-PASS extension=$account mac=$mac ip=$ip"
    peer_check "$account"
    trap cleanup EXIT INT TERM
    asterisk -rx 'core set verbose 10' >/dev/null
    asterisk -rx "sip set debug ip $ip" >/dev/null
    asterisk -rx "rtp set debug ip $ip" >/dev/null 2>&1 || true
    echo "J129-LAB-CALL-ORIGINATE-START extension=$account ip=$ip callerid=\"Prueba J129\"<9999> application=Echo"
    asterisk -rx "channel originate SIP/$account application Echo" >/dev/null || fail "originate command failed"
    echo "J129-LAB-CALL-QUEUED-PASS extension=$account callerid=9999"
    answered=0
    for _ in $(seq 1 45); do
      if asterisk -rx 'core show channels concise' 2>/dev/null | awk -F'!' -v a="$account" '$1 ~ ("^SIP/" a "-") && $5 == "Up" {found=1} END{exit !found}'; then
        answered=1
        break
      fi
      sleep 1
    done
    [ "$answered" -eq 1 ] || fail "call was not answered within timeout"
    echo "J129-LAB-CALL-ANSWER-PASS extension=$account"
    echo 'J129-LAB-CALL-ECHO-ACTIVE-PASS'
    sleep 15
    echo 'J129-LAB-CALL-AUTOMATED-PHASE-PASS'
    cleanup
    trap - EXIT INT TERM
    ;;
  cleanup)
    cleanup
    ;;
  *)
    echo "Uso: $0 {preflight|call|cleanup} [extension] [mac] [ip] [peer-extension]" >&2
    exit 2
    ;;
esac
