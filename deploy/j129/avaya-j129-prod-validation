#!/usr/bin/env bash
set -euo pipefail

FROZEN_SHA="74d3f4cc1c2d5a432ad69e3c105b7fd3db00b6f3"
RUNNER_USER="github-runner-prod"
EXPECTED_HOST="cei-pbx02"
EXPECTED_PKG="/opt/actions-runner-prod/_work/Avaya_Asterisk/Avaya_Asterisk/_release_checkout/release/j129-v0.1.0"
AMPORTAL_CONF="/etc/amportal.conf"
ASTERISK_BIN="/usr/sbin/asterisk"

fail(){ echo "J129-PROD-VALIDATION-FAIL: $*" >&2; exit 1; }
pass(){ echo "$1"; }
need_root(){ [ "${EUID}" -eq 0 ] || fail "helper must run as root"; }
verify_caller(){
  [ "${SUDO_USER:-}" = "$RUNNER_USER" ] || fail "unauthorized caller"
  [ "$(hostname -s)" = "$EXPECTED_HOST" ] || fail "unexpected host"
}

verify_package(){
  local pkg="${1:-$EXPECTED_PKG}"
  [ "$pkg" = "$EXPECTED_PKG" ] || fail "unexpected package path"
  [ -d "$pkg" ] || fail "release package missing"
  if find "$pkg" -type l -print -quit | grep -q .; then fail "release package contains symlink"; fi
  (
    cd "$pkg"
    echo "fa2aca1fb187d2801082b0dc8afb099f8d1ab9c3ef18390fb119b9c94e26a4a3  README.md" | sha256sum -c -
    echo "13bc6fda46e48b66ef8bb45479eee9ce5ea5353a43fbf196a30796ab589bf3ff  install.sh" | sha256sum -c -
    echo "9a34bc0e417dc4babcda686d18efa5f9b41a060d892de787cbd56ea24be8ed20  payload/etc/httpd/conf.d/avaya-j129-provisioning.conf" | sha256sum -c -
    echo "fcb4eec19d7015cdaf7014c7d05fa179a984ae342b382ee41b069806c2c28ebf  payload/usr/share/issabel/endpoint-classes/class/issabel/vendor/Avaya.py" | sha256sum -c -
    echo "0c9f60d48db4e105e91ace29909eeb3e168fdb8e16d35427a2ad85227f1fbd08  payload/usr/share/issabel/endpoint-classes/tpl/Avaya_J129.tpl" | sha256sum -c -
    echo "575cc4b290b9919edfbf74d2643dbcaa671565b6d163a8b3856592c5dd00e492  payload/usr/share/issabel/endpoint-classes/tpl/Avaya_global_SIP.tpl" | sha256sum -c -
    bash -n install.sh
  )
  pass "J129-PROD-FROZEN-PACKAGE-PASS"
}

read_amp(){ sed -n "s/^$1=//p" "$AMPORTAL_CONF" | head -n1; }
escape_mysql(){ local v="$1"; v="${v//\\/\\\\}"; v="${v//\"/\\\"}"; printf '%s' "$v"; }
make_defaults(){
  local u p h f
  [ -f "$AMPORTAL_CONF" ] || fail "amportal.conf missing"
  u="$(read_amp AMPDBUSER)"; p="$(read_amp AMPDBPASS)"; h="$(read_amp AMPDBHOST)"
  [ -n "$u" ] || fail "AMPDBUSER missing"; [ -n "$p" ] || fail "AMPDBPASS missing"; [ -n "$h" ] || h=localhost
  f="$(mktemp /tmp/j129-prod-validation.XXXXXX.cnf)"; chmod 0600 "$f"
  { echo '[client]'; printf 'user="%s"\n' "$(escape_mysql "$u")"; printf 'password="%s"\n' "$(escape_mysql "$p")"; printf 'host="%s"\n' "$(escape_mysql "$h")"; } > "$f"
  printf '%s' "$f"
}
scalar(){ mysql --defaults-extra-file="$1" --batch --skip-column-names endpointconfig -e "$2"; }
db_scalar(){ mysql --defaults-extra-file="$1" --batch --skip-column-names "$2" -e "$3" 2>/dev/null | head -n1; }
ax(){ "$ASTERISK_BIN" -rx "$1"; }

server_audit(){
  echo "J129-PROD-HOST=$(hostname -f 2>/dev/null || hostname)"
  echo "J129-PROD-OS=$(cat /etc/redhat-release 2>/dev/null || true)"
  asterisk -rx 'core show version' | head -n1; python3 --version; httpd -v | head -n1; apachectl -t
  test -d /usr/share/issabel/endpoint-classes; test -x /usr/bin/issabel-endpointconfig
  test -s /var/lib/avaya-j129-issabel/0.1.0/state.env; test -s /var/lib/avaya-j129-issabel/0.1.0/installed.version
  local df mf model prefix maxa sip iax multi
  df="$(make_defaults)"; trap 'rm -f "$df"' RETURN EXIT
  mf="$(scalar "$df" "SELECT COUNT(*) FROM manufacturer WHERE name='Avaya';")"
  model="$(scalar "$df" "SELECT COUNT(*) FROM model m JOIN manufacturer mf ON mf.id=m.id_manufacturer WHERE mf.name='Avaya' AND m.name='J129';")"
  prefix="$(scalar "$df" "SELECT COUNT(*) FROM mac_prefix mp JOIN manufacturer mf ON mf.id=mp.id_manufacturer WHERE mf.name='Avaya' AND mp.mac_prefix='C8:1F:EA';")"
  maxa="$(scalar "$df" "SELECT COALESCE(MAX(m.max_accounts),-1) FROM model m JOIN manufacturer mf ON mf.id=m.id_manufacturer WHERE mf.name='Avaya' AND m.name='J129';")"
  sip="$(scalar "$df" "SELECT COALESCE(MAX(mp.property_value),'-1') FROM model_properties mp JOIN model m ON m.id=mp.id_model JOIN manufacturer mf ON mf.id=m.id_manufacturer WHERE mf.name='Avaya' AND m.name='J129' AND mp.property_key='max_sip_accounts';")"
  iax="$(scalar "$df" "SELECT COALESCE(MAX(mp.property_value),'-1') FROM model_properties mp JOIN model m ON m.id=mp.id_model JOIN manufacturer mf ON mf.id=m.id_manufacturer WHERE mf.name='Avaya' AND m.name='J129' AND mp.property_key='max_iax2_accounts';")"
  multi="$(scalar "$df" "SELECT COUNT(*) FROM (SELECT ea.id_endpoint FROM endpoint_account ea JOIN endpoint e ON e.id=ea.id_endpoint JOIN manufacturer mf ON mf.id=e.id_manufacturer LEFT JOIN model m ON m.id=e.id_model WHERE mf.name='Avaya' AND m.name='J129' GROUP BY ea.id_endpoint HAVING COUNT(*)>1) q;")"
  rm -f "$df"; trap - RETURN EXIT
  echo "J129-PROD-DB manufacturer=$mf model=$model prefix=$prefix max_accounts=$maxa max_sip=$sip max_iax2=$iax multiaccount=$multi"
  [ "$mf" = 1 ] && [ "$model" = 1 ] && [ "$prefix" = 1 ] && [ "$maxa" = 1 ] && [ "$sip" = 1 ] && [ "$iax" = 0 ] && [ "$multi" = 0 ] || fail "database contract mismatch"
  pass "J129-PROD-SERVER-AUDIT-PASS"
}

provisioning_audit(){
  local mac="${1:-}"
  for f in J100Supgrade.txt 46xxsettings.txt; do test -s "/tftpboot/$f" || fail "$f missing"; curl -fsSI "http://127.0.0.1/$f" >/dev/null || fail "$f HTTP failed"; echo "J129-PROD-HTTP-PASS=$f"; done
  if [ -n "$mac" ]; then
    mac="$(printf '%s' "$mac" | tr '[:upper:]' '[:lower:]' | tr -d ':.-')"; [[ "$mac" =~ ^[0-9a-f]{12}$ ]] || fail "invalid MAC"
    test -s "/tftpboot/${mac}.txt" || fail "MAC provisioning file missing"; curl -fsSI "http://127.0.0.1/${mac}.txt" >/dev/null || fail "MAC provisioning HTTP failed"
    echo "J129-PROD-MAC-PROVISIONING-PASS=$mac"
  else echo "J129-PROD-MAC-PROVISIONING=SKIPPED"; fi
  pass "J129-PROD-PROVISIONING-AUDIT-PASS"
}

last_provision_request(){
  local macnorm="$1" pattern="/${macnorm}.txt" line=''
  local f
  shopt -s nullglob
  for f in /var/log/httpd/access_log /var/log/httpd/access_log-*; do
    [ -r "$f" ] || continue
    line="$(grep -hF "$pattern" "$f" 2>/dev/null | tail -n1 || true)"
    [ -n "$line" ] && printf '%s' "$line"
  done | tail -n1
  shopt -u nullglob
}

fleet_audit(){
  local df rows row id model mac ip last_scanned last_modified account macnorm macfile prov_user prov_auth prov_pass
  local peers peer_token peer_name peer_host peer_status ua state ast_user ast_secret user_match secret_match
  local req_line req_seen req_ip req_status req_time ping_seen neighbor_line live_mac live_macnorm live_mac_match neighbor_state live_state
  local total=0 configured=0 registered=0 detected_only=0 not_registered=0 prov_missing=0
  local credentials_match=0 credentials_mismatch=0 credentials_unknown=0 config_requested=0 config_not_requested=0
  local live_confirmed=0 live_ip_only=0 live_mac_mismatch=0 live_unreachable=0 live_unknown=0

  [ -x "$ASTERISK_BIN" ] || fail "asterisk binary missing"
  df="$(make_defaults)"; trap 'rm -f "$df"' RETURN EXIT
  echo 'J129-PROD-FLEET-SCHEMA=3'
  echo 'J129-PROD-FLEET-SCOPE=AVAYA-ONLY'
  echo 'J129-PROD-FLEET-MANUFACTURER-SUMMARY-BEGIN'
  mysql --defaults-extra-file="$df" --batch --skip-column-names endpointconfig -e "SELECT mf.name,COUNT(*) FROM endpoint e JOIN manufacturer mf ON mf.id=e.id_manufacturer GROUP BY mf.name ORDER BY mf.name;" |
    while IFS=$'\t' read -r mf_name mf_count; do printf 'MANUFACTURER name=%q endpoints=%s\n' "$mf_name" "$mf_count"; done
  echo 'J129-PROD-FLEET-MANUFACTURER-SUMMARY-END'

  rows="$(mysql --defaults-extra-file="$df" --batch --skip-column-names endpointconfig -e "
    SELECT e.id,COALESCE(m.name,'UNKNOWN'),e.mac_address,COALESCE(e.last_known_ipv4,''),COALESCE(DATE_FORMAT(e.last_scanned,'%Y-%m-%dT%H:%i:%s'),'NONE'),COALESCE(DATE_FORMAT(e.last_modified,'%Y-%m-%dT%H:%i:%s'),'NONE'),COALESCE(GROUP_CONCAT(ea.account ORDER BY ea.priority SEPARATOR ','),'')
    FROM endpoint e JOIN manufacturer mf ON mf.id=e.id_manufacturer LEFT JOIN model m ON m.id=e.id_model LEFT JOIN endpoint_account ea ON ea.id_endpoint=e.id
    WHERE mf.name='Avaya' GROUP BY e.id,m.name,e.mac_address,e.last_known_ipv4,e.last_scanned,e.last_modified ORDER BY e.id;")"
  peers="$(ax 'sip show peers' 2>/dev/null || true)"
  echo 'J129-PROD-FLEET-AVAYA-BEGIN'

  while IFS=$'\t' read -r id model mac ip last_scanned last_modified account; do
    [ -n "$id" ] || continue
    total=$((total+1)); state='DETECTED_ONLY'; prov_user=''; prov_auth=''; prov_pass=''; peer_name=''; peer_host=''; peer_status='UNKNOWN'; ua=''
    user_match='UNKNOWN'; secret_match='UNKNOWN'; req_seen='NO'; req_ip='NONE'; req_status='NONE'; req_time='NONE'; ast_user=''; ast_secret=''
    ping_seen='UNKNOWN'; neighbor_line=''; live_mac='NONE'; live_mac_match='UNKNOWN'; neighbor_state='UNKNOWN'; live_state='UNKNOWN'
    macnorm="$(printf '%s' "$mac" | tr '[:upper:]' '[:lower:]' | tr -d ':.-')"; macfile="/tftpboot/${macnorm}.txt"

    if [ -n "$ip" ]; then
      if ping -c 1 -W 1 "$ip" >/dev/null 2>&1; then ping_seen='YES'; else ping_seen='NO'; fi
      neighbor_line="$(ip neigh show "$ip" 2>/dev/null | head -n1 || true)"
      if [ -n "$neighbor_line" ]; then
        live_mac="$(printf '%s\n' "$neighbor_line" | awk '{for(i=1;i<=NF;i++) if($i=="lladdr" && (i+1)<=NF){print $(i+1); exit}}')"
        neighbor_state="$(printf '%s\n' "$neighbor_line" | awk '{print $NF}')"
        [ -n "$live_mac" ] || live_mac='NONE'
      fi
      if [ "$live_mac" != 'NONE' ]; then
        live_macnorm="$(printf '%s' "$live_mac" | tr '[:upper:]' '[:lower:]' | tr -d ':.-')"
        if [ "$live_macnorm" = "$macnorm" ]; then live_mac_match='MATCH'; else live_mac_match='MISMATCH'; fi
      fi
      if [ "$ping_seen" = 'YES' ] && [ "$live_mac_match" = 'MATCH' ]; then live_state='LIVE_CONFIRMED'; live_confirmed=$((live_confirmed+1));
      elif [ "$ping_seen" = 'YES' ] && [ "$live_mac_match" = 'MISMATCH' ]; then live_state='LIVE_IP_MAC_MISMATCH'; live_mac_mismatch=$((live_mac_mismatch+1));
      elif [ "$ping_seen" = 'YES' ]; then live_state='LIVE_IP_ONLY'; live_ip_only=$((live_ip_only+1));
      elif [ "$ping_seen" = 'NO' ]; then live_state='UNREACHABLE_OR_FILTERED'; live_unreachable=$((live_unreachable+1));
      else live_unknown=$((live_unknown+1)); fi
    else
      live_unknown=$((live_unknown+1))
    fi

    if [ -n "$account" ]; then
      configured=$((configured+1)); state='CONFIGURED_NOT_PROVISIONED'
      if [ -s "$macfile" ]; then
        state='PROVISIONED_NOT_REGISTERED'
        prov_user="$(awk 'toupper($1)=="SET" && toupper($2)=="SIPUSERNAME" {print $3; exit}' "$macfile" 2>/dev/null || true)"
        prov_auth="$(awk 'toupper($1)=="SET" && toupper($2)=="AUTHNAME" {print $3; exit}' "$macfile" 2>/dev/null || true)"
        prov_pass="$(awk 'toupper($1)=="SET" && toupper($2)=="SIPPASSWORD" {print $3; exit}' "$macfile" 2>/dev/null || true)"

        peer_token="$(printf '%s\n' "$peers" | awk -v acct="$account" '$1 ~ /^[0-9]+\/[0-9]+$/ {split($1,a,"/"); if(a[2]==acct){print $1; exit}} $1==acct {print $1; exit}')"
        if [ -n "$peer_token" ]; then
          peer_name="${peer_token%%/*}"; row="$(ax "sip show peer $peer_name" 2>/dev/null || true)"
          peer_host="$(printf '%s\n' "$row" | sed -n -E 's/^[[:space:]]*Addr->IP[[:space:]]*:[[:space:]]*([^[:space:]]+).*/\1/p' | head -n1)"
          peer_status="$(printf '%s\n' "$row" | sed -n -E 's/^[[:space:]]*Status[[:space:]]*:[[:space:]]*(.*)$/\1/p' | head -n1)"
          ua="$(printf '%s\n' "$row" | sed -n -E 's/^[[:space:]]*Useragent[[:space:]]*:[[:space:]]*(.*)$/\1/p' | head -n1)"
          if [[ "$peer_name" =~ ^[0-9]{1,8}$ ]]; then
            ast_user="$(db_scalar "$df" asterisk "SELECT data FROM sip WHERE id='${peer_name}' AND keyword='username' LIMIT 1;" || true)"
            ast_secret="$(db_scalar "$df" asterisk "SELECT data FROM sip WHERE id='${peer_name}' AND keyword='secret' LIMIT 1;" || true)"
          fi
          [ -z "$prov_user" ] && prov_user="$prov_auth"
          if [ -n "$prov_user" ] && [ -n "$ast_user" ]; then [ "$prov_user" = "$ast_user" ] && user_match='MATCH' || user_match='MISMATCH'; fi
          if [ -n "$prov_pass" ] && [ -n "$ast_secret" ]; then [ "$prov_pass" = "$ast_secret" ] && secret_match='MATCH' || secret_match='MISMATCH'; fi
          if [ "$user_match" = MATCH ] && [ "$secret_match" = MATCH ]; then credentials_match=$((credentials_match+1));
          elif [ "$user_match" = MISMATCH ] || [ "$secret_match" = MISMATCH ]; then credentials_mismatch=$((credentials_mismatch+1));
          else credentials_unknown=$((credentials_unknown+1)); fi
          if printf '%s' "$peer_status" | grep -Eq '^(OK|Reachable)'; then state='CONFIGURED_REGISTERED'; registered=$((registered+1)); else not_registered=$((not_registered+1)); fi
        else
          not_registered=$((not_registered+1)); credentials_unknown=$((credentials_unknown+1))
        fi

        req_line="$(last_provision_request "$macnorm")"
        if [ -n "$req_line" ]; then
          req_seen='YES'; config_requested=$((config_requested+1)); req_ip="$(printf '%s\n' "$req_line" | awk '{print $1}')"
          req_status="$(printf '%s\n' "$req_line" | sed -n -E 's/.*"[^"]*"[[:space:]]+([0-9]{3})[[:space:]].*/\1/p' | head -n1)"; [ -n "$req_status" ] || req_status='UNKNOWN'
          req_time="$(printf '%s\n' "$req_line" | sed -n -E 's/^[^[]*\[([^]]+)\].*/\1/p' | head -n1)"; [ -n "$req_time" ] || req_time='UNKNOWN'
        else config_not_requested=$((config_not_requested+1)); fi
      else prov_missing=$((prov_missing+1)); fi
    else detected_only=$((detected_only+1)); fi

    unset prov_pass ast_secret
    printf 'AVAYA-ENDPOINT id=%s model=%q mac=%s last_ip=%s last_scanned=%q last_modified=%q ping=%s live_mac=%s live_mac_match=%s neighbor_state=%q live_state=%s account=%s provisioning=%s prov_user=%s asterisk_user=%s credential_user=%s credential_secret=%s config_request=%s request_ip=%s request_http=%s request_time=%q peer=%s sip_ip=%s sip_status=%q useragent=%q state=%s\n' \
      "$id" "$model" "$mac" "${ip:-NONE}" "${last_scanned:-NONE}" "${last_modified:-NONE}" "$ping_seen" "$live_mac" "$live_mac_match" "$neighbor_state" "$live_state" "${account:-NONE}" "$([ -s "$macfile" ] && echo PRESENT || echo MISSING)" "${prov_user:-NONE}" "${ast_user:-NONE}" "$user_match" "$secret_match" "$req_seen" "$req_ip" "$req_status" "$req_time" "${peer_name:-NONE}" "${peer_host:-NONE}" "${peer_status:-UNKNOWN}" "${ua:-UNKNOWN}" "$state"
  done <<< "$rows"

  rm -f "$df"; trap - RETURN EXIT
  echo 'J129-PROD-FLEET-AVAYA-END'
  echo "J129-PROD-FLEET-SUMMARY total=$total configured=$configured registered=$registered detected_only=$detected_only not_registered=$not_registered provisioning_missing=$prov_missing credentials_match=$credentials_match credentials_mismatch=$credentials_mismatch credentials_unknown=$credentials_unknown config_requested=$config_requested config_not_requested=$config_not_requested live_confirmed=$live_confirmed live_ip_only=$live_ip_only live_mac_mismatch=$live_mac_mismatch live_unreachable=$live_unreachable live_unknown=$live_unknown"
  pass 'J129-PROD-FLEET-AUDIT-PASS'
}

run_release(){ local action="$1"; verify_package; cd "$EXPECTED_PKG"; case "$action" in preflight) bash install.sh preflight;; verify) bash install.sh verify;; install) bash install.sh install;; *) fail "invalid release action";; esac; }
main(){
  need_root; verify_caller
  case "${1:-}" in
    audit) verify_package; server_audit; provisioning_audit "${2:-}";;
    fleet-audit) [ "$#" -eq 1 ] || fail "unexpected arguments"; fleet_audit;;
    preflight) run_release preflight;; verify) run_release verify;;
    install) [ "${2:-}" = "INSTALL-PROD-V010" ] || fail "install confirmation missing"; run_release install;;
    *) echo "usage: $0 {audit [mac]|fleet-audit|preflight|verify|install INSTALL-PROD-V010}" >&2; exit 2;;
  esac
}
main "$@"
