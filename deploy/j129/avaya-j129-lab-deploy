apply_grandstream_gxp1630_model() {
  local d source_id existing new_id
  d="$(make_db_defaults_file)"; trap 'rm -f "$d"' RETURN EXIT
  source_id="$(mysql_scalar "$d" "SELECT m.id FROM model m JOIN manufacturer mf ON mf.id=m.id_manufacturer WHERE mf.name='Grandstream' AND m.name='GXP1625' LIMIT 1;")"
  [ "$source_id" = 134 ] || { echo "ERROR: unexpected GXP1625 source id=$source_id" >&2; exit 1; }
  existing="$(mysql_scalar "$d" "SELECT COUNT(*) FROM model m JOIN manufacturer mf ON mf.id=m.id_manufacturer WHERE mf.name='Grandstream' AND m.name='GXP1630';")"
  [ "$existing" -le 1 ] || { echo 'ERROR: duplicate GXP1630 models' >&2; exit 1; }
  if [ "$existing" -eq 1 ]; then rm -f "$d"; trap - RETURN EXIT; echo 'GXP1630-MODEL-ALREADY-PRESENT'; return 0; fi
  [ ! -e "$GRANDSTREAM_GXP1630_MODEL_STATE_FILE" ] || { echo 'ERROR: pending GXP1630 model state' >&2; exit 1; }
  mysql --defaults-extra-file="$d" endpointconfig <<SQL
START TRANSACTION;
INSERT INTO model (id_manufacturer,name,description,max_accounts,static_ip_supported,dynamic_ip_supported,static_prov_supported)
SELECT id_manufacturer,'GXP1630','GXP1630',3,static_ip_supported,dynamic_ip_supported,static_prov_supported FROM model WHERE id=${source_id};
SET @new_id := LAST_INSERT_ID();
INSERT INTO model_properties (id_model,property_key,property_value)
SELECT @new_id,property_key,CASE WHEN property_key='max_sip_accounts' THEN '3' ELSE property_value END
FROM model_properties WHERE id_model=${source_id};
COMMIT;
SQL
  new_id="$(mysql_scalar "$d" "SELECT m.id FROM model m JOIN manufacturer mf ON mf.id=m.id_manufacturer WHERE mf.name='Grandstream' AND m.name='GXP1630' LIMIT 1;")"
  [[ "$new_id" =~ ^[0-9]+$ ]] || { echo 'ERROR: GXP1630 id missing after insert' >&2; exit 1; }
  printf 'model_id=%s\n' "$new_id" > "$GRANDSTREAM_GXP1630_MODEL_STATE_FILE"; chmod 0600 "$GRANDSTREAM_GXP1630_MODEL_STATE_FILE"
  rm -f "$d"; trap - RETURN EXIT
  echo "gxp1630_model_id=$new_id"; echo 'GXP1630-MODEL-APPLY-PASS'
}

rollback_grandstream_gxp1630_model() {
  [ -f "$GRANDSTREAM_GXP1630_MODEL_STATE_FILE" ] || { echo 'ERROR: no GXP1630 model state' >&2; exit 1; }
  . "$GRANDSTREAM_GXP1630_MODEL_STATE_FILE"; [[ "${model_id:-}" =~ ^[0-9]+$ ]] || exit 1
  local d endpoints; d="$(make_db_defaults_file)"; trap 'rm -f "$d"' RETURN EXIT
  endpoints="$(mysql_scalar "$d" "SELECT COUNT(*) FROM endpoint WHERE id_model=$model_id;")"
  [ "$endpoints" -eq 0 ] || { echo 'ERROR: GXP1630 endpoints exist; rollback cancelled' >&2; exit 1; }
  mysql --defaults-extra-file="$d" endpointconfig -e "START TRANSACTION; DELETE FROM model_properties WHERE id_model=$model_id; DELETE FROM model WHERE id=$model_id AND name='GXP1630'; COMMIT;"
  rm -f "$GRANDSTREAM_GXP1630_MODEL_STATE_FILE"
  rm -f "$d"; trap - RETURN EXIT
  echo 'GXP1630-MODEL-ROLLBACK-PASS'
}

discover_grandstream_gxp1630() {
  local d count ip model manufacturer
  /usr/bin/issabel-helper detect_endpoints 192.168.1.0/24 >/dev/null
  sleep 25
  d="$(make_db_defaults_file)"; trap 'rm -f "$d"' RETURN EXIT
  count="$(mysql_scalar "$d" "SELECT COUNT(*) FROM endpoint WHERE UPPER(mac_address)='C0:74:AD:B4:AD:70';")"
  ip="$(mysql_scalar "$d" "SELECT COALESCE(last_known_ipv4,'') FROM endpoint WHERE UPPER(mac_address)='C0:74:AD:B4:AD:70' LIMIT 1;")"
  model="$(mysql_scalar "$d" "SELECT COALESCE(m.name,'') FROM endpoint e LEFT JOIN model m ON m.id=e.id_model WHERE UPPER(e.mac_address)='C0:74:AD:B4:AD:70' LIMIT 1;")"
  manufacturer="$(mysql_scalar "$d" "SELECT COALESCE(mf.name,'') FROM endpoint e LEFT JOIN manufacturer mf ON mf.id=e.id_manufacturer WHERE UPPER(e.mac_address)='C0:74:AD:B4:AD:70' LIMIT 1;")"
  echo "endpoint_count=$count"; echo "endpoint_ip=${ip:-NONE}"; echo "manufacturer=${manufacturer:-NONE}"; echo "model=${model:-NONE}"
  [ "$count" -eq 1 ] && [ "$ip" = 192.168.1.169 ] && [ "$manufacturer" = Grandstream ] && [ "$model" = GXP1630 ]
  rm -f "$d"; trap - RETURN EXIT
  echo 'GXP1630-DISCOVERY-PASS'
}

configure_grandstream_gxp1630_201() {
  local d id other_selected accounts peer raw bin xml
  d="$(make_db_defaults_file)"; trap 'rm -f "$d"' RETURN EXIT
  id="$(mysql_scalar "$d" "SELECT e.id FROM endpoint e JOIN manufacturer mf ON mf.id=e.id_manufacturer JOIN model m ON m.id=e.id_model WHERE mf.name='Grandstream' AND m.name='GXP1630' AND UPPER(e.mac_address)='C0:74:AD:B4:AD:70' AND e.last_known_ipv4='192.168.1.169' LIMIT 1;")"
  [[ "$id" =~ ^[0-9]+$ ]] || { echo 'ERROR: exact GXP1630 endpoint missing' >&2; exit 1; }
  other_selected="$(mysql_scalar "$d" "SELECT COUNT(*) FROM endpoint WHERE selected=1 AND id<>$id;")"
  accounts="$(mysql_scalar "$d" "SELECT COUNT(*) FROM endpoint_account WHERE id_endpoint=$id;")"
  [ "$other_selected" -eq 0 ] && [ "$accounts" -eq 0 ] || { echo "ERROR: unsafe selection/accounts other=$other_selected accounts=$accounts" >&2; exit 1; }
  peer="$(asterisk -rx 'sip show peer 201' 2>/dev/null || true)"
  grep -Eq 'Name[[:space:]]*:[[:space:]]*201([[:space:]]|$)' <<<"$peer" || { echo 'ERROR: SIP 201 missing' >&2; exit 1; }
  [ ! -e "$GRANDSTREAM_GXP1630_STAGE_STATE_FILE" ] || { echo 'ERROR: pending GXP1630 stage state' >&2; exit 1; }
  printf 'endpoint_id=%s\n' "$id" > "$GRANDSTREAM_GXP1630_STAGE_STATE_FILE"; chmod 0600 "$GRANDSTREAM_GXP1630_STAGE_STATE_FILE"
  mysql --defaults-extra-file="$d" endpointconfig -e "START TRANSACTION; INSERT INTO endpoint_account (id_endpoint,tech,account,priority) VALUES ($id,'sip','201',1); UPDATE endpoint SET selected=1 WHERE id=$id; COMMIT;"
  raw="$(mktemp /tmp/test60-apply.XXXXXX)"
  if ! /usr/bin/issabel-endpointconfig --applyconfig >"$raw" 2>&1; then
    sed -E 's/(password|secret|sid|cookie)[^ ]*/\1=***OCULTO***/Ig' "$raw" | tail -n 80
    mysql --defaults-extra-file="$d" endpointconfig -e "DELETE FROM endpoint_account WHERE id_endpoint=$id AND tech='sip' AND account='201'; UPDATE endpoint SET selected=0 WHERE id=$id;"
    rm -f "$GRANDSTREAM_GXP1630_STAGE_STATE_FILE" "$raw" "$d"; trap - RETURN EXIT
    echo 'GXP1630-CONFIGURE-ROLLBACK-PASS'; return 1
  fi
  sed -E 's/(password|secret|sid|cookie)[^ ]*/\1=***OCULTO***/Ig' "$raw" | tail -n 80
  rm -f "$raw"
  bin='/tftpboot/cfgc074adb4ad70'; xml='/tftpboot/cfgc074adb4ad70.xml'
  [ "$(mysql_scalar "$d" "SELECT selected FROM endpoint WHERE id=$id;")" -eq 0 ]
  [ -s "$bin" ] && [ -s "$xml" ]
  python3 - "$xml" <<'PY'
import sys, xml.etree.ElementTree as ET
r=ET.parse(sys.argv[1]).getroot(); c=r.find('config'); v={x.tag:(x.text or '') for x in c}
assert (r.findtext('mac') or '').lower()=='c074adb4ad70'
assert v.get('P35')=='201' and v.get('P36')=='201' and bool(v.get('P34'))
assert v.get('P47')=='192.168.1.10'
PY
  rm -f "$GRANDSTREAM_GXP1630_STAGE_STATE_FILE" "$d"; trap - RETURN EXIT
  echo 'GXP1630-CONFIGURE-SERVER-PASS'
}

