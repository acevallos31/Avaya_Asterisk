inspect_grandstream_grp2601p_configure_preflight() {
  local d id endpoint_count ip model manufacturer selected accounts other_selected ext peer present assigned candidate status
  d="$(make_db_defaults_file)"
  trap 'rm -f "$d"' RETURN EXIT

  endpoint_count="$(mysql_scalar "$d" "SELECT COUNT(*) FROM endpoint WHERE UPPER(mac_address)='EC:74:D7:1E:E8:E3';")"
  id="$(mysql_scalar "$d" "SELECT COALESCE(id,'') FROM endpoint WHERE UPPER(mac_address)='EC:74:D7:1E:E8:E3' LIMIT 1;")"
  [[ "$id" =~ ^[0-9]+$ ]] || { echo 'ERROR: exact GRP2601P endpoint missing' >&2; exit 1; }
  ip="$(mysql_scalar "$d" "SELECT COALESCE(last_known_ipv4,'') FROM endpoint WHERE id=$id;")"
