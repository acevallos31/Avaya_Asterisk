#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-}"
OVERLAY_ROOT="${2:-}"

BASE="/usr/share/issabel/endpoint-classes"
VENDOR_DST="$BASE/class/issabel/vendor/Avaya.py"
TPL_J129_DST="$BASE/tpl/Avaya_J129.tpl"
TPL_GLOBAL_DST="$BASE/tpl/Avaya_global_SIP.tpl"
STATE_DIR="/var/lib/avaya-j129-lab"
BACKUP_DIR="$STATE_DIR/backup"
STAMP_FILE="$STATE_DIR/installed.sha256"
DB_STATE_FILE="$STATE_DIR/db-j129.state"
GRANDSTREAM_OUI_STATE_FILE="$STATE_DIR/grandstream-c074ad.state"
GRANDSTREAM_GXP1630_MODEL_STATE_FILE="$STATE_DIR/grandstream-gxp1630-model.state"
GRANDSTREAM_GRP2601P_MODEL_STATE_FILE="$STATE_DIR/grandstream-grp2601p-model.state"
GRANDSTREAM_GRP2601P_OUI_STATE_FILE="$STATE_DIR/grandstream-grp2601p-ec74d7.state"
GRANDSTREAM_GRP26XX_PATCH_BACKUP="$STATE_DIR/Grandstream.py.pre-grp26xx"
GRANDSTREAM_GRP2601P_STAGE_STATE_FILE="$STATE_DIR/grandstream-grp2601p-203.state"
GRANDSTREAM_GXP1630_STAGE_STATE_FILE="$STATE_DIR/grandstream-gxp1630-201.state"
GRANDSTREAM_PY="$BASE/class/issabel/vendor/Grandstream.py"
GRANDSTREAM_LOGIN_PATCH_BACKUP="$STATE_DIR/Grandstream.py.pre-g10-14"
HTTP_STATE_DIR="$STATE_DIR/httpd"
HTTP_CONF_DST="/etc/httpd/conf.d/avaya-j129-provisioning.conf"
AMPORTAL_CONF="/etc/amportal.conf"

usage() {
  echo "Uso: $0 {install|rollback|install-http|rollback-http} <overlay-root> | {inspect-db|inspect-provisioning|inspect-http-requests|inspect-sip-registration|install-db|rollback-db|apply-grandstream-oui|rollback-grandstream-oui|inspect-login-patch|apply-login-patch|rollback-login-patch} | inspect-manufacturer <manufacturer> [model] [mac-prefix] | {install-endpoint-credentials|rollback-endpoint-credentials}" >&2
  exit 2
}

read_amportal_value() { local key="$1"; sed -n "s/^${key}=//p" "$AMPORTAL_CONF" | head -n 1; }
escape_mysql_option_value() { local value="$1"; value="${value//\\/\\\\}"; value="${value//\"/\\\"}"; printf '%s' "$value"; }
make_db_defaults_file() {
  command -v mysql >/dev/null 2>&1 || { echo "ERROR: cliente mysql no disponible" >&2; exit 1; }
  [ -r "$AMPORTAL_CONF" ] || { echo "ERROR: no se puede leer $AMPORTAL_CONF" >&2; exit 1; }
  local db_user db_pass db_host defaults_file
  db_user="$(read_amportal_value AMPDBUSER)"; db_pass="$(read_amportal_value AMPDBPASS)"; db_host="$(read_amportal_value AMPDBHOST)"
  [ -n "$db_user" ] || { echo "ERROR: AMPDBUSER no definido" >&2; exit 1; }; [ -n "$db_pass" ] || { echo "ERROR: AMPDBPASS no definido" >&2; exit 1; }; [ -n "$db_host" ] || db_host="localhost"
  defaults_file="$(mktemp /tmp/avaya-j129-db.XXXXXX.cnf)"; chmod 0600 "$defaults_file"
  { echo '[client]'; printf 'user="%s"\n' "$(escape_mysql_option_value "$db_user")"; printf 'password="%s"\n' "$(escape_mysql_option_value "$db_pass")"; printf 'host="%s"\n' "$(escape_mysql_option_value "$db_host")"; } > "$defaults_file"
  printf '%s' "$defaults_file"
}
mysql_scalar() { local defaults_file="$1" sql="$2"; mysql --defaults-extra-file="$defaults_file" --batch --skip-column-names endpointconfig -e "$sql"; }

run_db_inspection() {
  local defaults_file; defaults_file="$(make_db_defaults_file)"; trap 'rm -f "$defaults_file"' RETURN EXIT
  echo "=== ENDPOINTCONFIG DB AUDIT (SOLO LECTURA) ==="; echo "Host: $(hostname)"; echo "DB auth: configuración local de Issabel (credenciales ocultas)"
  mysql --defaults-extra-file="$defaults_file" --batch --raw endpointconfig <<'SQL'
SET SESSION TRANSACTION READ ONLY;
SELECT '=== AVAYA MANUFACTURER ==='; SELECT id, name, description FROM manufacturer WHERE name = 'Avaya';
SELECT '=== AVAYA/J129 MODEL ==='; SELECT m.id, m.id_manufacturer, m.name, m.description, m.max_accounts, m.static_ip_supported, m.dynamic_ip_supported, m.static_prov_supported FROM model m JOIN manufacturer mf ON mf.id = m.id_manufacturer WHERE mf.name = 'Avaya' AND m.name = 'J129';
SELECT '=== J129 MODEL PROPERTIES ==='; SELECT mp.id, mp.property_key, CASE WHEN LOWER(mp.property_key) LIKE '%password%' THEN '***OCULTO***' ELSE mp.property_value END AS property_value FROM model_properties mp JOIN model m ON m.id = mp.id_model JOIN manufacturer mf ON mf.id = m.id_manufacturer WHERE mf.name = 'Avaya' AND m.name = 'J129' ORDER BY mp.property_key, mp.id;
SELECT '=== AVAYA C8:1F:EA PREFIX ==='; SELECT mp.id, mp.id_manufacturer, mp.mac_prefix, mp.description, mf.name AS manufacturer FROM mac_prefix mp LEFT JOIN manufacturer mf ON mf.id = mp.id_manufacturer WHERE mp.mac_prefix = 'C8:1F:EA';
SELECT '=== AVAYA ENDPOINT COUNT ==='; SELECT COUNT(*) AS total FROM endpoint e JOIN manufacturer mf ON mf.id=e.id_manufacturer WHERE mf.name='Avaya'; ROLLBACK;
SQL
  rm -f "$defaults_file"; trap - RETURN EXIT; echo "DB-READONLY-PASS"
}


run_endpoint_credentials_install() {
  local defaults_file count state_file="$STATE_DIR/endpoint-credentials.state"
  defaults_file="$(make_db_defaults_file)"
  trap 'rm -f "$defaults_file"' RETURN EXIT
  install -d -m 0755 "$STATE_DIR"
  for table in pbx_admin_password_policy endpoint_admin_credential endpoint_credential_event; do
    count="$(mysql_scalar "$defaults_file" "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='endpointconfig' AND table_name='$table';")"
    [ "$count" -eq 0 ] || { echo "ERROR: $table ya existe; instalación cancelada" >&2; exit 1; }
  done
  cat <<'SQL' | mysql --defaults-extra-file="$defaults_file" endpointconfig
CREATE TABLE pbx_admin_password_policy (
    id TINYINT UNSIGNED NOT NULL,
    pbx_identity VARCHAR(191) NOT NULL,
    active_version INT UNSIGNED NOT NULL DEFAULT 0,
    pending_version INT UNSIGNED NULL,
    ciphertext MEDIUMTEXT NULL,
    key_reference VARCHAR(191) NOT NULL,
    status VARCHAR(32) NOT NULL DEFAULT 'UNCONFIGURED',
    created_at DATETIME NOT NULL,
    rotated_at DATETIME NULL,
    PRIMARY KEY (id),
    UNIQUE KEY uq_pbx_admin_password_policy_identity (pbx_identity)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
CREATE TABLE endpoint_admin_credential (
    id_endpoint INT UNSIGNED NOT NULL,
    source VARCHAR(16) NOT NULL,
    ciphertext MEDIUMTEXT NULL,
    key_reference VARCHAR(191) NOT NULL,
    version INT UNSIGNED NOT NULL DEFAULT 0,
    validation_status VARCHAR(32) NOT NULL DEFAULT 'PENDING',
    last_validated_at DATETIME NULL,
    rotation_status VARCHAR(32) NOT NULL DEFAULT 'NONE',
    updated_at DATETIME NOT NULL,
    PRIMARY KEY (id_endpoint),
    CONSTRAINT fk_endpoint_admin_credential_endpoint FOREIGN KEY (id_endpoint) REFERENCES endpoint(id) ON DELETE CASCADE,
    CONSTRAINT chk_endpoint_admin_credential_source CHECK (source IN ('GLOBAL', 'OVERRIDE', 'FACTORY'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
CREATE TABLE endpoint_credential_event (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    id_endpoint INT UNSIGNED NULL,
    operation VARCHAR(32) NOT NULL,
    result VARCHAR(32) NOT NULL,
    actor VARCHAR(191) NOT NULL,
    correlation_id CHAR(36) NOT NULL,
    created_at DATETIME NOT NULL,
    PRIMARY KEY (id),
    KEY idx_endpoint_credential_event_endpoint (id_endpoint),
    KEY idx_endpoint_credential_event_created (created_at),
    CONSTRAINT fk_endpoint_credential_event_endpoint FOREIGN KEY (id_endpoint) REFERENCES endpoint(id) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
SQL
  printf 'created_by_helper=1\n' > "$state_file"; chmod 0600 "$state_file"
  for table in pbx_admin_password_policy endpoint_admin_credential endpoint_credential_event; do
    count="$(mysql_scalar "$defaults_file" "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='endpointconfig' AND table_name='$table';")"
    [ "$count" -eq 1 ] || { echo "ERROR: verificación falló para $table" >&2; exit 1; }
  done
  rm -f "$defaults_file"; trap - RETURN EXIT
  echo 'ENDPOINT-CREDENTIALS-INSTALL-PASS'
}

run_endpoint_credentials_rollback() {
  local defaults_file state_file="$STATE_DIR/endpoint-credentials.state"
  [ -f "$state_file" ] || { echo 'ERROR: no existe estado de instalación; rollback cancelado' >&2; exit 1; }
  defaults_file="$(make_db_defaults_file)"
  trap 'rm -f "$defaults_file"' RETURN EXIT
  cat <<'SQL' | mysql --defaults-extra-file="$defaults_file" endpointconfig
DROP TABLE IF EXISTS endpoint_credential_event;
DROP TABLE IF EXISTS endpoint_admin_credential;
DROP TABLE IF EXISTS pbx_admin_password_policy;
SQL
  for table in pbx_admin_password_policy endpoint_admin_credential endpoint_credential_event; do
    count="$(mysql_scalar "$defaults_file" "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='endpointconfig' AND table_name='$table';")"
    [ "$count" -eq 0 ] || { echo "ERROR: rollback incompleto para $table" >&2; exit 1; }
  done
  rm -f "$state_file" "$defaults_file"; trap - RETURN EXIT
  echo 'ENDPOINT-CREDENTIALS-ROLLBACK-PASS'
}

run_manufacturer_inspection() {
  local manufacturer="${1:-}" model="${2:-}" prefix="${3:-}" defaults_file model_norm prefix_norm
  [ -n "$manufacturer" ] || usage
  [[ "$manufacturer" =~ ^[A-Za-z0-9._\ -]+$ ]] || { echo 'ERROR: manufacturer contiene caracteres no permitidos' >&2; exit 2; }
  [[ -z "$model" || "$model" =~ ^[A-Za-z0-9._\ -]+$ ]] || { echo 'ERROR: model contiene caracteres no permitidos' >&2; exit 2; }
  [[ -z "$prefix" || "$prefix" =~ ^[0-9A-Fa-f:.-]+$ ]] || { echo 'ERROR: mac-prefix contiene caracteres no permitidos' >&2; exit 2; }
  model_norm="$(printf '%s' "$model" | tr -d ' ' | tr '[:lower:]' '[:upper:]')"
  prefix_norm="$(printf '%s' "$prefix" | tr '[:lower:]' '[:upper:]')"
  defaults_file="$(make_db_defaults_file)"; trap 'rm -f "$defaults_file"' RETURN EXIT
  echo '=== ENDPOINTCONFIG MANUFACTURER AUDIT (SOLO LECTURA) ==='
  echo "Host: $(hostname)"
  echo "Manufacturer: $manufacturer"
  echo "Model: ${model:-<todos>}"
  echo "MAC prefix: ${prefix:-<todos>}"
  echo 'DB auth: configuración local de Issabel (credenciales ocultas)'
  mysql --defaults-extra-file="$defaults_file" --batch --raw endpointconfig <<SQL
SET SESSION TRANSACTION READ ONLY;
SELECT '=== MANUFACTURER ===';
SELECT id,name,description FROM manufacturer WHERE name='${manufacturer}';
SELECT '=== MODELS ===';
SELECT m.id,m.id_manufacturer,m.name,m.description,m.max_accounts,m.static_ip_supported,m.dynamic_ip_supported,m.static_prov_supported
FROM model m JOIN manufacturer mf ON mf.id=m.id_manufacturer
WHERE mf.name='${manufacturer}' AND ('${model_norm}'='' OR UPPER(REPLACE(m.name,' ',''))='${model_norm}')
ORDER BY m.name;
SELECT '=== MODEL PROPERTIES ===';
SELECT m.name AS model,mp.id,mp.property_key,
CASE WHEN LOWER(mp.property_key) LIKE '%password%' THEN '***OCULTO***' ELSE mp.property_value END AS property_value
FROM model_properties mp JOIN model m ON m.id=mp.id_model JOIN manufacturer mf ON mf.id=m.id_manufacturer
WHERE mf.name='${manufacturer}' AND ('${model_norm}'='' OR UPPER(REPLACE(m.name,' ',''))='${model_norm}')
ORDER BY m.name,mp.property_key,mp.id;
SELECT '=== MAC PREFIXES ===';
SELECT mp.id,mp.id_manufacturer,mp.mac_prefix,mp.description,mf.name AS manufacturer
FROM mac_prefix mp JOIN manufacturer mf ON mf.id=mp.id_manufacturer
WHERE mf.name='${manufacturer}'
ORDER BY mp.mac_prefix;
SELECT '=== REQUESTED PREFIX LOOKUP ===';
SELECT mp.id,mp.id_manufacturer,mp.mac_prefix,mp.description,mf.name AS manufacturer
FROM mac_prefix mp LEFT JOIN manufacturer mf ON mf.id=mp.id_manufacturer
WHERE '${prefix_norm}'<>'' AND UPPER(mp.mac_prefix)='${prefix_norm}';
SELECT '=== ENDPOINT COUNT ===';
SELECT COUNT(*) AS total FROM endpoint e JOIN manufacturer mf ON mf.id=e.id_manufacturer WHERE mf.name='${manufacturer}';
SELECT '=== ENDPOINTS (NO SECRETS) ===';
SELECT e.id,e.mac_address,e.last_known_ipv4,m.name AS model,e.selected,
       (SELECT COUNT(*) FROM endpoint_account ea WHERE ea.id_endpoint=e.id) AS account_count
FROM endpoint e JOIN manufacturer mf ON mf.id=e.id_manufacturer
LEFT JOIN model m ON m.id=e.id_model
WHERE mf.name='${manufacturer}'
  AND ('${model_norm}'='' OR UPPER(REPLACE(COALESCE(m.name,''),' ',''))='${model_norm}')
ORDER BY e.id;
ROLLBACK;
SQL
  rm -f "$defaults_file"; trap - RETURN EXIT; echo 'MANUFACTURER-DB-READONLY-PASS'
}

run_provisioning_inspection() {
  local defaults_file mac compact file; defaults_file="$(make_db_defaults_file)"; trap 'rm -f "$defaults_file"' RETURN EXIT
  echo '=== J129 PROVISIONING AUDIT (SOLO LECTURA) ==='
  mysql --defaults-extra-file="$defaults_file" --batch --raw endpointconfig <<'SQL'
SET SESSION TRANSACTION READ ONLY;
SELECT '=== ENDPOINT AVAYA/J129 ==='; SELECT e.id, e.mac_address, e.last_known_ipv4, mf.name AS manufacturer, m.name AS model FROM endpoint e JOIN manufacturer mf ON mf.id=e.id_manufacturer LEFT JOIN model m ON m.id=e.id_model WHERE mf.name='Avaya' AND m.name='J129';
SELECT '=== CUENTAS ASIGNADAS (SIN SECRETOS) ==='; SELECT e.mac_address, ea.account, ea.priority FROM endpoint e JOIN manufacturer mf ON mf.id=e.id_manufacturer JOIN model m ON m.id=e.id_model JOIN endpoint_account ea ON ea.id_endpoint=e.id WHERE mf.name='Avaya' AND m.name='J129' ORDER BY e.mac_address, ea.priority; ROLLBACK;
SQL
  echo '=== ARCHIVOS DE PROVISIONING POR MAC ==='
  while IFS= read -r mac; do [ -n "$mac" ] || continue; compact="$(printf '%s' "$mac" | tr -d ':-' | tr '[:upper:]' '[:lower:]')"; file="/tftpboot/${compact}.txt"; if [ -f "$file" ]; then printf '%s\tPRESENTE\t' "$file"; stat -c 'owner=%U group=%G mode=%a size=%s mtime=%y' "$file"; echo '--- DIRECTIVAS SEGURAS ---'; grep -Ei '^[[:space:]]*SET[[:space:]]+(SIP_CONTROLLER_LIST|SIPPROXYSRVR|SIPDOMAIN|SIPPORT|FORCE_SIP_USERNAME|FORCE_SIP_EXTENSION|DISPLAY_NAME)' "$file" 2>/dev/null | sed -E 's/(FORCE_SIP_USERNAME[[:space:]]+).*/\1***PRESENTE***/I' || true; if grep -Eqi '^[[:space:]]*SET[[:space:]]+FORCE_SIP_PASSWORD[[:space:]]+' "$file"; then echo 'FORCE_SIP_PASSWORD=***PRESENTE-Y-OCULTO***'; else echo 'FORCE_SIP_PASSWORD=AUSENTE'; fi; else echo "$file AUSENTE"; fi; done < <(mysql --defaults-extra-file="$defaults_file" --batch --skip-column-names endpointconfig -e "SELECT e.mac_address FROM endpoint e JOIN manufacturer mf ON mf.id=e.id_manufacturer JOIN model m ON m.id=e.id_model WHERE mf.name='Avaya' AND m.name='J129';")
  echo '=== GLOBAL AVAYA ==='; for file in /tftpboot/46xxsettings.txt /tftpboot/J100Supgrade.txt; do if [ -f "$file" ]; then stat -c '%n PRESENTE owner=%U group=%G mode=%a size=%s mtime=%y' "$file"; else echo "$file AUSENTE"; fi; done
  rm -f "$defaults_file"; trap - RETURN EXIT; echo 'J129-PROVISIONING-AUDIT-PASS'
}

run_http_request_inspection() {
  local phone_ip='192.168.1.171' found=0 log needle tmp
  tmp="$(mktemp /tmp/avaya-j129-http.XXXXXX)"; chmod 0600 "$tmp"; trap 'rm -f "$tmp"' RETURN EXIT
  echo '=== J129 HTTP REQUEST AUDIT (SOLO LECTURA) ==='; echo "Telefono esperado: ${phone_ip}"; echo 'Se muestran solamente lineas de access log originadas por el telefono; no se leen archivos de provisioning.'
  for log in /var/log/httpd/access_log /var/log/httpd/*access*.log; do
    [ -f "$log" ] || continue
    if grep -F "$phone_ip" "$log" >/dev/null 2>&1; then
      grep -F "$phone_ip" "$log" >> "$tmp"; found=1
    fi
  done
  if [ "$found" -eq 1 ]; then
    sort -u "$tmp" | tail -n 100 | sed -E 's#(GET|HEAD|POST) ([^ ]*FORCE_SIP_PASSWORD[^ ]*)#\1 ***OCULTO***#Ig'
  else
    echo 'SIN-SOLICITUDES-HTTP-DEL-J129'
  fi
  echo '=== RESUMEN ARCHIVOS ESPERADOS ==='
  for needle in '46xxsettings.txt' 'c81fea9b650d.txt' 'J100Supgrade.txt'; do
    if grep -Fi "$needle" "$tmp" >/dev/null 2>&1; then echo "$needle: SOLICITADO"; else echo "$needle: NO-OBSERVADO"; fi
  done
  rm -f "$tmp"; trap - RETURN EXIT; echo 'J129-HTTP-REQUEST-AUDIT-PASS'
}

run_sip_registration_inspection() {
  local defaults_file account expected_ip='192.168.1.171' sip_out pjsip_out registered=0
  command -v asterisk >/dev/null 2>&1 || { echo 'ERROR: asterisk CLI no disponible' >&2; exit 1; }
  defaults_file="$(make_db_defaults_file)"; trap 'rm -f "$defaults_file"' RETURN EXIT
  account="$(mysql_scalar "$defaults_file" "SELECT ea.account FROM endpoint e JOIN manufacturer mf ON mf.id=e.id_manufacturer JOIN model m ON m.id=e.id_model JOIN endpoint_account ea ON ea.id_endpoint=e.id WHERE mf.name='Avaya' AND m.name='J129' AND e.mac_address='C8:1F:EA:9B:65:0D' ORDER BY ea.priority LIMIT 1;")"
  [ -n "$account" ] || { echo 'ERROR: J129 no tiene cuenta asignada en Endpoint Configurator' >&2; exit 1; }
  echo '=== J129 SIP REGISTRATION AUDIT (SOLO LECTURA) ==='; echo "Cuenta esperada: $account"; echo "IP esperada del telefono: $expected_ip"; echo 'No se consultan ni muestran secretos SIP.'
  sip_out="$(asterisk -rx 'sip show peers' 2>/dev/null || true)"
  pjsip_out="$(asterisk -rx 'pjsip show contacts' 2>/dev/null || true)"
  echo '=== CHAN_SIP ==='
  if printf '%s\n' "$sip_out" | grep -E "(^|[[:space:]])${account}(/|[[:space:]])" | grep -F "$expected_ip" >/dev/null 2>&1; then
    printf '%s\n' "$sip_out" | grep -E "(^|[[:space:]])${account}(/|[[:space:]])" | grep -F "$expected_ip" | sed -E 's/[[:space:]]+/ /g'; registered=1
  else echo 'Sin coincidencia cuenta+IP.'; fi
  echo '=== PJSIP ==='
  if printf '%s\n' "$pjsip_out" | grep -F "$account" | grep -F "$expected_ip" >/dev/null 2>&1; then
    printf '%s\n' "$pjsip_out" | grep -F "$account" | grep -F "$expected_ip" | sed -E 's/[[:space:]]+/ /g'; registered=1
  else echo 'Sin coincidencia cuenta+IP.'; fi
  rm -f "$defaults_file"; trap - RETURN EXIT
  [ "$registered" -eq 1 ] || { echo 'J129-SIP-REGISTRATION-FAIL'; exit 1; }
  echo 'J129-SIP-REGISTRATION-PASS'
}

install_http_j129() {
  local src backup marker; [ -n "$OVERLAY_ROOT" ] || usage; src="$OVERLAY_ROOT/httpd/avaya-j129-provisioning.conf"; [ -f "$src" ] || { echo "ERROR: falta $src" >&2; exit 1; }; command -v apachectl >/dev/null 2>&1 || { echo "ERROR: apachectl no disponible" >&2; exit 1; }; install -d -m 0755 "$HTTP_STATE_DIR"; backup="$HTTP_STATE_DIR/avaya-j129-provisioning.conf.backup"; marker="$HTTP_STATE_DIR/avaya-j129-provisioning.conf.absent"; if [ ! -e "$backup" ] && [ ! -e "$marker" ]; then if [ -e "$HTTP_CONF_DST" ]; then cp -a "$HTTP_CONF_DST" "$backup"; else : > "$marker"; fi; fi; install -o root -g root -m 0644 "$src" "$HTTP_CONF_DST"; if ! apachectl -t; then echo "ERROR: configuración Apache inválida; restaurando estado anterior" >&2; if [ -f "$backup" ]; then cp -a "$backup" "$HTTP_CONF_DST"; else rm -f "$HTTP_CONF_DST"; fi; apachectl -t || true; exit 1; fi; systemctl reload httpd; echo 'HTTP-J129-INSTALL-PASS'
}
rollback_http_j129() { local backup marker; backup="$HTTP_STATE_DIR/avaya-j129-provisioning.conf.backup"; marker="$HTTP_STATE_DIR/avaya-j129-provisioning.conf.absent"; if [ -f "$backup" ]; then cp -a "$backup" "$HTTP_CONF_DST"; elif [ -f "$marker" ]; then rm -f "$HTTP_CONF_DST"; else echo "ERROR: no existe estado previo HTTP para rollback" >&2; exit 1; fi; apachectl -t; systemctl reload httpd; rm -f "$backup" "$marker"; echo 'HTTP-J129-ROLLBACK-PASS'; }

apply_grandstream_oui() {
  local defaults_file manufacturer_count manufacturer_id model_count prefix_total prefix_other prefix_grandstream final_count
  defaults_file="$(make_db_defaults_file)"; trap 'rm -f "$defaults_file"' RETURN EXIT
  install -d -m 0755 "$STATE_DIR"

  manufacturer_count="$(mysql_scalar "$defaults_file" "SELECT COUNT(*) FROM manufacturer WHERE name='Grandstream';")"
  [ "$manufacturer_count" -eq 1 ] || { echo "ERROR: se esperaba exactamente un fabricante Grandstream y se encontraron $manufacturer_count" >&2; exit 1; }
  manufacturer_id="$(mysql_scalar "$defaults_file" "SELECT id FROM manufacturer WHERE name='Grandstream' LIMIT 1;")"
  [ "$manufacturer_id" = '10' ] || { echo "ERROR: manufacturer_id Grandstream inesperado: $manufacturer_id" >&2; exit 1; }
  model_count="$(mysql_scalar "$defaults_file" "SELECT COUNT(*) FROM model WHERE id_manufacturer=$manufacturer_id AND name='GXP1625';")"
  [ "$model_count" -eq 1 ] || { echo "ERROR: GXP1625 no existe de forma única para Grandstream" >&2; exit 1; }

  prefix_total="$(mysql_scalar "$defaults_file" "SELECT COUNT(*) FROM mac_prefix WHERE UPPER(mac_prefix)='C0:74:AD';")"
  prefix_other="$(mysql_scalar "$defaults_file" "SELECT COUNT(*) FROM mac_prefix mp LEFT JOIN manufacturer mf ON mf.id=mp.id_manufacturer WHERE UPPER(mp.mac_prefix)='C0:74:AD' AND COALESCE(mf.name,'')<>'Grandstream';")"
  prefix_grandstream="$(mysql_scalar "$defaults_file" "SELECT COUNT(*) FROM mac_prefix mp JOIN manufacturer mf ON mf.id=mp.id_manufacturer WHERE UPPER(mp.mac_prefix)='C0:74:AD' AND mf.name='Grandstream';")"

  [ "$prefix_other" -eq 0 ] || { echo 'ERROR: C0:74:AD ya pertenece a otro fabricante; apply cancelado' >&2; exit 1; }
  [ "$prefix_total" -le 1 ] || { echo 'ERROR: C0:74:AD aparece duplicado en mac_prefix; apply cancelado' >&2; exit 1; }

  if [ "$prefix_grandstream" -eq 1 ]; then
    echo "GRANDSTREAM-OUI-ALREADY-PRESENT manufacturer_id=$manufacturer_id oui=C0:74:AD"
    rm -f "$defaults_file"; trap - RETURN EXIT
    return 0
  fi

  [ "$prefix_total" -eq 0 ] || { echo 'ERROR: estado inconsistente de C0:74:AD; apply cancelado' >&2; exit 1; }
  [ ! -e "$GRANDSTREAM_OUI_STATE_FILE" ] || { echo "ERROR: existe estado previo pendiente: $GRANDSTREAM_OUI_STATE_FILE" >&2; exit 1; }

  {
    echo 'created_by_helper=1'
    echo "manufacturer_id=$manufacturer_id"
    echo 'mac_prefix=C0:74:AD'
  } > "$GRANDSTREAM_OUI_STATE_FILE"
  chmod 0600 "$GRANDSTREAM_OUI_STATE_FILE"

  if ! mysql --defaults-extra-file="$defaults_file" endpointconfig <<SQL
START TRANSACTION;
INSERT INTO mac_prefix (id_manufacturer, mac_prefix, description)
SELECT ${manufacturer_id}, 'C0:74:AD', 'Grandstream'
FROM DUAL
WHERE NOT EXISTS (SELECT 1 FROM mac_prefix WHERE UPPER(mac_prefix)='C0:74:AD');
COMMIT;
SQL
  then
    rm -f "$GRANDSTREAM_OUI_STATE_FILE"
    exit 1
  fi

  final_count="$(mysql_scalar "$defaults_file" "SELECT COUNT(*) FROM mac_prefix mp JOIN manufacturer mf ON mf.id=mp.id_manufacturer WHERE UPPER(mp.mac_prefix)='C0:74:AD' AND mf.name='Grandstream' AND mp.id_manufacturer=$manufacturer_id;")"
  [ "$final_count" -eq 1 ] || { echo 'ERROR: verificación post-apply falló; estado conservado para investigación/rollback' >&2; exit 1; }

  rm -f "$defaults_file"; trap - RETURN EXIT
  echo "GRANDSTREAM-OUI-APPLY-PASS manufacturer_id=$manufacturer_id oui=C0:74:AD"
}

