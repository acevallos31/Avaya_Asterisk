  manufacturer="$(mysql_scalar "$d" "SELECT COALESCE(mf.name,'') FROM endpoint e LEFT JOIN manufacturer mf ON mf.id=e.id_manufacturer WHERE e.id=$id;")"
  selected="$(mysql_scalar "$d" "SELECT COALESCE(selected,-1) FROM endpoint WHERE id=$id;")"
  accounts="$(mysql_scalar "$d" "SELECT COUNT(*) FROM endpoint_account WHERE id_endpoint=$id;")"
  other_selected="$(mysql_scalar "$d" "SELECT COUNT(*) FROM endpoint WHERE selected=1 AND id<>$id;")"

  echo "endpoint_count=$endpoint_count"
  echo "endpoint_id=$id"
  echo "endpoint_ip=$ip"
  echo "manufacturer=$manufacturer"
  echo "model=$model"
  echo "selected=$selected"
  echo "account_count=$accounts"
  echo "other_selected_count=$other_selected"

  [ "$endpoint_count" -eq 1 ] &&
    [ "$ip" = '192.168.1.176' ] &&
    [ "$manufacturer" = 'Grandstream' ] &&
    [ "$model" = 'GRP2601P' ] &&
    [ "$selected" -eq 0 ] &&
    [ "$accounts" -eq 0 ] &&
    [ "$other_selected" -eq 0 ] || {
      echo 'ERROR: unsafe GRP2601P Endpoint Configurator state' >&2
      exit 1
    }

  candidate=''
  for ext in $(seq 203 209); do
    peer="$(asterisk -rx "sip show peer $ext" 2>/dev/null || true)"
    if grep -Eq "Name[[:space:]]*:[[:space:]]*$ext([[:space:]]|$)" <<<"$peer"; then
      present=YES
    else
      present=NO
    fi
    assigned="$(mysql_scalar "$d" "SELECT COUNT(*) FROM endpoint_account WHERE tech='sip' AND account='$ext';")"
    if grep -Eq 'Status[[:space:]]*:[[:space:]]*OK' <<<"$peer"; then
      status=REGISTERED
    elif grep -Eq 'Status[[:space:]]*:' <<<"$peer"; then
      status=NOT_REGISTERED
    else
      status=NOT_PRESENT
    fi
    echo "extension_${ext}_present=$present"
    echo "extension_${ext}_endpoint_assignments=$assigned"
    echo "extension_${ext}_registration=$status"
    if [ -z "$candidate" ] && [ "$present" = YES ] && [ "$assigned" -eq 0 ]; then
      candidate="$ext"
    fi
  done

  echo "candidate_extension=${candidate:-NONE}"
  [ -n "$candidate" ] || {
    echo 'GRP2601P-CONFIGURE-PREFLIGHT-NO-FREE-EXTENSION'
    exit 1
  }

  rm -f "$d"
  trap - RETURN EXIT
  echo 'GRP2601P-CONFIGURE-PREFLIGHT-PASS'
}

