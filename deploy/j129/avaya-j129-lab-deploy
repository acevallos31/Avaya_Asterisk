#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-}"
OVERLAY_ROOT="${2:-}"

BASE="/usr/share/issabel/endpoint-classes"
VENDOR_DST="$BASE/class/issabel/vendor/Avaya.py"
TPL_J129_DST="$BASE/tpl/Avaya_J129.tpl"
TPL_GLOBAL_DST="$BASE/tpl/Avaya_global_SIP.tpl"
STATE_DIR="/var/lib/avaya-j129-lab"
BACKUP_DIR="$STATE_DIR/backup"
STAMP_FILE="$STATE_DIR/installed.sha256"
AMPORTAL_CONF="/etc/amportal.conf"

usage() {
  echo "Uso: $0 {install|rollback} <overlay-root> | inspect-db" >&2
  exit 2
}

read_amportal_value() {
  local key="$1"
  sed -n "s/^${key}=//p" "$AMPORTAL_CONF" | head -n 1
}

escape_mysql_option_value() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s' "$value"
}

run_db_inspection() {
  command -v mysql >/dev/null 2>&1 || {
    echo "ERROR: cliente mysql no disponible" >&2
    exit 1
  }

  [ -r "$AMPORTAL_CONF" ] || {
    echo "ERROR: no se puede leer $AMPORTAL_CONF" >&2
    exit 1
  }

  local db_user db_pass db_host defaults_file
  db_user="$(read_amportal_value AMPDBUSER)"
  db_pass="$(read_amportal_value AMPDBPASS)"
  db_host="$(read_amportal_value AMPDBHOST)"

  [ -n "$db_user" ] || { echo "ERROR: AMPDBUSER no definido" >&2; exit 1; }
  [ -n "$db_pass" ] || { echo "ERROR: AMPDBPASS no definido" >&2; exit 1; }
  [ -n "$db_host" ] || db_host="localhost"

  defaults_file="$(mktemp /tmp/avaya-j129-db.XXXXXX.cnf)"
  chmod 0600 "$defaults_file"
  trap 'rm -f "$defaults_file"' RETURN EXIT

  {
    echo '[client]'
    printf 'user="%s"\n' "$(escape_mysql_option_value "$db_user")"
    printf 'password="%s"\n' "$(escape_mysql_option_value "$db_pass")"
    printf 'host="%s"\n' "$(escape_mysql_option_value "$db_host")"
  } > "$defaults_file"

  echo "=== ENDPOINTCONFIG DB AUDIT (SOLO LECTURA) ==="
  echo "Host: $(hostname)"
  echo "DB auth: configuración local de Issabel (credenciales ocultas)"

  # No se aceptan consultas desde GitHub. El SQL permitido está fijo aquí.
  # Las credenciales se leen localmente desde amportal.conf y se pasan mediante
  # un archivo temporal 0600 que se elimina al terminar. Nunca se imprimen.
  mysql --defaults-extra-file="$defaults_file" --batch --raw endpointconfig <<'SQL'
SET SESSION TRANSACTION READ ONLY;

SELECT '=== TABLES ===';
SHOW TABLES;

SELECT '=== DESCRIBE manufacturer ===';
DESCRIBE manufacturer;

SELECT '=== DESCRIBE model ===';
DESCRIBE model;

SELECT '=== DESCRIBE model_properties ===';
DESCRIBE model_properties;

SELECT '=== DESCRIBE mac_prefix ===';
DESCRIBE mac_prefix;

SELECT '=== MANUFACTURERS ===';
SELECT * FROM manufacturer ORDER BY 1 LIMIT 200;

SELECT '=== MODELS ===';
SELECT * FROM model ORDER BY 1 LIMIT 500;

SELECT '=== MODEL PROPERTIES ===';
SELECT
  mp.id,
  mf.name AS manufacturer,
  m.id AS model_id,
  m.name AS model,
  mp.property_key,
  mp.property_value
FROM model_properties mp
JOIN model m ON m.id = mp.id_model
JOIN manufacturer mf ON mf.id = m.id_manufacturer
ORDER BY mf.name, m.name, mp.property_key, mp.id
LIMIT 1000;

SELECT '=== MODEL PROPERTIES FOR STATIC-PROV MODELS ===';
SELECT
  mf.name AS manufacturer,
  m.id AS model_id,
  m.name AS model,
  m.max_accounts,
  mp.property_key,
  mp.property_value
FROM model m
JOIN manufacturer mf ON mf.id = m.id_manufacturer
LEFT JOIN model_properties mp ON mp.id_model = m.id
WHERE m.static_prov_supported = 1
ORDER BY mf.name, m.name, mp.property_key
LIMIT 1000;

SELECT '=== MAC PREFIX SAMPLE ===';
SELECT * FROM mac_prefix ORDER BY 1 LIMIT 500;

ROLLBACK;
SQL

  rm -f "$defaults_file"
  trap - RETURN EXIT
  echo "DB-READONLY-PASS"
}

[ -n "$ACTION" ] || usage

case "$ACTION" in
  inspect-db)
    [ -z "$OVERLAY_ROOT" ] || usage
    run_db_inspection
    ;;

  install|rollback)
    [ -n "$OVERLAY_ROOT" ] || usage

    SRC_BASE="$OVERLAY_ROOT/usr/share/issabel/endpoint-classes"
    VENDOR_SRC="$SRC_BASE/class/issabel/vendor/Avaya.py"
    TPL_J129_SRC="$SRC_BASE/tpl/Avaya_J129.tpl"
    TPL_GLOBAL_SRC="$SRC_BASE/tpl/Avaya_global_SIP.tpl"

    if [ "$ACTION" = "install" ]; then
      for f in "$VENDOR_SRC" "$TPL_J129_SRC" "$TPL_GLOBAL_SRC"; do
        [ -f "$f" ] || { echo "Falta archivo de overlay: $f" >&2; exit 1; }
      done

      install -d -m 0755 "$STATE_DIR" "$BACKUP_DIR"

      # Solo se hace backup una vez para preservar el estado original del LAB.
      for dst in "$VENDOR_DST" "$TPL_J129_DST" "$TPL_GLOBAL_DST"; do
        name="$(basename "$dst")"
        marker="$BACKUP_DIR/$name.absent"
        backup="$BACKUP_DIR/$name"
        if [ ! -e "$backup" ] && [ ! -e "$marker" ]; then
          if [ -e "$dst" ]; then
            cp -a "$dst" "$backup"
          else
            : > "$marker"
          fi
        fi
      done

      install -m 0644 "$VENDOR_SRC" "$VENDOR_DST"
      install -m 0644 "$TPL_J129_SRC" "$TPL_J129_DST"
      install -m 0644 "$TPL_GLOBAL_SRC" "$TPL_GLOBAL_DST"

      sha256sum "$VENDOR_DST" "$TPL_J129_DST" "$TPL_GLOBAL_DST" > "$STAMP_FILE"
      echo "Overlay J129 instalado"
    else
      install -d -m 0755 "$STATE_DIR" "$BACKUP_DIR"
      for dst in "$VENDOR_DST" "$TPL_J129_DST" "$TPL_GLOBAL_DST"; do
        name="$(basename "$dst")"
        marker="$BACKUP_DIR/$name.absent"
        backup="$BACKUP_DIR/$name"
        if [ -f "$backup" ]; then
          cp -a "$backup" "$dst"
        elif [ -f "$marker" ]; then
          rm -f "$dst"
        else
          echo "No existe estado de backup para $dst" >&2
          exit 1
        fi
      done
      rm -f "$STAMP_FILE"
      echo "Rollback J129 completado"
    fi
    ;;

  *) usage ;;
esac
