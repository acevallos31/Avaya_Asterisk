#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-}"
OVERLAY_ROOT="${2:-}"

BASE="/usr/share/issabel/endpoint-classes"
VENDOR_DST="$BASE/class/issabel/vendor/Avaya.py"
TPL_J129_DST="$BASE/tpl/Avaya_J129.tpl"
TPL_GLOBAL_DST="$BASE/tpl/Avaya_global_SIP.tpl"
STATE_DIR="/var/lib/avaya-j129-lab"
BACKUP_DIR="$STATE_DIR/backup"
STAMP_FILE="$STATE_DIR/installed.sha256"

usage() {
  echo "Uso: $0 {install|rollback} <overlay-root>" >&2
  exit 2
}

[ -n "$ACTION" ] || usage
[ -n "$OVERLAY_ROOT" ] || usage

SRC_BASE="$OVERLAY_ROOT/usr/share/issabel/endpoint-classes"
VENDOR_SRC="$SRC_BASE/class/issabel/vendor/Avaya.py"
TPL_J129_SRC="$SRC_BASE/tpl/Avaya_J129.tpl"
TPL_GLOBAL_SRC="$SRC_BASE/tpl/Avaya_global_SIP.tpl"

case "$ACTION" in
  install)
    for f in "$VENDOR_SRC" "$TPL_J129_SRC" "$TPL_GLOBAL_SRC"; do
      [ -f "$f" ] || { echo "Falta archivo de overlay: $f" >&2; exit 1; }
    done

    install -d -m 0755 "$STATE_DIR" "$BACKUP_DIR"

    # Solo se hace backup una vez para preservar el estado original del LAB.
    for dst in "$VENDOR_DST" "$TPL_J129_DST" "$TPL_GLOBAL_DST"; do
      name="$(basename "$dst")"
      marker="$BACKUP_DIR/$name.absent"
      backup="$BACKUP_DIR/$name"
      if [ ! -e "$backup" ] && [ ! -e "$marker" ]; then
        if [ -e "$dst" ]; then
          cp -a "$dst" "$backup"
        else
          : > "$marker"
        fi
      fi
    done

    install -m 0644 "$VENDOR_SRC" "$VENDOR_DST"
    install -m 0644 "$TPL_J129_SRC" "$TPL_J129_DST"
    install -m 0644 "$TPL_GLOBAL_SRC" "$TPL_GLOBAL_DST"

    sha256sum "$VENDOR_DST" "$TPL_J129_DST" "$TPL_GLOBAL_DST" > "$STAMP_FILE"
    echo "Overlay J129 instalado"
    ;;

  rollback)
    install -d -m 0755 "$STATE_DIR" "$BACKUP_DIR"
    for dst in "$VENDOR_DST" "$TPL_J129_DST" "$TPL_GLOBAL_DST"; do
      name="$(basename "$dst")"
      marker="$BACKUP_DIR/$name.absent"
      backup="$BACKUP_DIR/$name"
      if [ -f "$backup" ]; then
        cp -a "$backup" "$dst"
      elif [ -f "$marker" ]; then
        rm -f "$dst"
      else
        echo "No existe estado de backup para $dst" >&2
        exit 1
      fi
    done
    rm -f "$STAMP_FILE"
    echo "Rollback J129 completado"
    ;;

  *) usage ;;
esac
