apply_grandstream_grp26xx_patch() {
  [ -f "$GRANDSTREAM_PY" ] || { echo "ERROR: no existe $GRANDSTREAM_PY" >&2; exit 1; }
  install -d -o root -g root -m 0700 "$STATE_DIR"
  local marker_count before_sha after_sha tmp
  marker_count="$(grep -Fc 'GRP26XX-NONCE-CONFIG-UPDATE' "$GRANDSTREAM_PY" || true)"
  if [ "$marker_count" -ge 1 ]; then
    if grep -Fq "request('GET', '/api-will_login')" "$GRANDSTREAM_PY"; then
      echo 'GRP26XX-PATCH-V1-REFRESH=YES'
      rollback_grandstream_grp26xx_patch
