  p201="$(printf '%s\n' "$peers" | awk '$1 ~ /^201(\/|$)/ {print $2; exit}')"
  p202="$(printf '%s\n' "$peers" | awk '$1 ~ /^202(\/|$)/ {print $2; exit}')"
  http="$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 3 --max-time 5 http://192.168.1.176/ || true)"

  echo "endpoint_count=$count"
