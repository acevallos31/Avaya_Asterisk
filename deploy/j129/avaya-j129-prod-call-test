#!/usr/bin/env bash
set -euo pipefail

RUNNER_USER="github-runner-prod"
EXPECTED_HOST="cei-pbx02"
ASTERISK_BIN="/usr/sbin/asterisk"
ASTERISK_FULL_LOG="/var/log/asterisk/full"

fail(){ echo "J129-PROD-CALL-FAIL: $*" >&2; exit 1; }
pass(){ echo "$1"; }
need_root(){ [ "${EUID}" -eq 0 ] || fail "helper must run as root"; }
verify_caller(){
  [ "${SUDO_USER:-}" = "$RUNNER_USER" ] || fail "unauthorized caller"
  [ "$(hostname -s)" = "$EXPECTED_HOST" ] || fail "unexpected host"
  [ -x "$ASTERISK_BIN" ] || fail "asterisk binary missing"
}
validate_ext(){ [[ "${1:-}" =~ ^[0-9]{2,8}$ ]] || fail "invalid extension"; }
validate_ip(){
  local ip="${1:-}"
  [ -z "$ip" ] && return 0
  [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || fail "invalid phone_ip"
  local IFS=. octet
  read -r -a parts <<< "$ip"
  for octet in "${parts[@]}"; do
    [ "$octet" -ge 0 ] 2>/dev/null && [ "$octet" -le 255 ] || fail "invalid phone_ip"
  done
}
ax(){ "$ASTERISK_BIN" -rx "$1"; }

preflight(){
  ax 'core show version' | head -n1
  ax 'sip show peers' >/dev/null
  if [ -r "$ASTERISK_FULL_LOG" ]; then
    echo 'J129-PROD-CALL-FULL-LOG-READABLE=YES'
  else
    echo 'J129-PROD-CALL-FULL-LOG-READABLE=NO'
  fi
  pass 'J129-PROD-CALL-HELPER-PREFLIGHT-PASS'
}

peer_ready(){
  local ext="$1" out
  validate_ext "$ext"
  out="$(ax "sip show peer $ext")"
  printf '%s\n' "$out" | grep -Eq 'Status[[:space:]]*:[[:space:]]*(OK|Reachable)' || fail "peer not ready"
  echo "J129-PROD-CALL-PEER-READY-PASS extension=$ext"
}

cleanup_debug(){
  ax 'sip set debug off' >/dev/null 2>&1 || true
  ax 'rtp set debug off' >/dev/null 2>&1 || true
  ax 'core set verbose 3' >/dev/null 2>&1 || true
  echo 'J129-PROD-CALL-DEBUG-CLEANUP-DONE'
}

call_test(){
  local ext="$1" ip="${2:-}" start_line=0 tmp
  validate_ext "$ext"
  validate_ip "$ip"
  peer_ready "$ext"

  tmp="$(mktemp /tmp/j129-prod-call.XXXXXX.log)"
  chmod 0600 "$tmp"
  cleanup(){ cleanup_debug >>"$tmp" 2>&1 || true; }
  trap cleanup EXIT INT TERM

  if [ -r "$ASTERISK_FULL_LOG" ]; then
    start_line="$(wc -l < "$ASTERISK_FULL_LOG" || echo 0)"
  fi

  ax 'core set verbose 10' >>"$tmp" 2>&1
  ax "sip set debug peer $ext" >>"$tmp" 2>&1
  if [ -n "$ip" ]; then
    ax "rtp set debug ip $ip" >>"$tmp" 2>&1
  fi

  echo "J129-PROD-CALL-ORIGINATE-START extension=$ext" >>"$tmp"
  ax "channel originate SIP/$ext application Playback hello-world" >>"$tmp" 2>&1
  echo 'J129-PROD-CALL-ORIGINATE-COMMAND-PASS' >>"$tmp"
  sleep 3
  ax 'core show channels verbose' >>"$tmp" 2>&1 || true

  if [ -r "$ASTERISK_FULL_LOG" ]; then
    tail -n "+$((start_line + 1))" "$ASTERISK_FULL_LOG" 2>/dev/null \
      | sed -E \
          -e 's/(secret|password|passwd)[=:][^[:space:]]+/\1=[REDACTED]/Ig' \
          -e 's/(Authorization|Proxy-Authorization):.*/\1: [REDACTED]/Ig' \
      >>"$tmp" || true
  fi

  cleanup
  trap - EXIT INT TERM
  cat "$tmp"
  rm -f "$tmp"
  pass 'J129-PROD-CALL-AUTOMATED-PHASE-PASS'
}

main(){
  need_root
  verify_caller
  case "${1:-}" in
    preflight)
      [ "$#" -eq 1 ] || fail "unexpected arguments"
      preflight
      ;;
    peer)
      [ "$#" -eq 2 ] || fail "usage: peer EXT"
      peer_ready "$2"
      ;;
    call)
      [ "$#" -ge 2 ] && [ "$#" -le 3 ] || fail "usage: call EXT [IP]"
      call_test "$2" "${3:-}"
      ;;
    cleanup)
      [ "$#" -eq 1 ] || fail "unexpected arguments"
      cleanup_debug
      ;;
    *)
      echo "usage: $0 {preflight|peer EXT|call EXT [IP]|cleanup}" >&2
      exit 2
      ;;
  esac
}

main "$@"
