#!/usr/bin/env bash
set -euo pipefail

[ "$#" -eq 0 ] || {
  echo "ERROR: este sincronizador no acepta argumentos" >&2
  exit 2
}

RUNNER_USER="github-runner"
WORKSPACE="/opt/actions-runner/_work/Avaya_Asterisk/Avaya_Asterisk"
SOURCE="$WORKSPACE/deploy/j129/avaya-j129-lab-deploy"
DESTINATION="/usr/local/sbin/avaya-j129-lab-deploy"

[ "$(id -u)" -eq 0 ] || {
  echo "ERROR: debe ejecutarse como root" >&2
  exit 1
}

[ -f "$SOURCE" ] || {
  echo "ERROR: helper fuente no encontrado" >&2
  exit 1
}

owner="$(stat -c '%U' "$SOURCE")"
[ "$owner" = "$RUNNER_USER" ] || {
  echo "ERROR: propietario inesperado del helper fuente: $owner" >&2
  exit 1
}

case "$SOURCE" in
  "$WORKSPACE"/deploy/j129/avaya-j129-lab-deploy) ;;
  *) echo "ERROR: ruta fuente fuera del workspace permitido" >&2; exit 1 ;;
esac

bash -n "$SOURCE"

tmp="$(mktemp /usr/local/sbin/.avaya-j129-lab-deploy.XXXXXX)"
trap 'rm -f "$tmp"' EXIT
install -o root -g root -m 0755 "$SOURCE" "$tmp"
mv -f "$tmp" "$DESTINATION"
trap - EXIT

[ "$(stat -c '%U:%G:%a' "$DESTINATION")" = "root:root:755" ] || {
  echo "ERROR: permisos finales inesperados" >&2
  exit 1
}

bash -n "$DESTINATION"
echo "HELPER-SYNC-PASS"
