#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-}"
MANUFACTURER='Grandstream'
PREFIX='C0:74:AD'
DESCRIPTION='Grandstream C0:74:AD'
AMPORTAL_CONF='/etc/amportal.conf'
STATE_DIR='/var/lib/grandstream-lab'
STATE_FILE="$STATE_DIR/c074ad-prefix.state"
GRANDSTREAM_PY='/usr/share/issabel/endpoint-classes/class/issabel/vendor/Grandstream.py'
LOGIN_PATCH_BACKUP="$STATE_DIR/Grandstream.py.pre-g10-14"

usage() {
  echo "Uso: $0 {inspect|apply|rollback|inspect-login-patch|apply-login-patch|rollback-login-patch}" >&2
  exit 2
}

read_amportal_value() {
  local key="$1"
  sed -n "s/^${key}=//p" "$AMPORTAL_CONF" | head -n 1
}

escape_mysql_option_value() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s' "$value"
}

make_db_defaults_file() {
  command -v mysql >/dev/null 2>&1 || { echo 'ERROR: cliente mysql no disponible' >&2; exit 1; }
  [ -r "$AMPORTAL_CONF" ] || { echo "ERROR: no se puede leer $AMPORTAL_CONF" >&2; exit 1; }
  local db_user db_pass db_host defaults_file
  db_user="$(read_amportal_value AMPDBUSER)"
  db_pass="$(read_amportal_value AMPDBPASS)"
  db_host="$(read_amportal_value AMPDBHOST)"
  [ -n "$db_user" ] || { echo 'ERROR: AMPDBUSER no definido' >&2; exit 1; }
  [ -n "$db_pass" ] || { echo 'ERROR: AMPDBPASS no definido' >&2; exit 1; }
  [ -n "$db_host" ] || db_host='localhost'
  defaults_file="$(mktemp /tmp/grandstream-db.XXXXXX.cnf)"
  chmod 0600 "$defaults_file"
  {
    echo '[client]'
    printf 'user="%s"\n' "$(escape_mysql_option_value "$db_user")"
    printf 'password="%s"\n' "$(escape_mysql_option_value "$db_pass")"
    printf 'host="%s"\n' "$(escape_mysql_option_value "$db_host")"
  } > "$defaults_file"
  printf '%s' "$defaults_file"
}

mysql_scalar() {
  local defaults_file="$1" sql="$2"
  mysql --defaults-extra-file="$defaults_file" --batch --skip-column-names endpointconfig -e "$sql"
}

inspect_prefix() {
  local defaults_file
  defaults_file="$(make_db_defaults_file)"
  trap 'rm -f "$defaults_file"' RETURN EXIT
  echo '=== GRANDSTREAM OUI CONTROLLED AUDIT ==='
  echo "Host: $(hostname)"
  echo "Manufacturer: $MANUFACTURER"
  echo "Prefix: $PREFIX"
  echo 'DB auth: configuración local de Issabel (credenciales ocultas)'
  mysql --defaults-extra-file="$defaults_file" --batch --raw endpointconfig <<'SQL'
SET SESSION TRANSACTION READ ONLY;
SELECT '=== MANUFACTURER ===';
SELECT id,name,description FROM manufacturer WHERE name='Grandstream';
SELECT '=== PREFIX LOOKUP ===';
SELECT mp.id,mp.id_manufacturer,mp.mac_prefix,mp.description,mf.name AS manufacturer
FROM mac_prefix mp LEFT JOIN manufacturer mf ON mf.id=mp.id_manufacturer
WHERE UPPER(mp.mac_prefix)='C0:74:AD';
SELECT '=== GXP1625 MODEL ===';
SELECT m.id,m.id_manufacturer,m.name,m.max_accounts,m.static_prov_supported
FROM model m JOIN manufacturer mf ON mf.id=m.id_manufacturer
WHERE mf.name='Grandstream' AND m.name='GXP1625';
SELECT '=== MATCHING ENDPOINTS ===';
SELECT COUNT(*) AS total
FROM endpoint e
WHERE UPPER(REPLACE(e.mac_address,'-',':')) LIKE 'C0:74:AD:%';
ROLLBACK;
SQL
  rm -f "$defaults_file"
  trap - RETURN EXIT
  echo 'GRANDSTREAM-OUI-INSPECT-PASS'
}

apply_prefix() {
  local defaults_file manufacturer_count prefix_count prefix_other
  defaults_file="$(make_db_defaults_file)"
  trap 'rm -f "$defaults_file"' RETURN EXIT
  manufacturer_count="$(mysql_scalar "$defaults_file" "SELECT COUNT(*) FROM manufacturer WHERE name='Grandstream';")"
  [ "$manufacturer_count" -eq 1 ] || { echo "ERROR: se esperaba exactamente un fabricante Grandstream; encontrados=$manufacturer_count" >&2; exit 1; }
  prefix_other="$(mysql_scalar "$defaults_file" "SELECT COUNT(*) FROM mac_prefix mp LEFT JOIN manufacturer mf ON mf.id=mp.id_manufacturer WHERE UPPER(mp.mac_prefix)='C0:74:AD' AND COALESCE(mf.name,'') <> 'Grandstream';")"
  [ "$prefix_other" -eq 0 ] || { echo 'ERROR: C0:74:AD ya pertenece a otro fabricante; no se modifica la DB.' >&2; exit 1; }
  prefix_count="$(mysql_scalar "$defaults_file" "SELECT COUNT(*) FROM mac_prefix mp JOIN manufacturer mf ON mf.id=mp.id_manufacturer WHERE mf.name='Grandstream' AND UPPER(mp.mac_prefix)='C0:74:AD';")"
  install -d -o root -g root -m 0700 "$STATE_DIR"
  if [ "$prefix_count" -eq 1 ]; then
    printf 'inserted_by_helper=0\n' > "$STATE_FILE"
    chmod 0600 "$STATE_FILE"
    echo 'GRANDSTREAM-OUI-ALREADY-PRESENT'
  elif [ "$prefix_count" -eq 0 ]; then
    mysql --defaults-extra-file="$defaults_file" endpointconfig <<'SQL'
START TRANSACTION;
SET @grandstream_id := (SELECT id FROM manufacturer WHERE name='Grandstream' LIMIT 1);
INSERT INTO mac_prefix (id_manufacturer, mac_prefix, description)
SELECT @grandstream_id, 'C0:74:AD', 'Grandstream C0:74:AD'
FROM DUAL
WHERE NOT EXISTS (SELECT 1 FROM mac_prefix WHERE UPPER(mac_prefix)='C0:74:AD');
COMMIT;
SQL
    printf 'inserted_by_helper=1\n' > "$STATE_FILE"
    chmod 0600 "$STATE_FILE"
    echo 'GRANDSTREAM-OUI-APPLY-PASS'
  else
    echo "ERROR: prefijo Grandstream duplicado; encontrados=$prefix_count" >&2
    exit 1
  fi
  rm -f "$defaults_file"
  trap - RETURN EXIT
}

rollback_prefix() {
  local defaults_file matching_endpoints inserted_by_helper=0
  [ -f "$STATE_FILE" ] || { echo 'ERROR: no existe estado controlado para rollback.' >&2; exit 1; }
  # shellcheck disable=SC1090
  . "$STATE_FILE"
  [ "${inserted_by_helper:-0}" = '1' ] || { echo 'ERROR: el helper no creó este prefijo; rollback cancelado.' >&2; exit 1; }
  defaults_file="$(make_db_defaults_file)"
  trap 'rm -f "$defaults_file"' RETURN EXIT
  matching_endpoints="$(mysql_scalar "$defaults_file" "SELECT COUNT(*) FROM endpoint WHERE UPPER(REPLACE(mac_address,'-',':')) LIKE 'C0:74:AD:%';")"
  [ "$matching_endpoints" -eq 0 ] || { echo "ERROR: existen endpoints C0:74:AD en Endpoint Configurator; rollback cancelado. total=$matching_endpoints" >&2; exit 1; }
  mysql --defaults-extra-file="$defaults_file" endpointconfig <<'SQL'
START TRANSACTION;
DELETE mp FROM mac_prefix mp
JOIN manufacturer mf ON mf.id=mp.id_manufacturer
WHERE mf.name='Grandstream' AND UPPER(mp.mac_prefix)='C0:74:AD';
COMMIT;
SQL
  rm -f "$STATE_FILE" "$defaults_file"
  trap - RETURN EXIT
  echo 'GRANDSTREAM-OUI-ROLLBACK-PASS'
}

inspect_login_patch() {
  [ -f "$GRANDSTREAM_PY" ] || { echo "ERROR: no existe $GRANDSTREAM_PY" >&2; exit 1; }
  local old_count new_count file_sha
  old_count="$(grep -Fxc "            payload = urlencode({'password': self._http_password})" "$GRANDSTREAM_PY" || true)"
  new_count="$(grep -Fxc "                'username': self._http_username," "$GRANDSTREAM_PY" || true)"
  file_sha="$(sha256sum "$GRANDSTREAM_PY" | awk '{print $1}')"
  echo '=== GRANDSTREAM GXP140x LOGIN PATCH AUDIT ==='
  echo "grandstream_py_sha256=$file_sha"
  echo "legacy_password_only_line_count=$old_count"
  echo "username_payload_line_count=$new_count"
  if [ -f "$LOGIN_PATCH_BACKUP" ]; then
    echo "backup_present=YES"
    echo "backup_sha256=$(sha256sum "$LOGIN_PATCH_BACKUP" | awk '{print $1}')"
  else
    echo 'backup_present=NO'
  fi
  if [ "$old_count" -eq 1 ] && [ "$new_count" -eq 0 ]; then
    echo 'login_patch_state=UNPATCHED'
  elif [ "$old_count" -eq 0 ] && [ "$new_count" -eq 1 ]; then
    echo 'login_patch_state=PATCHED'
  else
    echo 'login_patch_state=UNEXPECTED'
    exit 1
  fi
  echo 'GRANDSTREAM-LOGIN-PATCH-INSPECT-PASS'
}

apply_login_patch() {
  [ -f "$GRANDSTREAM_PY" ] || { echo "ERROR: no existe $GRANDSTREAM_PY" >&2; exit 1; }
  install -d -o root -g root -m 0700 "$STATE_DIR"
  local old_count new_count before_sha after_sha tmp
  old_count="$(grep -Fxc "            payload = urlencode({'password': self._http_password})" "$GRANDSTREAM_PY" || true)"
  new_count="$(grep -Fxc "                'username': self._http_username," "$GRANDSTREAM_PY" || true)"
  if [ "$old_count" -eq 0 ] && [ "$new_count" -eq 1 ]; then
    echo 'GRANDSTREAM-LOGIN-PATCH-ALREADY-PRESENT'
    return 0
  fi
  [ "$old_count" -eq 1 ] && [ "$new_count" -eq 0 ] || { echo 'ERROR: Grandstream.py no coincide con el baseline esperado; apply cancelado.' >&2; exit 1; }
  [ ! -e "$LOGIN_PATCH_BACKUP" ] || { echo "ERROR: ya existe backup pendiente: $LOGIN_PATCH_BACKUP" >&2; exit 1; }
  before_sha="$(sha256sum "$GRANDSTREAM_PY" | awk '{print $1}')"
  cp -a "$GRANDSTREAM_PY" "$LOGIN_PATCH_BACKUP"
  chmod 0600 "$LOGIN_PATCH_BACKUP"
  tmp="$(mktemp "$STATE_DIR/Grandstream.py.XXXXXX")"
  python3 - "$GRANDSTREAM_PY" "$tmp" <<'PY'
import sys
src, dst = sys.argv[1], sys.argv[2]
text = open(src, 'r', encoding='utf-8').read()
old = "            payload = urlencode({'password': self._http_password})"
new = """            # GXP16xx firmware requires both HTTP credential fields.\n            payload = urlencode({\n                'username': self._http_username,\n                'password': self._http_password,\n            })"""
if text.count(old) != 1:
    raise SystemExit('expected exactly one legacy password-only payload line')
text = text.replace(old, new, 1)
open(dst, 'w', encoding='utf-8').write(text)
PY
  python3 -m py_compile "$tmp"
  install -o root -g root -m 0644 "$tmp" "$GRANDSTREAM_PY"
  rm -f "$tmp" "${GRANDSTREAM_PY}c" 2>/dev/null || true
  after_sha="$(sha256sum "$GRANDSTREAM_PY" | awk '{print $1}')"
  [ "$before_sha" != "$after_sha" ] || { echo 'ERROR: el SHA no cambió después del apply.' >&2; exit 1; }
  grep -Fq "                'username': self._http_username," "$GRANDSTREAM_PY"
  echo "before_sha256=$before_sha"
  echo "after_sha256=$after_sha"
  echo 'GRANDSTREAM-LOGIN-PATCH-APPLY-PASS'
}

rollback_login_patch() {
  [ -f "$LOGIN_PATCH_BACKUP" ] || { echo 'ERROR: no existe backup controlado del patch.' >&2; exit 1; }
  [ -f "$GRANDSTREAM_PY" ] || { echo "ERROR: no existe $GRANDSTREAM_PY" >&2; exit 1; }
  local current_new_count restored_sha
  current_new_count="$(grep -Fxc "                'username': self._http_username," "$GRANDSTREAM_PY" || true)"
  [ "$current_new_count" -eq 1 ] || { echo 'ERROR: el archivo live no contiene el patch esperado; rollback cancelado.' >&2; exit 1; }
  python3 -m py_compile "$LOGIN_PATCH_BACKUP"
  install -o root -g root -m 0644 "$LOGIN_PATCH_BACKUP" "$GRANDSTREAM_PY"
  rm -f "$LOGIN_PATCH_BACKUP" "${GRANDSTREAM_PY}c" 2>/dev/null || true
  grep -Fq "            payload = urlencode({'password': self._http_password})" "$GRANDSTREAM_PY"
  restored_sha="$(sha256sum "$GRANDSTREAM_PY" | awk '{print $1}')"
  echo "restored_sha256=$restored_sha"
  echo 'GRANDSTREAM-LOGIN-PATCH-ROLLBACK-PASS'
}

case "$ACTION" in
  inspect) inspect_prefix ;;
  apply) apply_prefix ;;
  rollback) rollback_prefix ;;
  inspect-login-patch) inspect_login_patch ;;
  apply-login-patch) apply_login_patch ;;
  rollback-login-patch) rollback_login_patch ;;
  *) usage ;;
esac
