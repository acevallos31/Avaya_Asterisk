#!/usr/bin/env bash
set -euo pipefail
umask 077

EXPECTED_HOST='toc-pbx01'
EXPECTED_CALLER='github-runner-tocoa'
TOKEN='APPLY-CEIBA-GOLDEN-TO-TOCOA'
BACKUP_ROOT='/var/backups/endpoint-configurator'
BUNDLE='/opt/actions-runner-tocoa/actions-runner/_work/Avaya_Asterisk/Avaya_Asterisk/_ceiba_golden_bundle'

log(){ printf '[TOCOA-CEIBA-GOLDEN] %s\n' "$*"; }
fail(){ printf '[TOCOA-CEIBA-GOLDEN] ERROR: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || fail 'must run as root'
[ "$(hostname -s)" = "$EXPECTED_HOST" ] || fail "unexpected host $(hostname -s)"
if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "$EXPECTED_CALLER" ] && [ "$SUDO_USER" != 'root' ]; then
  fail "unexpected sudo caller $SUDO_USER"
fi

ACTION="${1:-}"
CONFIRM="${2:-}"
[ "$ACTION" = 'apply' ] || fail 'usage: tocoa-ceiba-golden-sync apply APPLY-CEIBA-GOLDEN-TO-TOCOA'
[ "$CONFIRM" = "$TOKEN" ] || fail 'confirmation token mismatch'
[ -d "$BUNDLE" ] || fail "bundle not found: $BUNDLE"

for f in runtime.tar.gz runtime.manifest runtime.filelist catalog.sql catalog.sha256 meta.env; do
  [ -r "$BUNDLE/$f" ] || fail "bundle file missing: $f"
done

grep -Fxq 'source_host=cei-pbx02' "$BUNDLE/meta.env" || fail 'bundle source is not cei-pbx02'
(
  cd "$BUNDLE"
  sha256sum -c catalog.sha256
) >/dev/null || fail 'catalog checksum failed'

# DML-only contract: no DDL, no GRANT, no private endpoint rows.
if grep -Eiq '(^|[[:space:]])(CREATE|ALTER|DROP|TRUNCATE|GRANT|REVOKE|LOCK|UNLOCK)[[:space:]]' "$BUNDLE/catalog.sql"; then
  fail 'catalog payload contains forbidden DDL/privileged SQL'
fi
if grep -Eq 'INSERT INTO .?endpoint.? |INSERT INTO .?endpoint_account.?' "$BUNDLE/catalog.sql"; then
  fail 'catalog payload contains private endpoint state'
fi
grep -q '^INSERT INTO ' "$BUNDLE/catalog.sql" || fail 'catalog payload has no INSERT rows'

AMP='/etc/amportal.conf'
[ -r "$AMP" ] || fail '/etc/amportal.conf unreadable'

read_amp(){ sed -n "s/^$1=//p" "$AMP" | head -n1; }
escape_cnf(){ printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
sql_quote(){ printf '%s' "$1" | sed "s/'/''/g"; }

DBUSER="$(read_amp AMPDBUSER)"
DBPASS="$(read_amp AMPDBPASS)"
DBHOST="$(read_amp AMPDBHOST)"
[ -n "$DBHOST" ] || DBHOST='localhost'
[ -n "$DBUSER" ] || fail 'AMPDBUSER empty'

DBCNF="$(mktemp /tmp/tocoa-ceiba-golden-db.XXXXXX.cnf)"
APPLY_SQL=''
RESTORE_SQL=''
POST_DUMP=''
cleanup(){ rm -f "$DBCNF" "${APPLY_SQL:-}" "${RESTORE_SQL:-}" "${POST_DUMP:-}"; }
trap cleanup EXIT
{
  echo '[client]'
  printf 'user="%s"\n' "$(escape_cnf "$DBUSER")"
  printf 'password="%s"\n' "$(escape_cnf "$DBPASS")"
  printf 'host="%s"\n' "$(escape_cnf "$DBHOST")"
} > "$DBCNF"
unset DBPASS

mysql_q(){
  mysql --defaults-extra-file="$DBCNF" --batch --raw --skip-column-names endpointconfig -e "$1"
}

dump_catalog_dml(){
  mysqldump --defaults-extra-file="$DBCNF"     --no-create-info --complete-insert --skip-comments --skip-add-locks --skip-lock-tables     endpointconfig manufacturer mac_prefix model model_properties |
    awk '/^INSERT INTO / { print }'
}

STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
BACKUP="$BACKUP_ROOT/ceiba-golden-$STAMP"
mkdir -p "$BACKUP"
chmod 700 "$BACKUP"
log "backup=$BACKUP"

# Backup only what this sync can change, using statements asteriskuser can restore.
dump_catalog_dml > "$BACKUP/catalog-before.sql"
chmod 600 "$BACKUP/catalog-before.sql"

mysql_q "
SELECT e.id,e.id_manufacturer,COALESCE(e.id_model,'NULL'),mf.name,COALESCE(m.name,'')
FROM endpoint e
JOIN manufacturer mf ON mf.id=e.id_manufacturer
LEFT JOIN model m ON m.id=e.id_model
ORDER BY e.id;
" > "$BACKUP/endpoint-map-before.tsv"
chmod 600 "$BACKUP/endpoint-map-before.tsv"

backup_paths=(
  usr/share/issabel/endpoint-classes
  usr/share/issabel/privileged/detect_endpoints
  usr/bin/issabel-endpointconfig
  var/www/html/modules/endpoint_configurator
)
[ -e /etc/httpd/conf.d/avaya-j129-provisioning.conf ] && backup_paths+=(etc/httpd/conf.d/avaya-j129-provisioning.conf)
[ -e /usr/local/libexec/issabel-endpoint-credential-vault ] && backup_paths+=(usr/local/libexec/issabel-endpoint-credential-vault)

tar -C / -czf "$BACKUP/runtime-before.tar.gz" "${backup_paths[@]}"
chmod 600 "$BACKUP/runtime-before.tar.gz"

restore_catalog_and_endpoint_ids(){
  RESTORE_SQL="$(mktemp /tmp/tocoa-ceiba-golden-restore.XXXXXX.sql)"
  {
    echo 'SET FOREIGN_KEY_CHECKS=0;'
    echo 'DELETE FROM model_properties;'
    echo 'DELETE FROM mac_prefix;'
    echo 'DELETE FROM model;'
    echo 'DELETE FROM manufacturer;'
    cat "$BACKUP/catalog-before.sql"
    while IFS=$'\t' read -r id mfid modelid mfname modelname; do
      [ -n "$id" ] || continue
      if [ "$modelid" = 'NULL' ] || [ -z "$modelid" ]; then
        printf 'UPDATE endpoint SET id_manufacturer=%s,id_model=NULL WHERE id=%s;\n' "$mfid" "$id"
      else
        printf 'UPDATE endpoint SET id_manufacturer=%s,id_model=%s WHERE id=%s;\n' "$mfid" "$modelid" "$id"
      fi
    done < "$BACKUP/endpoint-map-before.tsv"
    echo 'SET FOREIGN_KEY_CHECKS=1;'
  } > "$RESTORE_SQL"
  mysql --defaults-extra-file="$DBCNF" endpointconfig < "$RESTORE_SQL"
}

rollback(){
  rc=$?
  trap - ERR
  if [ "$rc" -ne 0 ]; then
    log 'failure detected; restoring Tocoa backup'
    set +e
    rm -rf /usr/share/issabel/endpoint-classes /var/www/html/modules/endpoint_configurator
    tar -C / -xzf "$BACKUP/runtime-before.tar.gz"
    restore_catalog_and_endpoint_ids
    set -e
    log 'AUTO-ROLLBACK-COMPLETE'
  fi
  exit "$rc"
}
trap rollback ERR

# Preserve endpoint identities using natural manufacturer/model keys before replacing catalog.
mysql_q "
SELECT e.id,mf.name,COALESCE(m.name,'')
FROM endpoint e
JOIN manufacturer mf ON mf.id=e.id_manufacturer
LEFT JOIN model m ON m.id=e.id_model
ORDER BY e.id;
" > "$BACKUP/endpoint-natural-map.tsv"
chmod 600 "$BACKUP/endpoint-natural-map.tsv"

# Replace only portable catalog tables with DML permitted to asteriskuser.
APPLY_SQL="$(mktemp /tmp/tocoa-ceiba-golden-apply.XXXXXX.sql)"
{
  echo 'SET FOREIGN_KEY_CHECKS=0;'
  echo 'DELETE FROM model_properties;'
  echo 'DELETE FROM mac_prefix;'
  echo 'DELETE FROM model;'
  echo 'DELETE FROM manufacturer;'
  cat "$BUNDLE/catalog.sql"
  echo 'SET FOREIGN_KEY_CHECKS=1;'
} > "$APPLY_SQL"
mysql --defaults-extra-file="$DBCNF" endpointconfig < "$APPLY_SQL"
log 'CATALOG-DML-IMPORT-PASS'

# Remap Tocoa endpoints to the imported Ceiba catalog by natural key.
while IFS=$'\t' read -r id mfname modelname; do
  [ -n "$id" ] || continue
  mfq="$(sql_quote "$mfname")"
  new_mf="$(mysql_q "SELECT id FROM manufacturer WHERE name='$mfq' LIMIT 1;")"
  [ -n "$new_mf" ] || fail "manufacturer missing after import endpoint=$id manufacturer=$mfname"

  if [ -n "$modelname" ]; then
    modelq="$(sql_quote "$modelname")"
    new_model="$(mysql_q "SELECT id FROM model WHERE id_manufacturer=$new_mf AND name='$modelq' LIMIT 1;")"
    if [ -n "$new_model" ]; then
      mysql_q "UPDATE endpoint SET id_manufacturer=$new_mf,id_model=$new_model WHERE id=$id;"
    else
      mysql_q "UPDATE endpoint SET id_manufacturer=$new_mf,id_model=NULL WHERE id=$id;"
    fi
  else
    mysql_q "UPDATE endpoint SET id_manufacturer=$new_mf,id_model=NULL WHERE id=$id;"
  fi
done < "$BACKUP/endpoint-natural-map.tsv"
log 'ENDPOINT-NATURAL-KEY-REMAP-PASS'

# Replace actual Endpoint Configurator runtime with the live Ceiba payload.
rm -rf /usr/share/issabel/endpoint-classes
rm -rf /var/www/html/modules/endpoint_configurator
tar -C / -xzf "$BUNDLE/runtime.tar.gz"

if command -v restorecon >/dev/null 2>&1; then
  restorecon -RF /usr/share/issabel/endpoint-classes     /usr/share/issabel/privileged/detect_endpoints     /usr/bin/issabel-endpointconfig     /var/www/html/modules/endpoint_configurator >/dev/null 2>&1 || true
  [ -e /etc/httpd/conf.d/avaya-j129-provisioning.conf ] && restorecon -F /etc/httpd/conf.d/avaya-j129-provisioning.conf >/dev/null 2>&1 || true
  [ -e /usr/local/libexec/issabel-endpoint-credential-vault ] && restorecon -F /usr/local/libexec/issabel-endpoint-credential-vault >/dev/null 2>&1 || true
fi

sha256sum -c "$BUNDLE/runtime.manifest" >/dev/null
log 'CEIBA-RUNTIME-SHA-PARITY-PASS'

POST_DUMP="$(mktemp /tmp/tocoa-ceiba-golden-catalog.XXXXXX.sql)"
dump_catalog_dml > "$POST_DUMP"
EXPECTED_CATALOG_SHA="$(awk '{print $1}' "$BUNDLE/catalog.sha256")"
ACTUAL_CATALOG_SHA="$(sha256sum "$POST_DUMP" | awk '{print $1}')"
[ "$EXPECTED_CATALOG_SHA" = "$ACTUAL_CATALOG_SHA" ] ||   fail "catalog parity mismatch expected=$EXPECTED_CATALOG_SHA actual=$ACTUAL_CATALOG_SHA"
log 'CEIBA-CATALOG-SHA-PARITY-PASS'

PYTHONDONTWRITEBYTECODE=1 python3 -m py_compile   /usr/share/issabel/endpoint-classes/class/issabel/vendor/Grandstream.py   /usr/share/issabel/endpoint-classes/class/issabel/vendor/Avaya.py   /usr/share/issabel/privileged/detect_endpoints   /usr/bin/issabel-endpointconfig
php -l /var/www/html/modules/endpoint_configurator/index.php >/dev/null
php -l /var/www/html/modules/endpoint_configurator/libs/paloSantoEndpoints.class.php >/dev/null
httpd -t

log 'phone_write=NO'
log 'endpoint_discovery=NO'
log 'service_restart=NO'
log 'TOCOA-CEIBA-GOLDEN-SYNC=PASS'
trap - ERR
