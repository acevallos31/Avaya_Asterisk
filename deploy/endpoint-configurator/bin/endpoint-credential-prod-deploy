#!/usr/bin/env bash
set -euo pipefail
umask 077

RUNNER_USER='github-runner-prod'
EXPECTED_HOST='cei-pbx02'
EXPECTED_ROOT='/opt/actions-runner-prod/_work/Avaya_Asterisk/Avaya_Asterisk/_test71_candidate'
MODULE='/var/www/html/modules/endpoint_configurator'
CLI_DST='/usr/local/libexec/issabel-endpoint-credential-vault'
KEY_DST='/etc/issabel/endpoint-configurator.key'
STATE_DIR='/var/lib/issabel-endpoint-credential-prod/v1'
BACKUP_DIR="$STATE_DIR/backup"
MANIFEST="$STATE_DIR/runtime.manifest"
INSTALLED_STATE="$STATE_DIR/installed.version"
AMPORTAL_CONF='/etc/amportal.conf'

# Immutable candidate payload blobs. The helper accepts only these exact files.
BLOB_SCHEMA='1baea01a00773a2338e7b4dad6b225d5114640f9'
BLOB_KEY_INSTALLER='cfad4180c0e18981f27e071d6a98a3c62ac71378'
BLOB_VAULT='0d52162f421f5f2a27e9c346d7a0d45da437cc4c'
BLOB_CLI='92ff55f14bf456c04a740651832c10e063e6006d'
BLOB_INDEX='bc0c499f3cb55cfe9326635d4f9e57aca1233141'
BLOB_SUMMARY='af5f4493c3682ab23596f784771f2d9c7f6e9287'
BLOB_SUMMARY_LANG='cc586e43431358e721a836282a6779188adfe596'
BLOB_TEMPLATE='9f88f4794d91a694ce660e05a2f5dfd9bab90aec'
BLOB_JS='5a673de0cafdc54cb8e6d872684d09a2ccb04578'

# Reviewed Ceiba pre-install baselines from Test 70 run 35123613203.
BASELINE_INDEX='60bb6aaa461e72979cfd40551b9ef78e81c75656'
BASELINE_TEMPLATE='d979762079d4dcc2874759881104b3287fea71c2'
BASELINE_JS='44bea8adac8bd15d9b8548922d032fcf924edfc1'

fail(){ printf 'TEST71-FAIL: %s\n' "$*" >&2; exit 1; }
mark(){ printf '%s\n' "$*"; }
need_root(){ [ "${EUID}" -eq 0 ] || fail 'helper must run as root'; }
verify_caller(){
  [ "${SUDO_USER:-}" = "$RUNNER_USER" ] || fail 'unauthorized caller'
  [ "$(hostname -s)" = "$EXPECTED_HOST" ] || fail 'unexpected host'
}

git_blob_sha(){
  python3 - "$1" <<'PY'
import hashlib
import pathlib
import sys
p = pathlib.Path(sys.argv[1])
data = p.read_bytes()
print(hashlib.sha1(b"blob " + str(len(data)).encode("ascii") + b"\0" + data).hexdigest())
PY
}

require_blob(){
  local path="$1" expected="$2" actual
  [ -f "$path" ] || fail "candidate file missing: ${path#$EXPECTED_ROOT/}"
  [ ! -L "$path" ] || fail "candidate symlink rejected: ${path#$EXPECTED_ROOT/}"
  [ "$(stat -c '%U' "$path")" = "$RUNNER_USER" ] || fail "unexpected candidate owner: ${path#$EXPECTED_ROOT/}"
  actual="$(git_blob_sha "$path")"
  [ "$actual" = "$expected" ] || fail "candidate blob mismatch: ${path#$EXPECTED_ROOT/}"
}

verify_payload(){
  local root="${1:-}"
  [ "$root" = "$EXPECTED_ROOT" ] || fail 'unexpected candidate root'
  command -v python3 >/dev/null 2>&1 || fail 'python3 missing'
  command -v php >/dev/null 2>&1 || fail 'php missing'
  command -v mysql >/dev/null 2>&1 || fail 'mysql client missing'
  command -v apachectl >/dev/null 2>&1 || fail 'apachectl missing'
  command -v curl >/dev/null 2>&1 || fail 'curl missing'
  command -v openssl >/dev/null 2>&1 || fail 'openssl missing'

  require_blob "$root/deploy/endpoint-configurator/db/001_admin_credentials.sql" "$BLOB_SCHEMA"
  require_blob "$root/deploy/endpoint-configurator/bin/install-key.sh" "$BLOB_KEY_INSTALLER"
  require_blob "$root/deploy/endpoint-configurator/libs/EndpointCredentialVault.class.php" "$BLOB_VAULT"
  require_blob "$root/deploy/endpoint-configurator/bin/credential-vault-cli.php" "$BLOB_CLI"
  require_blob "$root/var/www/html/modules/endpoint_configurator/index.php" "$BLOB_INDEX"
  require_blob "$root/var/www/html/modules/endpoint_configurator/dialogs/summary/index.php" "$BLOB_SUMMARY"
  require_blob "$root/var/www/html/modules/endpoint_configurator/dialogs/summary/lang/en.lang" "$BLOB_SUMMARY_LANG"
  require_blob "$root/var/www/html/modules/endpoint_configurator/themes/default/reporte_endpoints.tpl" "$BLOB_TEMPLATE"
  require_blob "$root/var/www/html/modules/endpoint_configurator/themes/default/js/javascript.js" "$BLOB_JS"

  php -l "$root/deploy/endpoint-configurator/libs/EndpointCredentialVault.class.php" >/dev/null
  php -l "$root/deploy/endpoint-configurator/bin/credential-vault-cli.php" >/dev/null
  php -l "$root/var/www/html/modules/endpoint_configurator/index.php" >/dev/null
  php -l "$root/var/www/html/modules/endpoint_configurator/dialogs/summary/index.php" >/dev/null
  bash -n "$root/deploy/endpoint-configurator/bin/install-key.sh"
  mark 'TEST71-PAYLOAD-INTEGRITY-PASS'
}

read_amp(){ sed -n "s/^$1=//p" "$AMPORTAL_CONF" | head -n1; }
escape_mysql(){ local v="$1"; v="${v//\\/\\\\}"; v="${v//\"/\\\"}"; printf '%s' "$v"; }
make_defaults(){
  local u p h f
  [ -r "$AMPORTAL_CONF" ] || fail 'amportal.conf unreadable'
  u="$(read_amp AMPDBUSER)"; p="$(read_amp AMPDBPASS)"; h="$(read_amp AMPDBHOST)"
  [ -n "$u" ] || fail 'AMPDBUSER missing'; [ -n "$p" ] || fail 'AMPDBPASS missing'; [ -n "$h" ] || h=localhost
  f="$(mktemp /tmp/test71-endpoint-db.XXXXXX.cnf)"; chmod 0600 "$f"
  { echo '[client]'; printf 'user="%s"\n' "$(escape_mysql "$u")"; printf 'password="%s"\n' "$(escape_mysql "$p")"; printf 'host="%s"\n' "$(escape_mysql "$h")"; } > "$f"
  printf '%s' "$f"
}
scalar(){ mysql --defaults-extra-file="$1" --batch --skip-column-names endpointconfig -e "$2"; }

schema_count(){
  local df="$1"
  scalar "$df" "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='endpointconfig' AND table_name IN ('pbx_admin_password_policy','endpoint_admin_credential','endpoint_credential_event');"
}

verify_schema(){
  local df="$1" count cols
  count="$(schema_count "$df")"
  [ "$count" = 3 ] || fail "credential schema table count=$count"
  cols="$(scalar "$df" "SELECT COUNT(*) FROM information_schema.columns WHERE table_schema='endpointconfig' AND ((table_name='pbx_admin_password_policy' AND column_name IN ('id','pbx_identity','active_version','pending_version','ciphertext','key_reference','status','created_at','rotated_at')) OR (table_name='endpoint_admin_credential' AND column_name IN ('id_endpoint','source','ciphertext','key_reference','version','validation_status','last_validated_at','rotation_status','updated_at')) OR (table_name='endpoint_credential_event' AND column_name IN ('id','id_endpoint','operation','result','actor','correlation_id','created_at')));" )"
  [ "$cols" = 25 ] || fail "credential schema column contract mismatch: $cols"
  mark 'TEST71-SCHEMA-VERIFY-PASS'
}

live_blob_is(){ [ -f "$1" ] && [ "$(git_blob_sha "$1")" = "$2" ]; }

runtime_matches_candidate(){
  local root="$1"
  [ -f "$INSTALLED_STATE" ] || return 1
  cmp -s "$root/deploy/endpoint-configurator/libs/EndpointCredentialVault.class.php" "$MODULE/libs/EndpointCredentialVault.class.php" || return 1
  cmp -s "$root/deploy/endpoint-configurator/bin/credential-vault-cli.php" "$CLI_DST" || return 1
  cmp -s "$root/var/www/html/modules/endpoint_configurator/index.php" "$MODULE/index.php" || return 1
  cmp -s "$root/var/www/html/modules/endpoint_configurator/dialogs/summary/index.php" "$MODULE/dialogs/summary/index.php" || return 1
  cmp -s "$root/var/www/html/modules/endpoint_configurator/dialogs/summary/lang/en.lang" "$MODULE/dialogs/summary/lang/en.lang" || return 1
  cmp -s "$root/var/www/html/modules/endpoint_configurator/themes/default/reporte_endpoints.tpl" "$MODULE/themes/default/reporte_endpoints.tpl" || return 1
  cmp -s "$root/var/www/html/modules/endpoint_configurator/themes/default/js/javascript.js" "$MODULE/themes/default/js/javascript.js" || return 1
}

verify_preinstall_baseline(){
  live_blob_is "$MODULE/index.php" "$BASELINE_INDEX" || fail 'pre-install index.php drift'
  live_blob_is "$MODULE/themes/default/reporte_endpoints.tpl" "$BASELINE_TEMPLATE" || fail 'pre-install template drift'
  live_blob_is "$MODULE/themes/default/js/javascript.js" "$BASELINE_JS" || fail 'pre-install javascript drift'
  [ ! -e "$MODULE/libs/EndpointCredentialVault.class.php" ] || fail 'unexpected pre-existing vault runtime without install state'
  [ ! -e "$MODULE/dialogs/summary/index.php" ] || fail 'unexpected pre-existing summary runtime without install state'
  [ ! -e "$MODULE/dialogs/summary/lang/en.lang" ] || fail 'unexpected pre-existing summary language without install state'
  [ ! -e "$CLI_DST" ] || fail 'unexpected pre-existing credential CLI without install state'
  mark 'TEST71-PREINSTALL-BASELINE-PASS'
}

web_health(){
  local code
  apachectl -t >/dev/null
  code="$(curl -k -sS -o /dev/null -w '%{http_code}' --connect-timeout 3 --max-time 8 https://127.0.0.1/ || true)"
  [ "$code" != 000 ] && [ "$code" -ge 200 ] 2>/dev/null && [ "$code" -lt 500 ] 2>/dev/null || fail "local HTTPS unhealthy: ${code:-000}"
  mark "TEST71-WEB-HEALTH-PASS status=$code"
}

preflight(){
  local root="$1" df tables
  verify_payload "$root"
  [ "$(stat -c '%U:%G:%a' "$0")" = 'root:root:755' ] || fail 'helper ownership/mode mismatch'
  web_health
  df="$(make_defaults)"; trap 'rm -f "$df"' RETURN
  tables="$(schema_count "$df")"
  [ "$tables" = 0 ] || [ "$tables" = 3 ] || fail "partial credential schema detected: $tables/3"
  if [ "$tables" = 3 ]; then verify_schema "$df"; else mark 'TEST71-SCHEMA-STATE=ABSENT'; fi
  rm -f "$df"; trap - RETURN

  if [ -e "$KEY_DST" ]; then
    [ -f "$KEY_DST" ] || fail 'credential key path is not regular file'
    [ "$(stat -c '%U:%G:%a' "$KEY_DST")" = 'root:asterisk:640' ] || fail 'credential key ownership/mode mismatch'
    mark 'TEST71-KEY-STATE=PRESENT'
  else
    mark 'TEST71-KEY-STATE=ABSENT'
  fi

  if [ -f "$INSTALLED_STATE" ]; then
    runtime_matches_candidate "$root" || fail 'installed state exists but runtime differs from candidate'
    mark 'TEST71-RUNTIME-STATE=INSTALLED'
  else
    verify_preinstall_baseline
    mark 'TEST71-RUNTIME-STATE=ABSENT'
  fi
  mark 'phone_write=NO'
  mark 'TEST71-PREFLIGHT-PASS'
}

write_manifest_once(){
  local destination relative
  install -d -o root -g root -m 0700 "$STATE_DIR" "$BACKUP_DIR"
  [ ! -e "$MANIFEST" ] || return 0
  : > "$MANIFEST"; chmod 0600 "$MANIFEST"
  for destination in \
    "$MODULE/index.php" \
    "$MODULE/libs/EndpointCredentialVault.class.php" \
    "$MODULE/dialogs/summary/index.php" \
    "$MODULE/dialogs/summary/lang/en.lang" \
    "$MODULE/themes/default/reporte_endpoints.tpl" \
    "$MODULE/themes/default/js/javascript.js" \
    "$CLI_DST"; do
    relative="${destination#/}"
    if [ -e "$destination" ]; then
      install -d -o root -g root -m 0700 "$BACKUP_DIR/$(dirname "$relative")"
      cp -a "$destination" "$BACKUP_DIR/$relative"
      printf 'PRESENT %s\n' "$destination" >> "$MANIFEST"
    else
      printf 'ABSENT %s\n' "$destination" >> "$MANIFEST"
    fi
  done
  mark 'TEST71-BACKUP-MANIFEST-PASS'
}

rollback_runtime_internal(){
  local state destination relative
  [ -f "$MANIFEST" ] || return 0
  while read -r state destination; do
    case "$destination" in
      "$MODULE/index.php"|"$MODULE/libs/EndpointCredentialVault.class.php"|"$MODULE/dialogs/summary/index.php"|"$MODULE/dialogs/summary/lang/en.lang"|"$MODULE/themes/default/reporte_endpoints.tpl"|"$MODULE/themes/default/js/javascript.js"|"$CLI_DST") ;;
      *) fail 'invalid destination in runtime manifest' ;;
    esac
    relative="${destination#/}"
    case "$state" in
      PRESENT) [ -e "$BACKUP_DIR/$relative" ] || fail 'backup file missing'; cp -a "$BACKUP_DIR/$relative" "$destination" ;;
      ABSENT) rm -f "$destination" ;;
      *) fail 'invalid runtime manifest state' ;;
    esac
  done < "$MANIFEST"
  apachectl -t >/dev/null
  systemctl reload httpd
  rm -f "$INSTALLED_STATE"
  date -u +%Y-%m-%dT%H:%M:%SZ > "$STATE_DIR/last-runtime-rollback.utc"
  mark 'TEST71-RUNTIME-ROLLBACK-PASS'
}

verify_install(){
  local root="$1" df
  verify_payload "$root"
  [ -f "$KEY_DST" ] || fail 'credential key missing'
  [ "$(stat -c '%U:%G:%a' "$KEY_DST")" = 'root:asterisk:640' ] || fail 'credential key ownership/mode mismatch'
  runtime_matches_candidate "$root" || fail 'installed runtime does not match candidate'
  [ "$(stat -c '%U:%G:%a' "$MODULE/index.php")" = 'root:root:644' ] || fail 'index ownership/mode mismatch'
  [ "$(stat -c '%U:%G:%a' "$MODULE/libs/EndpointCredentialVault.class.php")" = 'root:root:644' ] || fail 'vault ownership/mode mismatch'
  [ "$(stat -c '%U:%G:%a' "$CLI_DST")" = 'root:asterisk:750' ] || fail 'CLI ownership/mode mismatch'
  php -l "$MODULE/index.php" >/dev/null
  php -l "$MODULE/dialogs/summary/index.php" >/dev/null
  php -l "$MODULE/libs/EndpointCredentialVault.class.php" >/dev/null
  php -l "$CLI_DST" >/dev/null
  df="$(make_defaults)"; trap 'rm -f "$df"' RETURN
  verify_schema "$df"
  rm -f "$df"; trap - RETURN
  web_health
  mark 'phone_write=NO'
  mark 'TEST71-PROD-ENDPOINT-CREDENTIAL-RUNTIME=PASS'
}

install_runtime(){
  local root="$1" confirmation="$2" df tables install_started=0
  [ "$confirmation" = 'INSTALL-ENDPOINT-CREDENTIALS-PROD' ] || fail 'install confirmation missing'
  preflight "$root"
  if [ -f "$INSTALLED_STATE" ]; then
    verify_install "$root"
    mark 'TEST71-INSTALL-IDEMPOTENT-PASS'
    return 0
  fi

  write_manifest_once
  df="$(make_defaults)"; trap 'rm -f "$df"' RETURN
  tables="$(schema_count "$df")"
  if [ "$tables" = 0 ]; then
    mysql --defaults-extra-file="$df" endpointconfig < "$root/deploy/endpoint-configurator/db/001_admin_credentials.sql"
    mark 'TEST71-SCHEMA-INSTALL-PASS'
  fi
  verify_schema "$df"
  rm -f "$df"; trap - RETURN

  if [ -e "$KEY_DST" ]; then
    [ "$(stat -c '%U:%G:%a' "$KEY_DST")" = 'root:asterisk:640' ] || fail 'existing key ownership/mode mismatch'
  fi
  "$root/deploy/endpoint-configurator/bin/install-key.sh" "$KEY_DST"
  [ "$(stat -c '%U:%G:%a' "$KEY_DST")" = 'root:asterisk:640' ] || fail 'key installation verification failed'
  mark 'TEST71-KEY-INSTALL-PASS'

  install_started=1
  trap 'rc=$?; if [ "$install_started" -eq 1 ]; then rollback_runtime_internal || true; fi; exit "$rc"' ERR
  install -d -o root -g root -m 0755 "$MODULE/libs" "$MODULE/dialogs/summary/lang" /usr/local/libexec
  install -o root -g root -m 0644 "$root/deploy/endpoint-configurator/libs/EndpointCredentialVault.class.php" "$MODULE/libs/EndpointCredentialVault.class.php"
  install -o root -g root -m 0644 "$root/var/www/html/modules/endpoint_configurator/index.php" "$MODULE/index.php"
  install -o root -g root -m 0644 "$root/var/www/html/modules/endpoint_configurator/dialogs/summary/index.php" "$MODULE/dialogs/summary/index.php"
  install -o root -g root -m 0644 "$root/var/www/html/modules/endpoint_configurator/dialogs/summary/lang/en.lang" "$MODULE/dialogs/summary/lang/en.lang"
  install -o root -g root -m 0644 "$root/var/www/html/modules/endpoint_configurator/themes/default/reporte_endpoints.tpl" "$MODULE/themes/default/reporte_endpoints.tpl"
  install -o root -g root -m 0644 "$root/var/www/html/modules/endpoint_configurator/themes/default/js/javascript.js" "$MODULE/themes/default/js/javascript.js"
  install -o root -g asterisk -m 0750 "$root/deploy/endpoint-configurator/bin/credential-vault-cli.php" "$CLI_DST"

  apachectl -t >/dev/null
  systemctl reload httpd
  printf 'candidate_root=%s\ninstalled_at=%s\n' "$root" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$INSTALLED_STATE"
  chmod 0600 "$INSTALLED_STATE"
  verify_install "$root"
  install_started=0
  trap - ERR
  mark 'TEST71-CONTROLLED-INSTALL-PASS'
}

rollback_runtime(){
  local confirmation="${1:-}"
  [ "$confirmation" = 'ROLLBACK-ENDPOINT-CREDENTIAL-RUNTIME-PROD' ] || fail 'rollback confirmation missing'
  rollback_runtime_internal
  web_health
  mark 'schema_rollback=NO'
  mark 'key_removal=NO'
  mark 'phone_write=NO'
}

main(){
  need_root
  verify_caller
  case "${1:-}" in
    preflight) [ "$#" -eq 2 ] || fail 'usage: preflight <candidate-root>'; preflight "$2" ;;
    install) [ "$#" -eq 3 ] || fail 'usage: install <candidate-root> INSTALL-ENDPOINT-CREDENTIALS-PROD'; install_runtime "$2" "$3" ;;
    verify) [ "$#" -eq 2 ] || fail 'usage: verify <candidate-root>'; verify_install "$2" ;;
    rollback-runtime) [ "$#" -eq 2 ] || fail 'usage: rollback-runtime ROLLBACK-ENDPOINT-CREDENTIAL-RUNTIME-PROD'; rollback_runtime "$2" ;;
    *) fail 'usage: {preflight <candidate-root>|install <candidate-root> INSTALL-ENDPOINT-CREDENTIALS-PROD|verify <candidate-root>|rollback-runtime ROLLBACK-ENDPOINT-CREDENTIAL-RUNTIME-PROD}' ;;
  esac
}

main "$@"
