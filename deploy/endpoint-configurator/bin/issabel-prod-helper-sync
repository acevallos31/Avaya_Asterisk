#!/usr/bin/env bash
set -euo pipefail
umask 077

RUNNER_USER='github-runner-prod'
EXPECTED_HOST='cei-pbx02'
CANDIDATE_ROOT='/opt/actions-runner-prod/_work/Avaya_Asterisk/Avaya_Asterisk/_prod_helper_candidate'
REMOTE_API_BASE='https://api.github.com/repos/acevallos31/Avaya_Asterisk/contents'

HELPER_REL='deploy/endpoint-configurator/bin/grandstream-prod-deploy'
PATCHER_REL='deploy/endpoint-configurator/bin/grandstream-vendor-patch.py'
AUTH_REL='deploy/endpoint-configurator/bin/grp26xx-prod-auth-read.py'
SQL_REL='deploy/endpoint-configurator/sql/grandstream-prod-catalog.sql'

HELPER_SRC="$CANDIDATE_ROOT/$HELPER_REL"
PATCHER_SRC="$CANDIDATE_ROOT/$PATCHER_REL"
AUTH_SRC="$CANDIDATE_ROOT/$AUTH_REL"
SQL_SRC="$CANDIDATE_ROOT/$SQL_REL"

HELPER_DST='/usr/local/sbin/issabel-grandstream-prod'
PATCHER_DST='/usr/local/libexec/issabel-grandstream-vendor-patch'
AUTH_DST='/usr/local/libexec/issabel-grp26xx-auth-read'
SQL_DST='/usr/local/share/issabel-grandstream-prod/catalog.sql'

fail(){ printf 'PROD-HELPER-SYNC-FAIL: %s\n' "$*" >&2; exit 1; }
mark(){ printf '%s\n' "$*"; }

need_root(){ [ "${EUID}" -eq 0 ] || fail 'must run as root'; }
verify_caller(){
  [ "${SUDO_USER:-}" = "$RUNNER_USER" ] || fail 'unauthorized caller'
  [ "$(hostname -s)" = "$EXPECTED_HOST" ] || fail 'unexpected host'
}

git_blob_sha(){
  python3 - "$1" <<'PY'
import hashlib
import pathlib
import sys
p = pathlib.Path(sys.argv[1])
data = p.read_bytes()
print(hashlib.sha1(b"blob " + str(len(data)).encode("ascii") + b"\0" + data).hexdigest())
PY
}

remote_blob_sha(){
  local rel="$1"
  curl -fsSL --proto '=https' --tlsv1.2 \
    -H 'Accept: application/vnd.github+json' \
    "$REMOTE_API_BASE/$rel?ref=main" |
    python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("sha",""))'
}

require_remote_main_file(){
  local path="$1" rel="$2" actual expected
  [ -f "$path" ] || fail "missing candidate file: $rel"
  [ ! -L "$path" ] || fail "candidate symlink rejected: $rel"
  [ "$(stat -c '%U' "$path")" = "$RUNNER_USER" ] || fail "unexpected candidate owner: $rel"
  actual="$(git_blob_sha "$path")"
  expected="$(remote_blob_sha "$rel")"
  [[ "$expected" =~ ^[0-9a-f]{40}$ ]] || fail "remote main blob unavailable: $rel"
  [ "$actual" = "$expected" ] || fail "candidate differs from GitHub main: $rel expected=$expected actual=$actual"
  mark "PROD-HELPER-SYNC-MAIN-BLOB $rel=$actual"
}

verify_payload(){
  require_remote_main_file "$HELPER_SRC" "$HELPER_REL"
  require_remote_main_file "$PATCHER_SRC" "$PATCHER_REL"
  require_remote_main_file "$AUTH_SRC" "$AUTH_REL"
  require_remote_main_file "$SQL_SRC" "$SQL_REL"

  bash -n "$HELPER_SRC"
  python3 - "$PATCHER_SRC" "$AUTH_SRC" <<'PY'
import ast
import pathlib
import sys
for name in sys.argv[1:]:
    ast.parse(pathlib.Path(name).read_text(encoding='utf-8'), filename=name)
PY

  grep -Fq "RUNNER_USER='github-runner-prod'" "$HELPER_SRC" || fail 'Grandstream helper runner guard missing'
  grep -Fq "EXPECTED_HOST='cei-pbx02'" "$HELPER_SRC" || fail 'Grandstream helper host guard missing'
  grep -Fq $'GXP1625\tC0:74:AD:E8:66:06\t10.3.40.29\t4450' "$HELPER_SRC" || fail 'GXP1625 production invariant missing'
  grep -Fq $'GRP2601P\tEC:74:D7:5D:2C:F5\t10.3.40.42\t4453' "$HELPER_SRC" || fail 'GRP2601P production invariant missing'
  grep -Fq $'GRP2602G\tEC:74:D7:65:FE:08\t10.3.40.43\t4452' "$HELPER_SRC" || fail 'GRP2602G production invariant missing'
  grep -Fq 'CEIBA-GRANDSTREAM-PROD-V1' "$PATCHER_SRC" || fail 'Grandstream vendor patch marker missing'
  grep -Fq "'GRP2601P','GRP2601P',2" "$SQL_SRC" || fail 'GRP2601P catalog contract missing'
  grep -Fq "'GRP2602G','GRP2602G',4" "$SQL_SRC" || fail 'GRP2602G catalog contract missing'

  if grep -Eiq '\b(DROP|TRUNCATE|GRANT|REVOKE|CREATE[[:space:]]+USER|ALTER[[:space:]]+USER)\b' "$SQL_SRC"; then
    fail 'forbidden SQL operation in production catalog payload'
  fi
  mark 'PROD-HELPER-SYNC-PAYLOAD-AUDIT-PASS'
}

prepare_helper_runtime(){
  local out="$1"
  python3 - "$HELPER_SRC" "$out" <<'PY'
import pathlib
import sys

src = pathlib.Path(sys.argv[1])
dst = pathlib.Path(sys.argv[2])
text = src.read_text(encoding='utf-8')

marker = 'TEST73-SIP-ADDR-PORT-NORMALIZATION'
old = """peer_addr(){ /usr/sbin/asterisk -rx "sip show peer $1" 2>/dev/null | sed -n -E 's/^[[:space:]]*Addr->IP[[:space:]]*:[[:space:]]*([^[:space:]]+).*/\\1/p' | head -n1; }"""
new = """peer_addr(){ # TEST73-SIP-ADDR-PORT-NORMALIZATION
  /usr/sbin/asterisk -rx "sip show peer $1" 2>/dev/null |
    sed -n -E 's/^[[:space:]]*Addr->IP[[:space:]]*:[[:space:]]*([^[:space:]]+).*/\\1/p' |
    head -n1 |
    sed -E 's/^(([0-9]{1,3}\\.){3}[0-9]{1,3}):[0-9]+$/\\1/'
}"""

if marker not in text:
    if old not in text:
        raise SystemExit('peer_addr compatibility target not found')
    text = text.replace(old, new, 1)

dst.write_text(text, encoding='utf-8')
PY
  bash -n "$out"
  grep -Fq 'TEST73-SIP-ADDR-PORT-NORMALIZATION' "$out" || fail 'SIP address normalization marker missing'
}

install_atomic(){
  local source="$1" destination="$2" mode="$3" tmp
  install -d -o root -g root -m 0755 "$(dirname "$destination")"
  tmp="$(mktemp "$(dirname "$destination")/.sync.$(basename "$destination").XXXXXX")"
  install -o root -g root -m "$mode" "$source" "$tmp"
  mv -f "$tmp" "$destination"
  [ "$(stat -c '%U:%G' "$destination")" = 'root:root' ] || fail "ownership verification failed: $destination"
}

sync_grandstream(){
  local helper_runtime
  verify_payload
  helper_runtime="$(mktemp /tmp/issabel-grandstream-prod.XXXXXX)"
  trap 'rm -f "$helper_runtime"' EXIT
  prepare_helper_runtime "$helper_runtime"

  install_atomic "$helper_runtime" "$HELPER_DST" 0755
  install_atomic "$PATCHER_SRC" "$PATCHER_DST" 0755
  install_atomic "$AUTH_SRC" "$AUTH_DST" 0755
  install_atomic "$SQL_SRC" "$SQL_DST" 0644

  bash -n "$HELPER_DST"
  python3 - "$PATCHER_DST" "$AUTH_DST" <<'PY'
import ast
import pathlib
import sys
for name in sys.argv[1:]:
    ast.parse(pathlib.Path(name).read_text(encoding='utf-8'), filename=name)
PY
  rm -f "$helper_runtime"
  trap - EXIT
  mark 'PROD-HELPER-SYNC-SIP-PORT-NORMALIZATION=PASS'
  mark 'production_runtime_write=HELPER_PAYLOAD_ONLY'
  mark 'endpointconfig_write=NO'
  mark 'phone_write=NO'
  mark 'PROD-HELPER-SYNC-GRANDSTREAM=PASS'
}

need_root
verify_caller
[ "$#" -eq 0 ] || fail 'this synchronizer accepts no arguments'
sync_grandstream
