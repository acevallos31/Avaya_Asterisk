case "${1:-}" in
  preflight) [ "$#" = 1 ] || fail 'preflight takes no args'; preflight ;;
  install) [ "$#" = 2 ] || fail 'install requires token'; install_all "$2" ;;
  verify) [ "$#" = 1 ] || fail 'verify takes no args'; verify_all ;;
  auth-read-grp2602g) [ "$#" = 1 ] || fail 'auth-read-grp2602g takes no args'; auth_read_grp2602g ;;
  configure-grp2602g) [ "$#" = 2 ] || fail 'configure-grp2602g requires token'; configure_grp2602g "$2" ;;
  rollback-runtime) [ "$#" = 2 ] || fail 'rollback requires token'; rollback_runtime "$2" ;;
  *) fail 'unsupported action' ;;
esac