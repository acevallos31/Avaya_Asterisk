rollback_runtime(){ require_token "$1"; [ -f "$BACKUP_DIR/Grandstream.py" ] || fail 'vendor backup missing'; install -o root -g root -m0644 "$BACKUP_DIR/Grandstream.py" "$GRANDSTREAM_PY"; python3 -B -m py_compile "$GRANDSTREAM_PY"; mark 'GRANDSTREAM-PROD-RUNTIME-ROLLBACK-PASS'; mark 'catalog_rollback=NO_ADDITIVE_ROWS_RETAINED'; mark 'phone_write=NO'; }

