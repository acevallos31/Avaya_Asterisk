                    ::= { endptSIP 242 }

endptSHAREDLINE9BARGEINENABLED  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Each shared line can be configured in the Broadsoft server to either enable or disable the 
                    ability of a user to barge into a call at a different location on the shared line.
                    The setting only applies to 3PCC server environments.
                    Not used for BLA.
                    '0' Barge in is disabled for the shared line
                    '1' Barge in is enabled for the shared line (default)"
                    ::= { endptSIP 243 }

endptSHAREDLINE10BARGEINENABLED  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Each shared line can be configured in the Broadsoft server to either enable or disable the 
                    ability of a user to barge into a call at a different location on the shared line.
                    The setting only applies to 3PCC server environments.
                    Not used for BLA.
                    '0' Barge in is disabled for the shared line
                    '1' Barge in is enabled for the shared line (default)"
                    ::= { endptSIP 244 }

endptSHAREDLINE9INCOMINGCALLINDICATIONDEFAULT  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies how a Shared Call Appearance Line should behave when receiving an incoming call.
                    This parameter is applicable for SCA, BLA and BCA.
                    This is administrator part of the setting.
                    Indication Value can be:
                    0 - None
                    1 - Audible
                    2 - Visual
                    3 - Both (Default)
                    4 - None Forced
                    5 - Audible Forced
                    6 - Visual Forced
                    7 - Both Forced
                    Values <= 3 allow user to modify the setting in the User Menu.
                    This setting does not apply to a primary line which is shared."
                    ::= { endptSIP 245 }

endptSHAREDLINE10INCOMINGCALLINDICATIONDEFAULT  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies how a Shared Call Appearance Line should behave when receiving an incoming call.
                    This parameter is applicable for SCA, BLA and BCA.
                    This is administrator part of the setting.
                    Indication Value can be:
                    0 - None
                    1 - Audible
                    2 - Visual
                    3 - Both (Default)
                    4 - None Forced
                    5 - Audible Forced
                    6 - Visual Forced
                    7 - Both Forced
                    Values <= 3 allow user to modify the setting in the User Menu.
                    This setting does not apply to a primary line which is shared."
                    ::= { endptSIP 246 }

endptSHAREDLINE9INCOMINGCALLINDICATIONDELAYEDDEFAULT  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies a value in seconds, used by the phone to delay the displaying of call popup
                    and playing of ringtone for an incoming call on a shared line which is not a primary line.
                    This parameter is applicable for SCA, BLA and BCA.
                    The parameter is only used when the corresponding Incoming Call Indication Mode is Audible or Visual or Both.
                    Indication Delay equal to 0 means no delay.
                    Users can override this value in the User Menu.
                    Range: 0-99
                    Default: 0"
                    ::= { endptSIP 247 }

endptSHAREDLINE10INCOMINGCALLINDICATIONDELAYEDDEFAULT  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies a value in seconds, used by the phone to delay the displaying of call popup
                    and playing of ringtone for an incoming call on a shared line which is not a primary line.
                    This parameter is applicable for SCA, BLA and BCA.
                    The parameter is only used when the corresponding Incoming Call Indication Mode is Audible or Visual or Both.
                    Indication Delay equal to 0 means no delay.
                    Users can override this value in the User Menu.
                    Range: 0-99
                    Default: 0"
                    ::= { endptSIP 248 }

endptSHAREDLINE9INCOMINGCALLINDICATION  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies how a Shared Call Appearance Line should behave when receiving an incoming call
                    This parameter is applicable for SCA, BLA and BCA.
                    This is user part of the setting.
                    Indication Value can be:
                    0 (Default) - Use value configured by the admin
                    1 - None
                    2 - Audible
                    3 - Visual
                    4 - Both
                    The value can be changes by the user if SCAn_INCOMING_CALL_INDICATION_DEFAULT <=3"
                    ::= { endptSIP 249 }

endptSHAREDLINE10INCOMINGCALLINDICATION  OBJECT-TYPE
                    SYNTAX      INTEGER
