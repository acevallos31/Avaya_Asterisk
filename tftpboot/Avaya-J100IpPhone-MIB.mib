                    The setting only applies to 3PCC server environments."
                    ::= { endptSIP 241 }

endptSHAREDLINE10EXTENSION  OBJECT-TYPE
                    SYNTAX      DisplayString (SIZE(0..255))
                    MAX-ACCESS  read-only
