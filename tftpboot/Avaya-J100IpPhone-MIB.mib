endptBEACONINDICATIONMODE OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies how a Beacon Led behaves at incoming call:
                    0 - Immediate, beacon led will flash immediately, when there is an incoming call and until call is answered.
                    1 - Delayed, beacon led will flash after a delay as per delayed ringing configuration, when there is an incoming call and until call is answered or ignored.
                    Applies to primary, shared, BLF and BLF park lines.
                    Default: 0"
                    ::= { endptSIP 224 }
									
endptVVMMODE OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Allows user to access Voice Mail service and receive a visual view of Inbox on the phone. If the feature is enabled user can play, read, delete voicemails from the phone.
                    Range: 0 - 1
                    Default: 0"
                    ::= { endptSIP 225 }
									
endptVVMPASSCODEREQ OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies whether a voicemail PIN is required to access Visual voicemail box.
                    Range: 0 - 1
                    Default: 1"
                    ::= { endptSIP 226 }
									
endptVVMPLAYBACKNUM  OBJECT-TYPE
                    SYNTAX      DisplayString (SIZE(0..255))
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Defines a phone number for Visual voicemail playback feature."
                    ::= { endptSIP 227 }

endptENABLEUSBHEADSET OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Enable or disable USB Headset.
                    Range: 0 - 1
                    Default: 1"
                    ::= { endptSIP 228 }
									
endptAGTGREETINGSTAT OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Enable or Disable Agent Greetings feature.
                    Range: 0 - 1
                    Default: 0"
                    ::= { endptSIP 229 }
									
endptAGTGREETLOGOUTDEL OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Delete Agent Greetings data by Agent logout or not.
                    Range: 0 - 1
                    Default: 0"
                    ::= { endptSIP 230 }
									
endptAGENTGREETINGSDELAY OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "The delay between call answering and Agent Greeting playback in milliseconds.
                    Range: 0-3000
                    Default: 700"
                    ::= { endptSIP 231 }
									
endptENABLERANDOMRTPPORT OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "If the value is 0, even numbered RTP ports starting at RTP_PORT_LOW will be used for all calls.
                    If the value is 1, an even numbered RTP port will be randomly selected in the range from RTP_PORT_LOW to RTP_PORT_LOW+RTP_PORT_RANGE each time audio path is established (e.g. when a call is answered or a call is resumed). To maximize the effectiveness of this setting, RTP_PORT_RANGE should be assigned a value much larger than the default of 40.
                    Default: 0"
                    ::= { endptSIP 232 }
									
endptSHAREDLINE9ENABLED OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies if shared line is enabled.
                    The setting only applies to 3PCC server environments.
                    '0' The shared line is disabled (default)
                    '1' The shared line is enabled"
                    ::= { endptSIP 233 }

endptSHAREDLINE10ENABLED OBJECT-TYPE
                    SYNTAX      INTEGER
