endptBROADWORKSCALLPARKAVAILABLE  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Is BroadWorks Call Park available. 0 - False, 1 - True."
                ::= { endptBroadWorks 9 }

endptBROADWORKSXSIURL  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "URL of BroadWorks XSP server"
                ::= { endptBroadWorks 10 }

endptBROADWORKSXSIHEARTBEAT  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "XSI event channel heart beat. Default value: 15, min: 1, max: 999."
                ::= { endptBroadWorks 11 }

endptBROADWORKSXSISTATE  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Indicates XSI state. Values: 0 - XSI initializing (default), 1 - XSI running, 2 - XSI failed"
                ::= { endptBroadWorks 12 }

endptBROADWORKSXSIEVENTCHANNELDURATION  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Defines the time duration in minutes for XSI event channel, i.e. phone will ask XSP server 
                to maintain the established Comet HTTP connection for the specified period of time. 
                After 50% of this time phone will reestablish Comet HTTP connection."
                ::= { endptBroadWorks 13 }

endptBROADWORKSXSIUSERID  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies the Broadsoft's User Id which phone should use for XSI athentication (SIP or Web methods).
                Note: it is User Id without @ and domain"
                ::= { endptBroadWorks 14 }

endpt3PCCSERVERMODE  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "When a 3PCC environment is enabled using ENABLE_3PCC_ENVIRONMENT=1,
                this setting defines if the phone expects a generic 3PCC server or a Broadsoft server
                  Value - Operation
                    0 - Generic
                    1 - Broadsoft
                    2 - 3CX
                    3 - Netsapiens
                    4 - RingCentral (no J129)
                    5 - Avaya Cloud (no J129)"
                ::= { endptBroadWorks 15 }

endptWAITFORCALLOPERATIONRESPONSE  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies the time in seconds before providing a response for user initiated call operation. 
                This parameter is applicable to all server environments (Aura/ 3PCC/IP Office)
                Example:
                User goes off-hook (phone sends an invite. If there is no response from the proxy for 3 seconds
                (assume default value), it will result in auinotification."
                ::= { endptBroadWorks 16 }

endptBWENABLEDIR  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies BroadWorks Directory feature availability state.
                  Value - Operation
                    0 - disable
                    1 - enable"
                ::= { endptBroadWorks 17 }

endptBWENABLEDIRENTERPRISE  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies BroadWorks Enterprise directory availability state.
                  Value - Operation
                    0 - disable
                    1 - enable"
                ::= { endptBroadWorks 18 }

endptBWENABLEDIRENTERPRISECOMMON  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION ""
                ::= { endptBroadWorks 19 }

endptBWENABLEDIRGROUP  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
