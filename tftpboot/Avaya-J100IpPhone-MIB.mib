                    DESCRIPTION "Reflects connected headset manufacture."
                    ::= { endptSIP 285 }

endptUSBHEADSETSN  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Reflects connected headset serial number."
                    ::= { endptSIP 286 }

endptUSBHEADSETFW  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Reflects connected headset firmware version."
                    ::= { endptSIP 287 }

endptBLFLISTPREFERREDSTARTLOCATION  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "This parameter controls where detected BLFs would be placed on the home screen. 
                    BLFs are detected from BLF List URI. It provides the starting location from which the detected BLFs will be placed.
                    0 = BLFs will be placed depending on Button Module detection. Starting location is 1 if no BM. 
                     Starting location is 25 if a button module detected on the phone.
                    N (1 - 96) = For example, if BLFs are to be placed starting from line key location 1 then N should be 1.
                    Range: 0-96
                    Default: 0"
                    ::= { endptSIP 288 }

endptBLFLISTLINEKEYLOCATIONFORCED  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "This parameter sets 'forced' property of a BLF line key detected from BLF LIST URI. When 'forced' BLF line key can not be moved.
                    0 - unforced
                    1 (Default) - forced (user cannot move the BLF list line keys)
                    Recommended value for this parameter should be 1. This would make the detected BLFs to be not moved."
                    ::= { endptSIP 289 }

endptAUTOMATICUPDATEPOLICY  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "This parameter give control to change automatic update policy mode.
                    Value Policy Mode:
                    0 - disabled (default)
                    1 - daily
                    2 - weekly
                    3 - monthly"
                    ::= { endptSIP 290 }

endptAUTOMATICUPDATEDAYS  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Mon,Tue,Wed,Thu,Fri,Sat,Sun (for Weekly)
                    xMon,xTue,xWed,xThu,xFri,xSat,xSun (for Monthly) where x = which occurrence of the month. i.e. 2Sat = 2nd Saturday of the Month.
                    Default: Sun (for weekly, this means Sunday, for monthly, this would map to 1Sun, i.e. 1st Sunday of the Month)
                    Ignored if AUTOMATIC_UPDATE_POLICY set to 0 or 1.
                    If policy is weekly and user configured days as '3Mon,3Tue,3Wed,4Thu,4Fri,4Sat,4Sun', then phone should use default value i.e. 'Sun'
                    i.e. if invalid configuration detected then phone will use default value.
                    Note: Administrator can define multiples via comma separated"
                    ::= { endptSIP 291 }

endptAUTOMATICUPDATEWINDOW  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "m,n - specifies hours of a day (in 24h format) for Begin and End of the window automatic settings/firmware update is allowed.
                    Each phone will choose random start time in this window
                    E.g. 3,4 - means the settings/firmware update will begin between 3AM and 4AM
                    Default: 2,4
                    e.g.
                    - 3,3 will consider as 24 hr valid range.
                    - 12,25 is invalid range and phone will use default range i.e. 2,4
                    12,4 is valid 16hr range. (i.e. 12 - 24 & 1 - 4)"
                    ::= { endptSIP 292 }

endptAUTOMATICUPGRADEINSTALLDATETIME  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies The date and time after which new firmware will be downloaded and installed.
                    Once this date and time is reached, J100 will follow AUTOMATIC_UPDATE_DAYS and AUTOMATIC_UPDATE_WINDOW to trigger the reboot for firmware download.
                    Default value is NULL. So when this parameter is not set, phone will follow AUTOMATIC_UPDATE_POLICY, AUTOMATIC_UPDATE_DAYS and AUTOMATIC_UPDATE_WINDOW to trigger the firmware download.
                    Note: UPGRADE_INSTALL_DATE_TIME is applicable when AUTOMATIC_UPDATE_POLICY is 1, 2 or 3.
                    The format is YYYY-MM-DDThh:mm, where YYYY is a 4 numeric digits representing the year, MM is 2 numeric digits for month 01-12,
                    dd is two numeric digits representing the day of the month, from 01 through 31, 'T' stand for Time separator,
                    hh is two numeric digits representing the hour of the day, from 00 through 23 and mm is two numeric digits representing minutes of the hour,
                    from 00 through 59. The default is NULL.
                    Note: This parameter applies to the phones local time as defined by based on GMTOFFSET, DAYLIGHT_SAVING_SETTING_MODE, DSTOFFSET, DSTSTART and DSTSTOP.
                    Example: SET UPGRADE_INSTALL_DATE_TIME 2015-04-12T23:20"
                    ::= { endptSIP 293 }

endptAUTOMATICUPDATEREBOOTPROMPT  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Phone has detected new settings requiring a reboot.
                    1, reboot confirmation prompt will be shown on phone UI
                    0, reboot confirmation prompt will not be shown on phone UI, i.e. phone directly do the upgrade instead of confirmation from user.
                    Default value is 0.
                    This prompt is for firmware upgrade only.
                    Note: If reboot action parameter is changed & phone is idle then phone will ALWAYS reboot."
                    ::= { endptSIP 294 }

endptLOGSRVRSECURE  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Defines if secure or non-secure syslog is to be used by default.
                    0 (Default) - Non-secure using UDP transport (existing behavior)
                    1 - Secure syslog using TLS transport using RFC 5425
                    Selected value wiil be available as Default option in admin menu"
                    ::= { endptSIP 295 }

endptPUSHMODE  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies which combination of non-secure and secure push is to be used.
                    0 - Only non-secure Push (http) is enabled
                    1 - Only secure Push (https) is enabled
                    2 (Default) - Both secure and non-secure Push are enabled
                    NOTE: If there is no identity certificate installed on the phone with the serverAuth attribute, then only http can be used. 
                    This means that if PUSH_MODE = 1, Push will be disabled and if PUSH_MODE=2 then only non-secure will be used. 
                    In this last case, the Subscribe Push must indicate 'nonsecure'."
                    ::= { endptSIP 296 }

endptPUSHPORTSECURE  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies the port to be used to listen for incoming secure Push requests over https if secure push is enabled.
                    NOTE: The default value is set to 8443 to avoid a conflict with the web server in the phone using the default value."
                    ::= { endptSIP 297 }

endptPHONEKEYLISTENHANCED  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "This parameter is a concatenation of PHONEKEY parameter in 46xxSettings file. Each PHONEKEY entry is separated by ';;'"
                    ::= { endptSIP 298 }

endptNEXTAUTOMATICUPDATEINTERVAL  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Next automatic update time"
                    ::= { endptSIP 299 }

endptLASTUPDATE  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Last update time"
                    ::= { endptSIP 300 }

endptUSBSTICKMODEL  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Reflects connected stick model."
                    ::= { endptSIP 301 }

endptUSBSTICKMANUFACTURER  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Reflects connected stick manufacture."
                    ::= { endptSIP 302 }

endptUSBSTICKSN  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Reflects connected stick serial number."
                    ::= { endptSIP 303 }

endptUSBSTICKFW  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Reflects connected stick firmware version."
                    ::= { endptSIP 304 }

endptUSBKEYBOARDMODEL  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Reflects connected keyboard model."
                    ::= { endptSIP 305 }

endptUSBKEYBOARDMANUFACTURER  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Reflects connected keyboard manufacture."
                    ::= { endptSIP 306 }

endptUSBKEYBOARDSN  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Reflects connected keyboard serial number."
                    ::= { endptSIP 307 }

endptUSBKEYBOARDFW  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Reflects connected keyboard firmware version."
                    ::= { endptSIP 308 }

endptENABLEUSBDEVICE  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Enable/disable support of USB devices on the phone.
                    Range: 0 - 1
                    Default: 1"
                    ::= { endptSIP 309 }

endptENABLEUSBSTICK  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Enable or disable USB Flash Drive support.
                    Range: 0 - 1
                    Default: 1"
                    ::= { endptSIP 310 }

endptENABLEUSBKEYBOARD  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Enable or disable USB Keyboard support.
                    Range: 0 - 1
                    Default: 1"
                    ::= { endptSIP 311 }

endptSHAREDLINE1SUBSCRIBETARGET  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "The AOR (Address of Record) of the subscription target for the shared line.
                    If it is empty (not set), the subscription target is set to SCA1_SIPUSERID
                    i.e. subscription and registration targets are identical.
                    It should only specify the handle (e.g. 123456_2) since the domain is specified independently.
                    Note that shared lines are only supported for the same SIP domain as the primary line."
                    ::= { endptSIP 312 }

endptSHAREDLINE2SUBSCRIBETARGET  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "The AOR (Address of Record) of the subscription target for the shared line.
                    If it is empty (not set), the subscription target is set to SCA2_SIPUSERID
                    i.e. subscription and registration targets are identical.
                    It should only specify the handle (e.g. 123456_2) since the domain is specified independently.
                    Note that shared lines are only supported for the same SIP domain as the primary line."
                    ::= { endptSIP 313 }

