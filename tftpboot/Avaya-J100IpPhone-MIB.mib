                DESCRIPTION "The display name for BroadWorks Personal directory."
                ::= { endptBroadWorks 28 }

endptBWDIRCUSTOMDESCRIPTION  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "The display name for BroadWorks Custom directory."
                ::= { endptBroadWorks 29 }

endptBWDIRENTERPRISEEXTENSION  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "The display name for BroadWorks Enterprise directory extension."
                ::= { endptBroadWorks 30 }

endptBWDIRENTERPRISECOMMONEXTENSION  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "The display name for BroadWorks Enterprise Common directory extension."
                ::= { endptBroadWorks 31 }

endptBWDIRGROUPEXTENSION  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "The display name for BroadWorks Group directory extension."
                ::= { endptBroadWorks 32 }

endptBWDIRGROUPCOMMONEXTENSION  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "The display name for BroadWorks Group Common directory extension."
                ::= { endptBroadWorks 33 }

endptBWDIRPERSONALEXTENSION  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "The display name for BroadWorks Personal directory extension."
                ::= { endptBroadWorks 34 }

endptBWDIRCUSTOMEXTENSION  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "The display name for BroadWorks Custom directory extension."
                ::= { endptBroadWorks 35 }

endptCALLPARKINDICATION  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Call park indication parameter will determine how phone will inform user about parked calls in addition to winking Beacon LED.
                  Value - Operation
                    0 - no additional indication
                    1 - audible indication
                    2 - visual indication (on Incoming call screen)
                    3 - audible and visual indication"
                ::= { endptBroadWorks 36 }

endptBWPRIORITYALERTRINGTYPE  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Defines the ringtone that will be played when there is an Broadsoft incoming priority call (Bellcore-dr2)."
                ::= { endptBroadWorks 37 }

endptBWALTERNATENUBMER1ALERTRINGTYPE  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Defines the ringtone that will be played when there is an Broadsoft incoming alternate number 1 call (Bellcore-dr3)."
                ::= { endptBroadWorks 38 }

endptBWALTERNATENUMBER2ALERTRINGTYPE  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Defines the ringtone that will be played when there is an Broadsoft incoming alternate number 2 call (Bellcore-dr4)."
                ::= { endptBroadWorks 39 }

endptCALLDECLINEPOLICY  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Indicates a decline method of the feature"
                ::= { endptBroadWorks 40 }

endptBWHOTELINGMODE   OBJECT-TYPE
               SYNTAX      INTEGER
               MAX-ACCESS  read-only
               STATUS      current
               DESCRIPTION "
                       Defines primary or guest location for flexible seating.
                       1 - if the device profile is the primary location of a user and this user has the Hoteling Host service assigned
                       2 - if the device profile is the primary location of a Flexible Seating Host virtual subscriber
                       3 - if the device profile is the Flexible Seating location of a guest
                       0 - if none of the above is true"
               ::= { endptBroadWorks 41 }

endptBSCCENABLED  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Defines that Broadsoft Call Center is available in the settings file."
                ::= { endptBroadWorks 42 }

endptBSCCACTIVE  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Defines that Broadsoft Call Center is available according to the xsi settings."
                ::= { endptBroadWorks 43 }

endptBSCCUNAVAILCODES  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies Broadsoft Call Center agent's unavailability reason code."
                ::= { endptBroadWorks 44 }

endptBSCCDISPCODES  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies Broadsoft Call Center list of disposition codes."
                ::= { endptBroadWorks 45 }

endptBSCCSUPERVISORS  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies Broadsoft Call Center list of supervisors."
                ::= { endptBroadWorks 46 }

endptBSCCCOTENABLED  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies Broadsoft Call Center Customer Originated Trace is enabled."
                ::= { endptBroadWorks 47 }

endptBSCCAUTOMATICSTATE  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies if the phone should automatically set state Sign-In and Sign-Out on login and logout, respectively."
                ::= { endptBroadWorks 48 }

endptESCALATIONFAC  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies FAC that can be used by the phone to invoke Escalation."
                ::= { endptBroadWorks 49 }

endptPNP   OBJECT IDENTIFIER ::= { avayaSparkMIB 15 }

endptPNPENABLED  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies if PnP is enabled or not. This value does not define if it is to be activated or not but only defines if PnP can be activated. 0: PnP is disabled, 1: PnP is enabled"
                ::= { endptPNP 1 }

endptPNPACTIVE  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies if PnP is active or not for the current boot. 0: PnP is inactive, 1: PnP activation is allowed"
                ::= { endptPNP 2 }

endptPNPSTATUS  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "The current state of PnP if it is currently in progress or the result of PnP if PnP was performed and is complete. This value has no meaning If PnP has been disabled for any reason. 0: PnP is not active, 1: PnP discovery is active, 2: PnP configuration is active, 3: PnP completed successfully, 4: PnP discovery failed, 5: PnP discovery timed out, 6: PnP configuration failed"
                ::= { endptPNP 3 }

endptTR87   OBJECT IDENTIFIER ::= { avayaSparkMIB 16 }

endptTR87SESSIONACTIVE  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Indicates if TR87 session is active: 0 - TR87 session is inactive (default), 1 - TR87 session is active."
                ::= { endptTR87 1 }

END

