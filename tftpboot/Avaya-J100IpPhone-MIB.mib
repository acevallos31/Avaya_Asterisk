endptSHAREDLINE9SIPUSERID  OBJECT-TYPE
                    SYNTAX      DisplayString (SIZE(0..255))
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "The AOR (Address of Record) for the shared line.
                    It should only specify the handle (e.g. 123456_2) since the domain is specified independently. 
                    Note that shared lines are only supported for the same SIP domain as the primary line.
                    The setting only applies to 3PCC server environments."
                    ::= { endptSIP 237 }

endptSHAREDLINE10SIPUSERID  OBJECT-TYPE
                    SYNTAX      DisplayString (SIZE(0..255))
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "The AOR (Address of Record) for the shared line.
                    It should only specify the handle (e.g. 123456_2) since the domain is specified independently. 
                    Note that shared lines are only supported for the same SIP domain as the primary line.
