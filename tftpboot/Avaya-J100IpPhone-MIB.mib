                    ::= { endptSIP 117 }

endptSIPCONTROLLERSINFORMATION  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "This object is used to display sip controllers 
                    information for 3PCC modes (Generic, Broadsoft, 3CX or Netsapiens). 
                    It displays the information as follows:
                    User's Domain: [ Controller Fqdn1:[IPaddress1:Protocol:Port:$Priority:$Status, IPaddress2:Protocol:Port:$Priority:$Status]]  
                    User's domain - sip user's domain
                    Where 'Controller Fqdn1' would be resolved to 
                    IP Address1 and IP Address 2 through DNS.
                    Priority indicates whether the server is primary or secondary."
                    ::= { endptSIP 118 }

endptPRIMARYLINEBARGEINENABLED  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "A primary line which is shared can be configured in the Broadsoft server to 
                    either enable or disable the ability of a user to barge into a call at a different location on the shared line.
                    This setting is ignored if PRIMARY_LINE_TYPE = 0
                    Not used for RingCentral and Avaya Cloud.
                    '0' Barge in is disabled for the shared line
                    '1' Barge in is enabled for the shared line (default)"
                    ::= { endptSIP 119 }

endptPROVIDESHAREDLINECONFIG  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies if the user has the ability to change Shared Line configuration using the Settings menu on the phone.
                    Not used for RingCentral and Avaya Cloud.
                    '0' Shared lines is not displayed in settings menu
                    '1' Shared lines is displayed in settings menu but all information is read-only
                    '2' Shared lines is displayed in settings menu and is fully configurable"
                    ::= { endptSIP 120 }

endptSHAREDLINERINGTYPES  OBJECT-TYPE
                    SYNTAX      DisplayString (SIZE(0..255))
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Stores personalized ringtones for SCA lines"
                    ::= { endptSIP 121 }

endptSELECTEDSERVERMODE  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Internal parameter indicating current operational mode.
                    Value - Operation
                    0 - Invalid
                    1 - Aura
                    2 - 3PCC Generic
                    3 - IPO
                    4 - IPO with CCMS support
                    5 - 3PCC with Broadsoft support
                    6 - 3CX
                    7 - Netsapiens
                    8 - RCO
                    9 - ACO"
                    ::= { endptSIP 122 }

endptDUALIPPREF  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "DUAL_IPPREF controls:
                        - the selection of SSON either from DHCPv4 or DHCPv6 server, when phone is in dual mode, and
                        - whether an IPv4 or IPv6 addresses returned by DNS would be tried first during dual-mode operation.
                    DHCP clients use DUAL_IPPREF to decide which SSON configuration attributes to apply for DHCPv4/DHCPv6 interworking in dual mode. 
                    Based on DUAL_IPPREF the phone selects SSON attributes either from DHCPv4 or DHCPv6 server.
                    If DNS server name is provided, and if DNS resolver returns both IPv4 and IPv6 addresses, 
                    the order in which they will be tried will be based on DUAL_IPPREF parameter.
                    NOTE: SIP server FQDNs are resolved into addresses that are ordered based on SIGNALING_ADDR_MODE, not DUAL_IPPREF
                    Value - Operation
                        4 - IPv4 preference (default)
                        6 - IPv6 preference"
                    ::= { endptSIP 123 }

endptDHCPSTDV6  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "DHCPV6 extended rebind flag.
                    DHCPSTDV6 specifies whether DHCPv6 will comply with the IETF RFC 3155 standard and immediately stop using an 
                    IPv6 address if the the address valid lifetime expires, or whether it will enter an extended rebinding state 
                    in which it continues to use the address and to periodically send a rebinding request, as well as to periodically
                    send an NS (Neighbor Solicitation) request to check for address conflicts, until a REPLY response is received from
                    a DHCPv6 server  (either a new address, or zero lifetimes, or error status codes) or until a DAD conflict is detected.
                    If the address is duplicated, DHCPv6 client restarts and solicits for a new address.
                    Value - Operation
                        0 - enter proprietary extended rebinding state (continue to use IPv6 address, if DHCPv6 lease expires) (default)
                        1 - comply with DHCPv6 standard (immediately release IPv6 address, if DHCPv6 lease expires)"
                    ::= { endptSIP 124 }

endptREUSETIMER  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "REUSETIME specifies the number of seconds that DHCPV4 or DHCPv6 discovery will be attempted before either:
                        - reusing the previously cached value of IPv4 address (and associated address information) that the Phone had the 
                          last time successfully registered with a call server, if such an address is available, or
                        - continue discovery DHCPv6 server: IPv6 does not support reuse, so there is no corresponding parameter to IPv4's REUSE_IPADD.
                    While reusing an address, DHCPV4 will enter the extended rebinding state described for DHCPSTD.
                    Valid values are 0 and 20 through 999; the default value is 60.
                    A value of zero means that DHCP or DHCPv6 will be tried forever (i.e., no reuse).
                    Valid Values: 0 and 20 through 999 (60 is default)"
                    ::= { endptSIP 125 }

endptPRIVACYSLAACMODE  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies the preference for Privacy Extensions(RFC3041)
                    Value - Operation
                        1 - Privacy extension disabled, one stable address is generated using modified EUI-64 format interface identifier 
                          (Based on MAC address). The phone address selection preference is based on default RFC6724 SASA rules.
                        2 - Privacy extension enabled, one stable address is generated using modified EUI-64 format interface identifier 
                           (Based on MAC address) and one temporary private address is generated. The phone address selection preference 
                           is based on RFC6724 SASA rules. PRIVACY_SLAAC_MODE changes default SASA rules (i.e. Rule 7) to prefer a manual,
                           DHCPv6 or Stable SLAAC over SLAAC temporary address. (default)
                        3 - Privacy extension enabled, one stable address is generated using modified EUI-64 format interface identifier 
                           (Based on MAC address) and one temporary private IPv6 address is generated. The phone address selection 
                           preference is based on default RFC6724 SASA rules. Default SASA Rule 7 is used to prefer SLAAC temporary address 
                           over a manual, DHCPv6 or Stable SLAAC addresses"
                    ::= { endptSIP 126 }

endptSIPCONTROLLERLIST2  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "This parameter replaces  SIP_CONTROLLER_LIST for dual mode phones. It is used on IPv6-only phones to provide
                    the list of SIPv6 servers. SIPv4 servers are ignored in IPv6-only mode. It is used to select the registration address.
                    The list has the following format: host[:port][;transport=xxx] where:
                      -host: is an IP addresses in dotted-decimal format or hex format
                      -port:is the optional port number. If a port number is not specified the default value (5060 for TCP, 5061 for TLS) will be used
                      -transport: is the optional transport type (where xxx is TLS or TCP)
                    If a transport type is not specified the default value TLS will be used
                    A dual mode controller has addresses of both families within curly brackets.
                    Dual mode phones use SIGNALING_ADDR_MODE to select SM IP addresses from SIP_CONTROLLER_LIST_2.
                    If SIGNALING_ADDR_MODE is 4, register to the first IPv4 address in SIP_CONTROLLER_LIST_2.
                    IPv4-only phones use SIP_CONTROLLER_LIST. Dual mode phones use SIP_CONTROLLER_LIST if SIP_CONTROLLER_LIST_2 is not provided.
                      Valid Values: String The comma separated list of SIP proxy/registrar servers
                      0 to 255 characters: zero or more IP addresses in dotted decimal or colon-hex format, 
                      separated by commas without any intervening spaces.
                      Default: (null)"
                    ::= { endptSIP 127 }

endptSCEPENCALG  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "SCEP Encryption Algorithm
                      Value - Operation
                        0 - DES
                        1 - AES-256"
                    ::= { endptSIP 128 }

endptBLOCKCERTIFICATEWILDCARDS  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Flag indicating accepting wildcards in certificate.
                      Value - Operation
                        0 - Accept wildcards in certificate
                        1 - Do not accept wildcards in certificates"
                    ::= { endptSIP 129 }

endptMAXDNSDISCOVEREDSIPCONTROLLERS  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies maximum number of sip controllers to be used for redundancy from DNS lookups.
                        For Netsapiens mode it is accepted to take value between 2 and 6.
                        Parameter takes effect only when 3PCC_SERVER_MODE = 3 (Netsapiens), for Broadsoft number of controllers is always 2, for other modes it's 1."
                    ::= { endptSIP 130 }

endptSCEPENTITYCLASS  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "SCEP entity class. This variable returns  
                    a string used as entity class when using SMGR SCEP.
                    Default: (null)"
                    ::= { endptSIP 131 }

endptAUTOANSWERDURINGCALL  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies flag that can be used by the phone to define behavior for auto-answer calls during another active call. If value is 0 then auto-answer call should not be answered during current active call. If value is 1 then current active call should be put on hold and incoming auto-answer call should be answered automatically"
                    ::= { endptSIP 132 }

endptSOFTKEYACTIVE  OBJECT-TYPE
