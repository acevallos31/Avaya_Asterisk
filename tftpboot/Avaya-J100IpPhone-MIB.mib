endptVVMVOICEMAILKEY  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Defines the behavior of Voicemail (Envelope) button:
                    0 - (default) - Voicemail key is used according to the admin parameter VVM_VOICEMAIL_KEY_DEFAULT 
                    1 - Voicemail key is used to access Visual voicemail Inbox
                    2 - Voicemail key is used to dial IVR"
                    ::= { endptSIP 253 }

endptUSBPOWERLEVEL  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Reflects the USB power level:
                    0 (default) - USB power not allowed
                    1 - Low USB power level
                    2 - Medium USB power level
                    3 - High USB power level"
                    ::= { endptSIP 254 }

endptEXCHANGEAUTHMETHODDEFAULT  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies the Exchange authentication method configured by Administrator:
                    0 (default) - Basic authentication
                    1 - OAuth
                    2 - Basic authentication - forced
                    3 - OAuth - forced
                    When admin configured method is Basic (Forced) or OAuth (Forced), it is the active authentication method. 
                    In this case phone user is not allowed to change the authentication method from phone user interface.
                    When admin configured method is non-forced, phone user can change the authentication method from phone user interface and 
					the active authentication method is going to be as configured by the phone user."
                    ::= { endptSIP 255 }

endptEXCHANGEUSERACCOUNTDEFAULT  OBJECT-TYPE
                    SYNTAX      DisplayString (SIZE(0..255))
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Specifies the Exchange user account configured by Administrator. 
                    This parameter is only applicable when authentication method is OAuth.
                    If phone user hasn't configured any user name on the phone user interface
                    then value configured in this parameter would be used."
                    ::= { endptSIP 256 }

endptEXCHANGEEMAILDOMAINUSER  OBJECT-TYPE
                    SYNTAX      DisplayString (SIZE(0..255))
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "If the EXCHANGE_EMAIL_DOMAIN is not set in the settings file, 
                    it is up to the user to enter the domain part of their email address. 
                    So if this setting is not empty because it has been entered by the user, 
                    it will be used to construct the user's email address."
                    ::= { endptSIP 257 }

endptEXCHANGESERVERLISTUSER  OBJECT-TYPE
                    SYNTAX      DisplayString (SIZE(0..255))
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "If the EXCHANGE_SERVER_LIST is not set in the settings file (i.e. it is empty), 
                    it is up to the user to enter the server's host address (as an FQDN)"
                    ::= { endptSIP 258 }

endptEXCHANGEAUTHMETHOD  OBJECT-TYPE
