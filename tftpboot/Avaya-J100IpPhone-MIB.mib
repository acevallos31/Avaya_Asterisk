                DESCRIPTION "Specifies BroadWorks Group directory availability state.
                  Value - Operation
                    0 - disable
                    1 - enable"
                ::= { endptBroadWorks 20 }

endptBWENABLEDIRGROUPCOMMON  OBJECT-TYPE
