                    DESCRIPTION "The number of call appearances the shared line can have.
                    Not used for BLA.
                    Range: 1-8
                    Default: 1"
                    ::= { endptSIP 235 }

endptSHAREDLINE10MAXCALLAPPEARANCES  OBJECT-TYPE
                    SYNTAX      INTEGER
