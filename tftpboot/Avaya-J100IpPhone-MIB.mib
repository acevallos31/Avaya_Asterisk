endptWIFI   OBJECT IDENTIFIER ::= { avayaSparkMIB 8 }
endptWIFISTAT   OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Wi-Fi Mode of operation. This variable returns values: 
                    '0' Wi-Fi Disabled, 
                    '1' Wi-Fi Unrestricted or Ethernet (default), 
                    '2' Wi-Fi Restricted or Ethernet, 
                    '3' Wi-Fi Only, Unrestricted,
                    '4' Wi-Fi Only"
                    ::= { endptWIFI 1 }
endptWIFIIPADD  OBJECT-TYPE
                    SYNTAX      IpAddress
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Endpoint IP address on Wi-Fi. This variable returns a 
                    4-octet string specifying the endpoint's current IP address:
                    If DHCP off: Statically-configured phone IP address, 
                    If DHCP on: Value of WIFIIPADD obtained via DHCP"
                    ::= { endptWIFI 2 }
endptWIFIGIPADD  OBJECT-TYPE
                    SYNTAX      IpAddress
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Gateway/router IP address on Wi-Fi. This variable returns a 
                    4-octet string specifying the current gateway/router IP address:
                    If DHCP off: Statically-configured gateway/router IP address, 
                    If DHCP on: Value of WIFIGIPADD obtained via DHCP"
                    ::= { endptWIFI 3 }
endptWIFINETMASK    OBJECT-TYPE
                    SYNTAX      IpAddress
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Subnet mask on Wi-Fi. This variable returns a  
                    4-octet string specifying the subnet mask currently in use:
                    If DHCP off: Statically-configured network mask,
                    If DHCP on: Value of WIFINETMASK obtained via DHCP"
                    ::= { endptWIFI 4 }
endptWLANESSID OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "SSID of WLAN network to be used.(configured from 46xxsettings.txt). 
                    String of up to 32 characters"
                    ::= { endptWIFI 5 }
endptWLANSECURITY  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "WLAN Security Standard used: 
                    'none' for no security, 
                    'wep' for WEP security, 
                    'wpa2psk' for WPA2 security with pre-shared key, 
                    'wpapsk' for WPA security wit pre-shared key,  
                    'wpa2e' for WPA2 Enterprise security (802.1x auth.)"
                    ::= { endptWIFI 6 }
endptWEPAUTHENTICATION  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "WEP authentication used: 
                    'openSystem' for WEP open systems, 
                    'sharedKey' for WEP with shared key authentication"
                    ::= { endptWIFI 7 }
--endptWEPDEFAULTKEY   OBJECT-TYPE
--                    SYNTAX      INTEGER
--                    MAX-ACCESS  read-only
--                    STATUS      current
--                    DESCRIPTION "Index of WEP default key. The range is 1 to 4"
--                    ::= { endptWIFI 8 }
endptWEPKEYLEN  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Length of WEP key: 
                    '40bit' for WEP keys of 40 bits, 
                    '128bit' for WEP keys of 128 bits"
                    ::= { endptWIFI 9 }
--endptWEPKEY1   OBJECT-TYPE
--                    SYNTAX      DisplayString
--                    MAX-ACCESS  read-only
--                    STATUS      current
--                    DESCRIPTION "WEP Keys 1 from the range 1..4.
--                    Default not set, is an empty string. 
--                    Format is 10 hex digits for 40 bit keys, 26 hex digits for 128 bit keys"
--                    ::= { endptWIFI 10 }
--endptWEPKEY2   OBJECT-TYPE
--                    SYNTAX      DisplayString
--                    MAX-ACCESS  read-only
--                    STATUS      current
--                    DESCRIPTION "WEP Keys 2 from the range 1..4.
--                    Default not set, is an empty string. 
--                    Format is 10 hex digits for 40 bit keys, 26 hex digits for 128 bit keys"
--                    ::= { endptWIFI 11 }
--endptWEPKEY3   OBJECT-TYPE
--                    SYNTAX      DisplayString
--                    MAX-ACCESS  read-only
--                    STATUS      current
--                    DESCRIPTION "WEP Keys 3 from the range 1..4.
--                    Default not set, is an empty string. 
--                    Format is 10 hex digits for 40 bit keys, 26 hex digits for 128 bit keys"
--                    ::= { endptWIFI 12 }
--endptWEPKEY4   OBJECT-TYPE
--                    SYNTAX      DisplayString
--                    MAX-ACCESS  read-only
--                    STATUS      current
--                    DESCRIPTION "WEP Keys 4 from the range 1..4.
--                    Default not set, is an empty string. 
--                    Format is 10 hex digits for 40 bit keys, 26 hex digits for 128 bit keys"
--                    ::= { endptWIFI 13 }
--endptWLANPASSWORD  OBJECT-TYPE
--                    SYNTAX      DisplayString
--                    MAX-ACCESS  read-only
--                    STATUS      current
--                    DESCRIPTION "Preconfigured Wi-Fi Network Password. 
--                    This parameter is applicable if WIFISTAT enables Wi-Fi. This can be from 1-64 characters. 
--                    Valid characters are A-Z, a-z, 0-9, space, and some other special symbols. 
--                    Empty value is used to erase any previously set value"
--                    ::= { endptWIFI 15 }
endptWLANWPA2EEAPMETHOD  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Pre-configured WPA2 EAP Method for 802.1x authentication of Wi-Fi network. 
                    This parameter is applicable if WIFISTAT enables Wi-Fi. 
                    Can be set to: 'PEAP' (Default), 'TLS', 'TTLS', 'PWD'"
                    ::= { endptWIFI 16 }
endptWLANWPA2EEAPPHASE2  OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Pre-configured WPA2 EAP Phase 2 Method for 802.1x authentication of Wi-Fi network. 
                    This parameter is applicable if WIFISTAT enables Wi-Fi. 
                    Can be set to 'none' (Default), 'MSCHAPV2', 'GTC'"
                    ::= { endptWIFI 17 }
endptWLANWPA2EIDENTITY   OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Pre-configured Identity for 802.1x authentication of Wi-Fi network. 
                    This parameter is applicable if WIFISTAT enables Wi-Fi. 
                    1-32 ASCII characters. Default is empty."
                    ::= { endptWIFI 18 }
endptWLANWPA2EANONYMOUSIDENTITY   OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Pre-configured anonymous identity for 802.1x authentication of Wi-Fi network. 
                    This parameter is applicable if WIFISTAT enables Wi-Fi. 
                    1-32 ASCII characters. Default is empty."
                    ::= { endptWIFI 19 }
endptACTIVENETWORK  OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Network interface that was actually activated during application initialization.
                    Used to remember the active interface when the phone is rebooted.
                    '1' for Ethernet, '2' for Ethernet and Wi-Fi (Future Rel.2), '3' for Wi-Fi"
                    ::= { endptWIFI 20 }
endptWLANACTIVESIGNALSTRENGTH   OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "This variable returns value for current Wi-Fi AP signal strength.
                    Range is 0-4, with a default of 0"
                    ::= { endptWIFI 21 }
endptWLANACTIVESSID OBJECT-TYPE
                    SYNTAX      DisplayString
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Active SSID. If this parameter is empty or has a value that is not in WLANLIST, 
                    then it will be assigned the value of 46xxsettings.txt WLAN_ESSID (which still could be empty). 
                    String of up to 32 characters"
                    ::= { endptWIFI 22 }
endptDOWIFIDHCPV4   OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "DHCP mode for Wi-Fi. This variable returns 0 if IP 
                    address for Wi-Fi is a static configuration, or 1 
                    if a dynamic IP address is received via DHCP over the Wi-Fi."
                    ::= { endptWIFI 23 }
endptWlanListSize   OBJECT-TYPE
                    SYNTAX      INTEGER
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION "Number of Wi-Fi networks that have been 
            previously connected"
                    ::= { endptWIFI 24 }
endptWlanListTable  OBJECT-TYPE
                SYNTAX SEQUENCE OF EndptWlanListTableEntry
                MAX-ACCESS    not-accessible
                STATUS        current
                DESCRIPTION   "List of Wi-Fi networks that have been 
               previously connected, which includes those that were:
               - Automatically detected and previously connected,
               - Manually added"
                ::= { endptWIFI 25 }
endptWlanListTableEntry OBJECT-TYPE
                SYNTAX EndptWlanListTableEntry
                MAX-ACCESS    not-accessible
                STATUS        current
                DESCRIPTION   "Entry of the Wlan List Table of the Wi-Fi networks
            that have been previously connected, which includes those that were:
            - Automatically detected and previously connected,
            - Manually added"
                INDEX     { endptWlanListIndex }
                ::= { endptWlanListTable 1 }
EndptWlanListTableEntry     ::= 
                SEQUENCE  {
                    endptWlanListIndex      INTEGER,
                    endptWlanSSID           DisplayString,
--                    endptWlanSECURITY       DisplayString,
                    endptWlanWPA2EEAPMETHOD DisplayString,
                    endptWlanWPA2EEAPPHASE2 DisplayString,
                    endptWlanWPA2EIDENTITY  DisplayString,
                    endptWlanWPA2EANONYMOUSIDENTITY DisplayString,
--                    endptWlanPASSWORD       DisplayString,
                    endptWlanFROMSETTINGSFILE       INTEGER,
                    endptWlanSTORED         INTEGER,
                    endptWlanAVAILABLE      INTEGER,
                    endptWlanCONNECTED      INTEGER
                }
endptWlanListIndex     OBJECT-TYPE
                SYNTAX  INTEGER
                MAX-ACCESS  not-accessible
                STATUS  current
                DESCRIPTION
                    "WLAN list index."
                ::= { endptWlanListTableEntry 1 }
endptWlanSSID OBJECT-TYPE
                SYNTAX      DisplayString (SIZE(1..32))
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "SSID of WLAN network. 
            String of up to 32 characters"
                ::= { endptWlanListTableEntry 2 }
--endptWlanSECURITY  OBJECT-TYPE
--                SYNTAX      DisplayString (SIZE(1..32))
--                MAX-ACCESS  read-only
--                STATUS      current
--                DESCRIPTION "WLAN Security Standard used: 
--                'none' for no security, 
--                'wep' for WEP security, 
--                'wpa2psk' for WPA2 security with pre-shared key, 
--                'wpapsk' for WPA security wit pre-shared key,  
--                'wpa2e' for WPA2 Enterprise security (802.1x auth.)"
--                ::= { endptWlanListTableEntry 3 }
endptWlanWPA2EEAPMETHOD  OBJECT-TYPE
                SYNTAX      DisplayString (SIZE(1..32))
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Pre-configured WPA2 EAP Method for 802.1x authentication of Wi-Fi network. 
                Can be set to: 'PEAP' (Default), 'TLS', 'TTLS', 'PWD'"
                ::= { endptWlanListTableEntry 4 }
endptWlanWPA2EEAPPHASE2  OBJECT-TYPE
                SYNTAX      DisplayString (SIZE(1..32))
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Pre-configured WPA2 EAP Phase 2 Method for 802.1x authentication of Wi-Fi network. 
                Can be set to 'none' (Default), 'MSCHAPV2', 'GTC'"
                ::= { endptWlanListTableEntry 5 }
endptWlanWPA2EIDENTITY   OBJECT-TYPE
                SYNTAX      DisplayString (SIZE(1..32))
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Pre-configured Identity for 802.1x authentication of Wi-Fi network. 
                1-32 ASCII characters OR empty."
                ::= { endptWlanListTableEntry 6 }
endptWlanWPA2EANONYMOUSIDENTITY   OBJECT-TYPE
                SYNTAX      DisplayString (SIZE(1..32))
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Pre-configured anonymous identity for 802.1x authentication of Wi-Fi network. 
                1-32 ASCII characters OR empty."
                ::= { endptWlanListTableEntry 7 }
--endptWlanPASSWORD  OBJECT-TYPE
--                SYNTAX      DisplayString (SIZE(1..64))
--                MAX-ACCESS  read-only
--                STATUS      current
--                DESCRIPTION "Preconfigured Wi-Fi Network Password. 
--                1-64 characters OR empty.
--                Valid characters are A-Z, a-z, 0-9, space, and some other special symbols."
--                ::= { endptWlanListTableEntry 8 }
endptWlanFROMSETTINGSFILE   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Is WLAN network from settings file. 0 - false, 1 - true."
                ::= { endptWlanListTableEntry 9 }
endptWlanSTORED   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Is WLAN network stored. True or False. 0 - false, 1 - true."
                ::= { endptWlanListTableEntry 10 }
endptWlanAVAILABLE   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Is WLAN network available. True or False. 0 - false, 1 - true."
                ::= { endptWlanListTableEntry 11 }
endptWlanCONNECTED   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Is WLAN network in use. True or False. 0 - false, 1 - true."
                ::= { endptWlanListTableEntry 12 }
endptWLANL2PRIORITYFORAUDIO   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "For Wi-Fi: specifies the layer 2 priority value for audio frames generated by the telephone.
                Range is 0-7, with a default of 6"
                ::= { endptWIFI 26 }
endptWLANL2PRIORITYFORSIGNALING   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "For Wi-Fi: specifies the layer 2 priority value for signaling frames generated by the telephone.
                Range is 0-7, with a default of 3"
                ::= { endptWIFI 27 }
endptWLANDSCPFORAUDIO   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "For Wi-Fi: specifies the layer 3 Differentiated Services (DiffServ) Code Point
                for audio frames generated by the telephone.
                Range is 0-63, with a default of 46"
                ::= { endptWIFI 28 }
endptWLANDSCPFORSIGNALING   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "For Wi-Fi: specifies the layer 3 Differentiated Services (DiffServ) Code Point
                for signaling frames generated by the telephone.
                Range is 0-63, with a default of 34"
                ::= { endptWIFI 29 }
endptETHERNETCARRIERDETECTED   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "For Wi-Fi: 0 - Ethernet carrier not detected
                                        1 - Ethernet carrier detected"
                ::= { endptWIFI 31 }
endptWLANCOUNTRY   OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "For Wi-Fi: Country code of ISO 3166:
                AR, AU, BR, CA, FR, DE, IE, IT, MX, ES, GB, US, RU"
                ::= { endptWIFI 32 }
endptNETWORKCONFIGMANUAL   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "For Wi-Fi: specifies network configuration was set manually or not:
                0 - auto, 1 - manual"
                ::= { endptWIFI 33 }
endptCHANGEOVERETHERNETTOWIFIACTIVE   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "For Wi-Fi: specifies detection of change over ethernet to Wi-Fi:
                0 - not active, 1 - active"
                ::= { endptWIFI 34 }
endptWLANENABLE80211D   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "For Wi-Fi: specifies enabling 80211d:
                0 - disable, 1 - enable"
                ::= { endptWIFI 35 }
endptENABLENETWORKCONFIGBYUSER   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "For Wi-Fi: specifies if network configuration can be modified by the user:
                0 - disable, 1 - enable"
                ::= { endptWIFI 36 }
endptWIFICHIPPRESENT   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "For Wi-Fi: specifies if Wi-Fi chip is presented or not:
                0 - not presented, 1 - presented"
                ::= { endptWIFI 37 }
endptREUSEWIFI  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Displays if DHCP failed and previous network parameters are used over Wi-Fi."
                ::= { endptWIFI 38 }
endptREUSEWIFIIPADDRESS     OBJECT-TYPE
                SYNTAX      IpAddress
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Endpoint IP address on Wi-Fi. This variable returns a 
                4-octet string specifying the IP address which will be used when DHCP fails over Wi-Fi."
                ::= { endptWIFI 39 }
endptREUSEWIFISUBNETMASK     OBJECT-TYPE
                SYNTAX      IpAddress
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Subnet mask. This value will be assigned for Wi-Fi subnet mask parameter when DHCP fails over Wi-Fi."
                ::= { endptWIFI 40 }
endptREUSEWIFIROUTERSLIST     OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "List of router addresses. This variable returns a sequence of IP addresses, in 
                dotted-decimal format and separated by commas. They will be used to find possible router address when DHCP fails over Wi-Fi."
                ::= { endptWIFI 41 }
endptREUSEWIFIROUTERINUSE     OBJECT-TYPE
                SYNTAX      IpAddress
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Router address. This value will be assigned for router in use parameter when DHCP fails over Wi-Fi."
                ::= { endptWIFI 42 }
endptWIFIDEBUGOPAQUESTRING     OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Opaque Wi-Fi debug string. To be used only by Wi-Fi Service engineer."
                ::= { endptWIFI 43 }
endptWLANMAXAUTHFAILRETRIES     OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Number of Wi-Fi connection retries after authentication failure. Range is 0-4, with a default of 3."
                ::= { endptWIFI 44 }

endptBLUETOOTH   OBJECT IDENTIFIER ::= { avayaSparkMIB 9 }
endptBLUETOOTHSTAT   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "For Bluetooth: specifies end user has the ability to connect a Bluetooth headsets 
                to the desk phone or not:
                1 (default value) - means that user has the ability to connect a Bluetooth headsets to the desk phone
                0 - Bluetooth is disabled and the user is not given an option to enable it"
                ::= { endptBLUETOOTH 1 }
endptOPTBLUETOOTH   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "For Bluetooth: the Bluetooth option was actually activated or not when the phone is rebooted:
                1 - Bluetooth is enabled by User
                0 - Bluetooth is disabled by User"
                ::= { endptBLUETOOTH 2 }
endptHANDSETTYPE   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "For Bluetooth: indicates a type of attached handset:
                1 - means that Cordless Handset has been attached to the phone.
                0 (default value) - means that Wired Handset has been attached to the phone. 
                -1 - Handset device is not attached to the phone"
                ::= { endptBLUETOOTH 3 }

endptDES   OBJECT IDENTIFIER ::= { avayaSparkMIB 10 }
endptDESSTATUS   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies if DES discovery is to be attempted during the boot process if there is no 
		configuration file server provisioned on the phone:
		0 - DES discovery is disabled and can only be restored with Reset to Defaults
		1 - DES discovery is disabled 
		2 - DES discovery is enabled (default)"
                ::= { endptDES 1 }
endptDESBLOCK   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies if DES discovery is allowed to be attempted during the boot process:
		0 - DES discovery is allowed 
		1 - DES discovery will not be attempted. DES can still be triggered from the Admin menu 
		2 - DES discovery is prohibited under all conditions"
                ::= { endptDES 2 }
endptDESACTIVE   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "DES Active:
		0 - DES discovery is disabled 
		1 - DES discovery should be initiated if there is no configuration server defined 
		2 - DES discovery must be initiated"
                ::= { endptDES 3 }
endptENABLEPUBLICCACERTS   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Public CA Certs:
                0 - Embedded public CA certs are only trusted when TRUSTCERTS is empty 
		1 - Embedded public CA certs are always trusted"
                ::= { endptDES 4 }
endptDESSUPPORT   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "DES Support:
		0 - There is no factory support for DES 
		1 - Factory support for DES is enabled"
                ::= { endptDES 5 }
endptFACTORYCERTSTATUS   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "FACTORY Cert Status:
		0 - There is no factory certificate present on the phone 
		1 - A factory certificate is present and it is not expired 
		2 - A factory certificate is present but it is expired"
                ::= { endptDES 6 }
endptFACTORYCERTEXPIRYDATE   OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Contains the expiry date of the factory certificate if it exists. The certificate 
		expiry date is in the format DD-MMM-YYYY(e.g. 24-Jan-2028). If there is no factory certificate, 
		the value should be empty."
                ::= { endptDES 7 }

endptWEB   OBJECT IDENTIFIER ::= { avayaSparkMIB 11 }
endptENABLEWEBSERVER   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Enable Web Server:
		0 - Web server is disabled.
		1 - Web server is enabled."
                ::= { endptWEB 1 }
endptWEBHTTPPORT   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies the port on which web server will be accessed using HTTP.
		Default value will be used if not configured or configured blank in settings file."
                ::= { endptWEB 2 }
endptWEBHTTPSPORT   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies the port on which web server will be accessed using HTTPS.
		Default value will be used if not configured or configured blank in settings file."
                ::= { endptWEB 3 }
endptUSECERTIFICATEFORWEBSERVER   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies the certificate to be sent to the client for authentication when 
		TLS connection is requested by the client to the web server:
		0 - use self-signed certificate installed in factory.
		1 - use custom server certificate"
                ::= { endptWEB 4 }
endptIDCERTSWEB   OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Manages the uploaded certificate using web i.e display the uploaded certificate 
		filename on web, delete certificate etc. "
                ::= { endptWEB 5 }
endptTRUSTCERTSWEB   OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Manages the uploaded certificate using web i.e display the uploaded certificate 
                filename on web, delete certificate etc. "
                ::= { endptWEB 6 }
endptLANGUAGESWEB   OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Manages the uploaded language files using web i.e display the uploaded languages
                filename on web, delete language file etc. "
                ::= { endptWEB 7 }
endptWEBSERVERCERT   OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies the certificate name which is uploaded for web server"
                ::= { endptWEB 8 }

endptNAT   OBJECT IDENTIFIER ::= { avayaSparkMIB 12 }
endptSTUNSERVERADDRESS   OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "STUN Server address, in IPv4, IPv6 or FQDN format. When empty, NAT traversal is disabled."
                ::= { endptNAT 1 }
endptSTUNUDPINITIALTIMEOUTMSEC   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Initial timeout, in milliseconds, to wait for a Response to a STUN Request sent over UDP.
                The timeout value is internally doubled after each [re]transmission. 
                Valid values are 500 (1/2 second) through 3000 (3 seconds). The default value is 500."
                ::= { endptNAT 2 }
endptSTUNUDPMAXTRANSMISSIONS   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "The number of times the phone will transmit a STUN Request until a Response is received,
                after which the Request will be treated as failed. 
                Valid values are 1 through 7. The default value is 7."
                ::= { endptNAT 3 }
endptSTUNUDPMAXMEDIATRANSMISSIONS   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "The number of times the phone will transmit a STUN Request to get NAT bindings for the phone's
                RTP/RTCP IP address and ports. Retransmissions continue until a response is received, or 
                until a total number of requests have been sent.
                Valid values are 1 through 4. The default value is 3."
                ::= { endptNAT 4 }
endptNATSIGNALINGKEEPALIVEENABLED   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Disable keep-alives and ping/pong connectivity checking for all SIP registrations.
                  Value - Operation
                    0 - Disable keep-alives for SIP signaling flow
                    1 - Enable keep-alives for SIP signaling flow (default)"
                ::= { endptNAT 5 }		
endptNATSIGNALINGKEEPALIVEOVERRIDESEC   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Override of the automatically-computed maximum interval, in seconds, between keep-alives
                (STUN messages for UDP, double-CRLFs for TCP/TLS) to (a) Refresh NAT bindings for the phone's signaling
                IP address and port, and (b) Optionally perform ping/pong checking.
                Valid values are 15 through 900 (15 minutes). The default value is 29.
                  Value - Operation
                  15-900 - The phone will unconditionally use this value as the keep-alive interval for every SIP registration and dialog"
                ::= { endptNAT 6 }
endptNATMEDIAKEEPALIVEENABLED   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Disable keep-alives and ping/pong connectivity checking for RTP/RTCP flow.
                  Value - Operation
                    0 - Disable keep-alives for RTP/RTCP flow
                    1 - Enable keep-alives for RTP/RTCP flow (default)"
                ::= { endptNAT 7 }		
endptNATMEDIAKEEPALIVESEC   OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Maximum interval, in seconds, between STUN keep-alives to refresh NAT bindings for the phone's
                RTP and RTCP IP address and ports.
                Valid values are 15 through 900 (15 minutes). The default value is 15 seconds.
                  Value - Operation
                  15-900 - The phone will use this value as the keep-alive interval for RTP and RTCP"
                ::= { endptNAT 8 }
--NAT_TBD: Future
--endptNATENABLESIGNALINGFLOWCHECK  OBJECT-TYPE
--                SYNTAX      INTEGER
--                MAX-ACCESS  read-only
--                STATUS      current
--                DESCRIPTION "Enable ping/pong flow checking with NAT keep-alives for signaling (STUN Binding Request/Response over UDP,
--                or double-CRLF/single-CRLF over TCP/TLS) to detect (a) A changed public signaling IP address or port mapping due to a
--                NAT reboot, or (b) A signaling flow failure due to a proxy crash. Flow checking should NOT be enabled unless pong responses
--                are known to be guaranteed. Otherwise, the phone may incorrectly assume that a given registration or dialog flow is dead.
--                  Value - Operation
--                    0 - Disable checking for pong responses (default)
--                    1 - Enable checking for pong responses"
--                ::= { endptNAT 9 }

endptBLF   OBJECT IDENTIFIER ::= { avayaSparkMIB 13 }
endptBLFLISTURI  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies the BLF list URI which should be used for subscription to 'Dialog' event package."
                ::= { endptBLF 1 }
endptCALLPICKUPFAC  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies the feature access code which will be inserted in INVITE message to perform Call Pickup operation.
                The default value is '*97'"
                ::= { endptBLF 2 }
endptCALLPICKUPBARGEINFAC  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies the feature access code which will be inserted in INVITE message to perform Barge-in operation.
                The default value is '*33'"
                ::= { endptBLF 3 }
endptCALLUNPARKFAC  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies the feature access code which will be inserted in INVITE message to perform Call Park Retrieve operation.
                The default value is '*88'"
                ::= { endptBLF 4 }
endptBLFINCOMINGCALLINDICATION  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies the indication of BLF incoming calls.
                  Value - Operation
                    0 - None (no alerting for BLF incoming call)
                    1 - Audible (only audible alerting for BLF incoming call)
                    2 - Visual (only visual alerting for BLF incoming call)
                    3 - Default (the behavior based on BLF_INCOMING_CALL_INDICATION_MODE parameter value)
                    4 - Both (both audible and visual alerting for BLF incoming call)"
                ::= { endptBLF 5 }
endptBLFPARKEDCALLINDICATION  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies the indication of BLF parked calls.
                  Value - Operation
                    0 - None (no alerting for BLF parked call)
                    1 - Default (the behavior based on BLF_PARKED_CALL_INDICATION_MODE parameter value)
                    2 - Visual (only visual alerting for BLF parked call)
                    3 - Both (both audible and visual alerting for BLF parked call)
                    4 - Audible (only audible alerting for BLF parked call)"
                ::= { endptBLF 6 }

endptALLOWBLFLISTCHANGE  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies the permissions to add/delete BLF line keys.
                  Value - Operation
                    0 - User is not allowed to add/delete BLF monitored users
                    1 - User is allowed only to delete BLF monitored users
                    2 - User is allowed only to add BLF monitored users
                    3 - User is allowed to add and delete BLF monitored users (default)"
                ::= { endptBLF 7 }

endptBLFPICKUPRINGTYPE  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Defines the ringtone that will be played when BLF monitored user has an incoming call. 
                Applicable only if BLF_ PICKUP_INDICATION requires audible indication."
                ::= { endptBLF 8 }

endptBLFPARKRINGTYPE  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Defines the ringtone that will be played when BLF monitored user has a parked call. 
                Applicable only if BLF_ CALL_PARK_INDICATION requires audible indication."
                ::= { endptBLF 9 }

endptBLFINCOMINGCALLINDICATIONMODE  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies the mode for indication for BLF incoming call.
                  Value - Operation
                    0 - None (no alerting for BLF incoming call)
                    1 - Audible (only audible alerting for BLF incoming call)
                    2 - Visual (only visual alerting for BLF incoming call)
                    3 - Both (default - both audible and visual alerting for BLF incoming call)
                    4 - Force None (no alerting for BLF incoming call)
                    5 - Force Audible (forced only audible alerting for BLF incoming call)
                    6 - Force Visual (forced only visual alerting for BLF incoming call)
                    7 - Force Both (forced both audible and visual alerting for BLF incoming call)"
                ::= { endptBLF 10 }

endptBLFPARKEDCALLINDICATIONMODE  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies the mode for indication for BLF parked call.
                  Value - Operation
                    0 - None (no alerting for BLF parked call)
                    1 - Audible (only audible alerting for BLF parked call)
                    2 - Visual (only visual alerting for BLF parked call)
                    3 - Both (both audible and visual alerting for BLF parked call)
                    4 - Force None (no alerting for BLF incoming call)
                    5 - Force Audible (forced only audible alerting for BLF parked call)
                    6 - Force Visual (forced only visual alerting for BLF parked call)
                    7 - Force Both (forced both audible and visual alerting for BLF parked call)"
                ::= { endptBLF 11 }
                
endptBLFPICKUPMETHOD  OBJECT-TYPE
                SYNTAX      INTEGER
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Specifies which method will be used to pickup the BLF call
		  Value - Operation:
		    0 - Pickup BLF call using Invite with FAC in Request URI (Default)
		    1 - Pickup BLF call using Invite with Replaces header"
                ::= { endptBLF 12 }

endptBLFSHORTFORMUSERID  OBJECT-TYPE
                SYNTAX      DisplayString
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Aura legacy usage.
                    Extended for RingCentral to identify if an incoming BLF notify with RingCentral extension is from itself. If yes, 
                    suppress the alerting and only present outbound call."
                ::= { endptBLF 13 }

